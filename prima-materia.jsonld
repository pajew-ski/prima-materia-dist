      },
      "pm:priorStep": {
        "id": "pmc:Asana"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā I-IV (Sanskrit vulgate; Sinh 1915)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The rite at Eleusis, held in the month Boedromion."
