      },
      "source": "Patañjali, Yogasūtra III.26",
      "type": "pm:Yielding",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "Rapture as a bodily felt state, graded in the handbook into five degrees of increasing pervasion."
      },
      "id": "pmc:Piti",
      "label": {
        "de": "Pīti",
        "en": "Pīti"
      },
      "note": {
        "en": "The five degrees are khuddikā, khaṇikā, okkantikā, ubbegā and pharaṇā."
      },
      "source": "Buddhaghosa, Visuddhimagga IV.94ff. (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:SpiritPresupposesBreath",
      "label": {
        "de": "Die Verfeinerung des Geistes setzt die des Atems voraus",
        "en": "Refining spirit presupposes refining breath"
      },
      "note": {
        "en": "Recorded from the Yuan-period witness, not from the Han or Song works to which the sequence is commonly credited."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:NeidanThreeStages"
      },
      "pm:prerequisiteStrength": {
