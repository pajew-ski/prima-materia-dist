      "type": "pm:Yielding",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "The act of ascribing a capacity, property, or deed to a subject. A lost faculty is never a finding; it is an ascription made in a work, and the work is what the graph can hold."
      },
      "id": "pm:Attributing",
      "label": {
        "de": "Zuschreiben",
        "en": "Attributing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The leader of the Watchers who binds the others by oath on Mount Hermon and is named as the teacher of spells and root-cutting."
      },
      "id": "pmc:Shemihazah",
      "label": {
        "de": "Schemichasa",
        "en": "Shemihazah"
      },
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Amezarak"
        },
        {
          "@language": "en",
          "@value": "Semjaza"
        }
      ],
      "source": "1 Enoch 6:3, 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The bearer to whom the capacity is ascribed: a named figure, a class of beings, humanity before a stated event."
      },
      "domain": "pm:Attributing",
      "id": "pm:ascribedTo",
      "label": {
        "de": "zugeschrieben an",
        "en": "ascribed to"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "id": "pmc:KasdejaTeachesStrikingOfSpirits",
      "label": {
        "de": "Kasdeja offenbart das Schlagen der Geister",
        "en": "Kasdeja discloses the striking of spirits"
      },
      "note": {
        "en": "Book of Parables; no Aramaic fragment of chapters 37-71 is attested at Qumran."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:StrikingOfSpirits"
      },
      "pm:ascribedTo": {
        "id": "pmc:Kasdeja"
      },
