  "@graph": [
    {
      "definition": {
        "en": "A concept that participates in the observed correspondence."
      },
      "domain": "pm:Converging",
      "id": "pm:convergingConcept",
      "label": {
        "de": "konvergierender Begriff",
        "en": "converging concept"
      },
      "range": "pm:Conceptualizing",
      "type": "owl:ObjectProperty"
    },
    {
      "id": "pmc:CompletionPresupposesGeneration",
      "label": {
        "de": "Die Vollendungsstufe setzt die Erzeugungsstufe voraus",
        "en": "The completion stage presupposes the generation stage"
      },
      "note": {
        "en": "The order is set by the arrangement of the treatise, which takes the generation-stage meditations before the completion-stage yogas. That the six yogas belong to the completion stage places tummo after the generation stage as well."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:CompletionStage"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:GenerationStage"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "The claim this protocol attempts to fail."
      },
      "domain": "pm:Testing",
      "id": "pm:tests",
      "label": {
        "de": "prüft",
        "en": "tests"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "id": "pmc:PenemueTeachesWriting",
      "label": {
        "de": "Penemue offenbart das Schreiben mit Tinte",
        "en": "Penemue discloses writing with ink"
      },
      "note": {
        "en": "Book of Parables; no Aramaic fragment of chapters 37-71 is attested at Qumran."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:WritingWithInk"
      },
      "pm:ascribedTo": {
        "id": "pmc:Penemue"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "1 Enoch 69:9 (Ethiopic; Charles 1912)",
        "J.T. Milik, The Books of Enoch: Aramaic Fragments of Qumrân Cave 4 (Oxford, 1976)"
      ],
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Conditions that descend on the wayfarer as a gift and pass, distinguished in the handbooks from the stations precisely by not being attainable through effort."
      },
      "id": "pmc:Ahwal",
      "label": {
        "de": "Zustände",
        "en": "States"
      },
      "note": {
        "en": "No prerequisite claim is entered for these. The tradition holds that they cannot be worked for, which is a claim about the limits of any ordering and not an omission in this record."
      },
      "source": [
        "al-Qushayrī, al-Risāla al-Qushayriyya",
        "al-Sarrāj, Kitāb al-Lumaʿ"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Sufism"
    },
    {
      "definition": {
        "en": "A claim that this ordering act groups. The claims keep their own attestation; only the grouping belongs to the compiler."
      },
      "domain": "pm:Systematizing",
      "id": "pm:ordersClaim",
      "label": {
        "de": "ordnet Behauptung",
        "en": "orders claim"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "id": "pmc:EzeqeelTeachesKnowledgeOfClouds",
      "label": {
        "de": "Ezeqeel offenbart die Wolkenkunde",
        "en": "Ezeqeel discloses the knowledge of the clouds"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:KnowledgeOfClouds"
      },
      "pm:ascribedTo": {
        "id": "pmc:Ezeqeel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A leader among the Watchers, named in the Book of the Watchers as the one who disclosed metallurgy, weaponry and adornment."
      },
      "id": "pmc:Azazel",
      "label": {
        "de": "Azazel",
        "en": "Azazel"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "Asael"
      },
      "source": "1 Enoch 8:1 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Associates a process instance with the pronominal reach of its awareness."
      },
      "id": "pm:hasAwarenessSpace",
      "label": {
        "en": "has awareness space"
      },
      "range": "pm:AwarenessSpace",
      "type": "owl:ObjectProperty"
    },
    {
      "id": "pmc:LovePresupposesApatheia",
      "label": {
        "de": "Liebe setzt Apatheia voraus, Erkenntnis die Liebe",
        "en": "Love presupposes apatheia, and knowledge presupposes love"
      },
      "note": {
        "en": "The chain is stated as generation and not as sequence: each term is the child or the flower of the one before it. That is why the strength here is necessity, and why a consequence can be quoted at all."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:consequenceOfSkipping": "Love is called the offspring of apatheia and is said to keep the door to the contemplation of created things, so that without it the door is not passed.",
      "pm:dependentStep": [
        {
          "id": "pmc:Agape"
        },
        {
          "id": "pmc:Physike"
        }
      ],
      "pm:prerequisiteStrength": {
        "id": "pm:statedNecessity"
      },
      "pm:priorStep": [
        {
          "id": "pmc:Agape"
        },
        {
          "id": "pmc:Apatheia"
        }
      ],
      "source": [
        "Evagrius Ponticus, Praktikos 81",
        "Evagrius Ponticus, Praktikos 84"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "definition": {
        "en": "The capacity, practice or pursuit a warning is directed at."
      },
      "domain": "pm:Cautioning",
      "id": "pm:cautionsAbout",
      "label": {
        "de": "warnt vor",
        "en": "cautions about"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "id": "pmc:ArmarosTeachesLoosingOfSpells",
      "label": {
        "de": "Armaros offenbart das Lösen von Beschwörungen",
        "en": "Armaros discloses the loosing of spells"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:LoosingOfSpells"
      },
      "pm:ascribedTo": {
        "id": "pmc:Armaros"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:SarielTeachesCourseOfTheMoon",
      "label": {
        "de": "Sariel offenbart den Lauf des Mondes",
        "en": "Sariel discloses the course of the moon"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:CourseOfTheMoon"
      },
      "pm:ascribedTo": {
        "id": "pmc:Sariel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The bearer to whom the capacity is ascribed: a named figure, a class of beings, humanity before a stated event."
      },
      "domain": "pm:Attributing",
      "id": "pm:ascribedTo",
      "label": {
        "de": "zugeschrieben an",
        "en": "ascribed to"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The claim stands in a received work, at a passage that can be cited and read independently of this graph."
      },
      "id": "pm:textualAttestation",
      "label": {
        "de": "Textzeugnis",
        "en": "Textual attestation"
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "Philological and historical mode of assertion: claims are reports about what a tradition holds, not claims made from within it."
      },
      "id": "pm:ScholarlyState",
      "label": {
        "de": "Wissenschaftlicher Zustand",
        "en": "Scholarly state"
      },
      "note": {
        "en": "Default context for tradition files in Phase 1."
      },
      "type": "pm:AwarenessContext"
    },
    {
      "id": "pmc:SecondWeekPresupposesFirst",
      "label": {
        "de": "Die zweite Woche setzt die erste voraus",
        "en": "The second week presupposes the first"
      },
      "note": {
        "en": "The same annotation that sets the order removes any fixed duration from it: the weeks need not have seven or eight days, and one who needs longer in the first is to be given longer. The order is set, the schedule is not."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:SecondWeek"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:FirstWeek"
      },
      "source": "Ignatius of Loyola, Spiritual Exercises 4",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:ChristianAsceticDiscernment"
    },
    {
      "definition": {
        "en": "Associates a concept with one or more symbolic representations (sigils, diagrams, glyphs)."
      },
      "id": "pm:hasSymbolicForm",
      "label": {
        "en": "has symbolic form"
      },
      "range": "pm:Symbolizing",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "Cases have been recorded and show no deviation from the stated base rate."
      },
      "id": "pm:casesWithoutDeviation",
      "label": {
        "de": "Fälle ohne Abweichung",
        "en": "Cases without deviation"
      },
      "type": "pm:ExaminationState"
    },
    {
      "definition": {
        "en": "A Watcher named in the teaching list as the one who disclosed the undoing of spells."
      },
      "id": "pmc:Armaros",
      "label": {
        "de": "Armaros",
        "en": "Armaros"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "Hermani"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The disclosure of the distinction of bitter from sweet, given in the text alongside the secrets of wisdom."
      },
      "id": "pmc:DiscernmentOfBitterAndSweet",
      "label": {
        "de": "Unterscheidung von bitter und süß",
        "en": "Discernment of bitter and sweet"
      },
      "source": "1 Enoch 69:8 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The Stoic doctrine of a fiery breath that pervades matter and holds it together."
      },
      "id": "pmt:StoicPhysics",
      "label": {
        "de": "Stoische Physik",
        "en": "Stoic physics"
      },
      "source": "Chrysippus, in Galen, De placitis Hippocratis et Platonis V.3.8",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The combined application of dhāraṇā, dhyāna and samādhi to a single object, presented as the general operator from which the capacities of the third chapter follow."
      },
      "id": "pmp:Samyama",
      "label": {
        "de": "Saṃyama",
        "en": "Saṃyama"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Patañjali, Yogasūtra III.1-3",
      "type": "pm:Practicing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "Knowledge of the contents of another consciousness, said to follow from saṃyama on the presented idea."
      },
      "id": "pmc:ParacittaJnana",
      "label": {
        "de": "Kenntnis fremden Bewusstseins",
        "en": "Knowledge of another mind"
      },
      "source": "Patañjali, Yogasūtra III.19",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "id": "pmc:PenemueTeachesBitterAndSweet",
      "label": {
        "de": "Penemue offenbart bitter und süß",
        "en": "Penemue discloses bitter and sweet"
      },
      "note": {
        "en": "Book of Parables; no Aramaic fragment of chapters 37-71 is attested at Qumran."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:DiscernmentOfBitterAndSweet"
      },
      "pm:ascribedTo": {
        "id": "pmc:Penemue"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "1 Enoch 69:8 (Ethiopic; Charles 1912)",
        "J.T. Milik, The Books of Enoch: Aramaic Fragments of Qumrân Cave 4 (Oxford, 1976)"
      ],
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Vital breath, presented as that on which the parts of the person rest and out of which beings come forth, in the image of a wheel resting on its hub."
      },
      "id": "pmc:Prana",
      "label": {
        "de": "Prāṇa",
        "en": "Prāṇa"
      },
      "source": [
        "Chāndogya Upaniṣad 1.11.5",
        "Chāndogya Upaniṣad 7.15.1"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Upanisadic"
    },
    {
      "id": "pmc:HathaChapterOrder",
      "label": {
        "de": "Das Handbuch ordnet Haltung, Atem, Siegel und Versenkung",
        "en": "The manual orders posture, breath, seal and absorption"
      },
      "note": {
        "en": "Recorded at the weakest strength on purpose. The four chapters run posture, breath, seal, absorption, and that arrangement is often cited as though it were itself a rule. The rule is in II.1; the chapter order is only an arrangement."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:NadiPurification"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:presentationOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Asana"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā I-IV",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The seat, treated in the first chapter as the first limb of the practice."
      },
      "id": "pmc:Asana",
      "label": {
        "de": "Sitzhaltung",
        "en": "Posture"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā I",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The reading of import from the moon, given in place of its course in the Aramaic-Greek witness."
      },
      "id": "pmc:SignsOfTheMoon",
      "label": {
        "de": "Zeichen des Mondes",
        "en": "Signs of the moon"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The Byzantine tradition of the prayer of the heart and of the vision of the uncreated light, defended in the fourteenth century against the objection that such a light must be created."
      },
      "id": "pmt:Hesychasm",
      "label": {
        "de": "Hesychasmus",
        "en": "Hesychasm"
      },
      "source": "Gregory Palamas, Triads in Defence of the Holy Hesychasts",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "Refining essence into breath, breath into spirit, and spirit back into emptiness."
      },
      "id": "pmc:NeidanThreeStages",
      "label": {
        "de": "Die drei Stufen des inneren Elixiers",
        "en": "The three stages of the inner elixir"
      },
      "note": {
        "en": "A dating warning belongs on this node. The sequence is routinely attributed to the Cantong qi or to the Wuzhen pian, but neither carries it as a fixed numbered progression; the Wuzhen pian sets only a precedence of vital force before inner nature, and of doing before non-doing. The earliest ordered witness located for the full triad is the Yuan-period Jindan dayao."
      },
      "source": "Chen Zhixu, Jindan dayao, juan 4",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "definition": {
        "en": "Associates a MeaningCluster with the individual nodes that constitute it as a bounded subgraph."
      },
      "domain": "pm:MeaningCluster",
      "id": "pm:hasClusterMember",
      "label": {
        "en": "has cluster member"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The formation of a concept as an act within awareness; instances of this class are concept nodes such as pmc:Pleroma or pmc:Hen."
      },
      "id": "pm:Conceptualizing",
      "label": {
        "de": "Begriffsbildung",
        "en": "Conceptualizing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The gathering and preparation of plant material for pharmacological or operative use."
      },
      "id": "pmc:RootCutting",
      "label": {
        "de": "Wurzelschneiden",
        "en": "Root-cutting"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:GadreelTeachesWeaponsOfDeath",
      "label": {
        "de": "Gadreel offenbart die Waffen des Todes",
        "en": "Gadreel discloses the weapons of death"
      },
      "note": {
        "en": "Book of Parables; no Aramaic fragment of chapters 37-71 is attested at Qumran."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:WeaponsOfDeath"
      },
      "pm:ascribedTo": {
        "id": "pmc:Gadreel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "1 Enoch 69:6 (Ethiopic; Charles 1912)",
        "J.T. Milik, The Books of Enoch: Aramaic Fragments of Qumrân Cave 4 (Oxford, 1976)"
      ],
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A Watcher named in the Aramaic-Greek teaching list as the one who disclosed the signs of the shooting stars. The position he occupies is held by Ezeqeel in the Ethiopic; no identification of the two is asserted here."
      },
      "id": "pmc:Ziqel",
      "label": {
        "de": "Ziqel",
        "en": "Ziqel"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The transmission of the ascetic literature of the Egyptian desert and its Byzantine continuation, in which the path is set out as an ordered ascent."
      },
      "id": "pmt:DesertMonasticism",
      "label": {
        "de": "Wüstenmönchtum",
        "en": "Desert monasticism"
      },
      "source": "Evagrius Ponticus, Praktikos",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The rate against which observed outcomes are compared, with the population it was taken from."
      },
      "domain": "pm:Testing",
      "id": "pm:baseRate",
      "label": {
        "de": "Basisrate",
        "en": "base rate"
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "The practice a yielding claim proceeds from."
      },
      "domain": "pm:Yielding",
      "id": "pm:byPractice",
      "label": {
        "de": "durch Praxis",
        "en": "by practice"
      },
      "range": "pm:Practicing",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "Knowledge of the state of another consciousness."
      },
      "id": "pmc:Cetopariyanana",
      "label": {
        "de": "Kenntnis fremden Bewusstseins",
        "en": "Knowledge encompassing another mind"
      },
      "source": "Buddhaghosa, Visuddhimagga XIII (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:JhanaPresupposesAbandoningTheHindrances",
      "label": {
        "de": "Die Vertiefung setzt das Aufgeben der Hemmnisse voraus",
        "en": "Absorption presupposes the abandoning of the hindrances"
      },
      "note": {
        "en": "The discourse places the abandoning of the five immediately before entry into the first absorption in a fixed formula, without stating at that place what befalls one who enters otherwise."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:FourAbsorptions"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:FiveHindrances"
      },
      "source": "Dīgha Nikāya 2 (Sāmaññaphala Sutta)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "A negative finding, held as a node so that it is not lost: the old traditions test a claimed movement by its origin and its fruits, and none of those examined here tests a claimed capacity by counting hits against the rate obtainable by guessing."
      },
      "id": "pmc:NoQuantitativeVerification",
      "label": {
        "de": "Keine Zählung gegen den Zufall in den alten Quellen",
        "en": "No count against chance in the old sources"
      },
      "note": {
        "en": "Any protocol that counts outcomes against a base rate is a modern addition and is to be recorded as one, not as the recovery of an ancient method."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:cautionsAbout": {
        "id": "pmc:TestingOfThoughts"
      },
      "source": [
        "Ignatius of Loyola, Spiritual Exercises 313-336",
        "John Cassian, Collationes I.20-22"
      ],
      "type": "pm:Cautioning"
    },
    {
      "definition": {
        "en": "The transmission of the practice of discerning the origin of inner movements, running from the desert monastic literature through the Byzantine ascetic corpus into the Latin spiritual exercises."
      },
      "id": "pmt:ChristianAsceticDiscernment",
      "label": {
        "de": "Christliche Unterscheidung der Geister",
        "en": "Christian ascetic discernment"
      },
      "source": "John Cassian, Collationes I-II",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "A knowledge tradition understood as an ongoing act of transmission rather than a static corpus."
      },
      "id": "pm:Tradition",
      "label": {
        "de": "Tradition",
        "en": "Tradition"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "Declares by which route a claim entered the record. Mandatory on every attribution, so that non-evidence cannot be forgotten."
      },
      "id": "pm:attestedBy",
      "label": {
        "de": "bezeugt durch",
        "en": "attested by"
      },
      "range": "pm:Attesting",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "A practice repeated under a stated procedure that records its failures alongside its successes."
      },
      "id": "pm:protocolledPractice",
      "label": {
        "de": "Protokollierte Praxis",
        "en": "Protocolled practice"
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "Stages of the path attained by effort and held by the one who reaches them, enumerated in the handbooks in a set order."
      },
      "id": "pmc:Maqamat",
      "label": {
        "de": "Stationen",
        "en": "Stations"
      },
      "source": [
        "al-Qushayrī, al-Risāla al-Qushayriyya, chapter on the stations",
        "al-Sarrāj, Kitāb al-Lumaʿ"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Sufism"
    },
    {
      "definition": {
        "en": "The undoing of a binding laid by another, held in the text as a distinct art from the laying of it."
      },
      "id": "pmc:LoosingOfSpells",
      "label": {
        "de": "Lösen von Beschwörungen",
        "en": "Loosing of spells"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:AscentPresupposesTheRungs",
      "label": {
        "de": "Die Schau der Schönheit selbst setzt den Aufstieg über die Stufen voraus",
        "en": "The vision of beauty itself presupposes the ascent by rungs"
      },
      "note": {
        "en": "The word rendered as rungs stands in the base text at 211c, which is why this counts as a stated ordering and not as a modern reading of a sequence of paragraphs."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:consequenceOfSkipping": "The ascent is described as rightly conducted only when it proceeds as by rungs of a ladder, from one body to two, from bodies to pursuits, from pursuits to studies, and thence to beauty itself; the one who does not go this way does not arrive at the final vision.",
      "pm:dependentStep": {
        "id": "pmc:BeautyItself"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:statedNecessity"
      },
      "pm:priorStep": {
        "id": "pmc:BeautyOfOneBody"
      },
      "source": "Plato, Symposium 211c",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Platonic"
    },
    {
      "definition": {
        "en": "The act of ascribing a capacity, property, or deed to a subject. A lost faculty is never a finding; it is an ascription made in a work, and the work is what the graph can hold."
      },
      "id": "pm:Attributing",
      "label": {
        "de": "Zuschreiben",
        "en": "Attributing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The purgative part of the exercises, given over to the consideration of sin."
      },
      "id": "pmc:FirstWeek",
      "label": {
        "de": "Die erste Woche",
        "en": "The first week"
      },
      "source": "Ignatius of Loyola, Spiritual Exercises 4",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:ChristianAsceticDiscernment"
    },
    {
      "definition": {
        "en": "The fourth of the five degrees of rapture, described as strong enough to lift the body."
      },
      "id": "pmc:UbbegaPiti",
      "label": {
        "de": "Erhebungsverzückung",
        "en": "Uplifting rapture"
      },
      "source": "Buddhaghosa, Visuddhimagga IV.94ff. (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The first of the two stages of the highest tantra, treated before the completion stage in the training."
      },
      "id": "pmc:GenerationStage",
      "label": {
        "de": "Erzeugungsstufe",
        "en": "Generation stage"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "A figure named in the Book of Parables as the one who led Eve astray and disclosed the weapons of death."
      },
      "id": "pmc:Gadreel",
      "label": {
        "de": "Gadreel",
        "en": "Gadreel"
      },
      "source": "1 Enoch 69:6 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A breath practice inscribed in forty-five characters on a twelve-sided jade block, setting out the deliberate movement of qi through the body."
      },
      "id": "pmp:Xingqi",
      "label": {
        "de": "Zirkulation des Qi",
        "en": "Circulating the qi"
      },
      "note": {
        "en": "The two axes of disagreement belong to the claim and are recorded with it. Dating: Harper places the inscription in the late fourth or early third century BCE, Needham in the middle of the sixth. Reading: Harper takes the opening two characters as the title and begins the text at the second line, where Roth counts and construes differently. A citation that names only the inscription conceals both."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "H.D. Roth, Original Tao (1999)",
        "Xingqi yupei ming, in D. Harper, Early Chinese Medical Literature (1998), p. 125",
        "Xingqi yupei ming, in J. Needham, Science and Civilisation in China II (1956), p. 143"
      ],
      "type": "pm:Practicing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "definition": {
        "en": "The transfer of power from one who has it to one who does not, graded in the Kashmirian exegesis into nine degrees."
      },
      "id": "pmc:Saktipata",
      "label": {
        "de": "Herabkunft der Kraft",
        "en": "Descent of power"
      },
      "note": {
        "en": "The sources give transfer by glance, by touch and by word. The specifically manual modality of the modern draft is not attested here."
      },
      "source": [
        "Abhinavagupta, Tantrasāra XI",
        "Abhinavagupta, Tantrāloka XIII",
        "Mālinīvijayottaratantra"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "id": "pmc:AzazelTeachesAdornment",
      "label": {
        "de": "Azazel offenbart Schmuck und Kosmetik",
        "en": "Azazel discloses adornment and cosmetics"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:AdornmentAndCosmetics"
      },
      "pm:ascribedTo": {
        "id": "pmc:Azazel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:1 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The regulation of the breath as a distinct limb of practice, following posture and preceding the withdrawal of the senses."
      },
      "id": "pmp:Pranayama",
      "label": {
        "de": "Prāṇāyāma",
        "en": "Prāṇāyāma"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Patañjali, Yogasūtra II.49-53",
      "type": "pm:Practicing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "Cases have been recorded and show a deviation from the stated base rate. What deviates is what the protocol measured, which is rarely the whole of what the claim asserts."
      },
      "id": "pm:casesWithDeviation",
      "label": {
        "de": "Fälle mit Abweichung",
        "en": "Cases with deviation"
      },
      "type": "pm:ExaminationState"
    },
    {
      "definition": {
        "en": "A mixture of air and fire that pervades bodies and, by its tension, holds them in cohesion; a principle of the world rather than a capacity of a practitioner."
      },
      "id": "pmc:Pneuma",
      "label": {
        "de": "Pneuma",
        "en": "Pneuma"
      },
      "note": {
        "en": "The associated doctrines are that of tension and that of total mixture, by which two bodies occupy the same place throughout."
      },
      "source": "Chrysippus, in Galen, De placitis Hippocratis et Platonis V.3.8",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:StoicPhysics"
    },
    {
      "definition": {
        "en": "Hearing beyond the range of the physical ear."
      },
      "id": "pmc:DivyaSrotra",
      "label": {
        "de": "Göttliches Ohr",
        "en": "Divine ear"
      },
      "source": "Patañjali, Yogasūtra III.41",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "id": "pmc:BaraqelTeachesSignsOfLightning",
      "label": {
        "de": "Baraqel offenbart die Zeichen der Blitze",
        "en": "Baraqel discloses the signs of the lightning flashes"
      },
      "note": {
        "en": "Stands in the position the Ethiopic fills with astrology."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfLightning"
      },
      "pm:ascribedTo": {
        "id": "pmc:Baraqel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The claim, made within a tradition, that one step of a path presupposes another: that a practice, state or capacity is not reached except by way of something else."
      },
      "id": "pm:Presupposing",
      "label": {
        "de": "Voraussetzen",
        "en": "Presupposing"
      },
      "note": {
        "en": "A node and not an edge, for the same reason as pm:Attributing and pm:Yielding. A prerequisite claim differs enormously in what carries it, and the difference is not visible on an edge. It matters whether a text sets an order or a reader inferred one from the order of the chapters."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "A power held to rest coiled at the base of the subtle body and to rise through it when roused."
      },
      "id": "pmc:Kundalini",
      "label": {
        "de": "Kuṇḍalinī",
        "en": "Kuṇḍalinī"
      },
      "source": "Pūrṇānanda, Ṣaṭcakranirūpaṇa (1577)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "The transmission of the Platonic dialogues and the ascent they describe from particular to intelligible beauty."
      },
      "id": "pmt:Platonic",
      "label": {
        "de": "Platonische Überlieferung",
        "en": "Platonic tradition"
      },
      "source": "Plato, Symposium 210a-212a",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The leader of the Watchers who binds the others by oath on Mount Hermon and is named as the teacher of spells and root-cutting."
      },
      "id": "pmc:Shemihazah",
      "label": {
        "de": "Schemichasa",
        "en": "Shemihazah"
      },
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Amezarak"
        },
        {
          "@language": "en",
          "@value": "Semjaza"
        }
      ],
      "source": "1 Enoch 6:3, 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The fourth state: pure awareness that is neither outward- nor inward-turned, and not a negation of either."
      },
      "id": "pm:TranscendentState",
      "label": {
        "de": "Transzendenter Zustand (Turīya)",
        "en": "Transcendent state (Turīya)"
      },
      "source": "Māṇḍūkya Upaniṣad, verse 7",
      "type": "pm:AwarenessContext"
    },
    {
      "definition": {
        "en": "A disagreement about what is required for absorption. The discourses describe it as reached in the ordinary course of the training; the handbook sets a far higher bar, remarking that only one in a hundred or a thousand accomplishes it."
      },
      "id": "pmc:AbsorptionThresholdDispute",
      "label": {
        "de": "Wie hoch die Schwelle der Vertiefung liegt",
        "en": "How high the threshold of absorption stands"
      },
      "note": {
        "en": "The disagreement bears directly on every prerequisite in this file that runs through the fourth absorption. If the handbook's threshold is the right one, the capacities it makes conditional on that absorption are conditional on something very few reach; if the discourses' is, they are not."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:disputedClaim": {
        "id": "pmc:FourAbsorptions"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga XII (trans. Ñāṇamoli 1956)",
        "Dīgha Nikāya 2 (Sāmaññaphala Sutta)"
      ],
      "type": "pm:Disputing"
    },
    {
      "id": "pmc:TummoYieldsInnerHeat",
      "label": {
        "de": "Tummo bringt innere Hitze hervor",
        "en": "Tummo yields inner heat"
      },
      "note": {
        "en": "The one pairing in this file that names a capacity with an outward, measurable side. Any later protocol has a clearer target here than anywhere else in the collection."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:Tummo"
      },
      "pm:yieldsCapacity": {
        "id": "pmc:InnerHeat"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Yielding",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "Called the offspring of apatheia and the keeper of the door to the contemplation of created things."
      },
      "id": "pmc:Agape",
      "label": {
        "de": "Liebe",
        "en": "Love"
      },
      "source": [
        "Evagrius Ponticus, Praktikos 81",
        "Evagrius Ponticus, Praktikos 84"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "id": "pmc:SarielTeachesSignsOfTheMoon",
      "label": {
        "de": "Sariel offenbart die Zeichen des Mondes",
        "en": "Sariel discloses the signs of the moon"
      },
      "note": {
        "en": "Given under the name Sahriel; stands in the position the Ethiopic fills with the course of the moon."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfTheMoon"
      },
      "pm:ascribedTo": {
        "id": "pmc:Sariel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:SamyamaYieldsParacittaJnana",
      "label": {
        "de": "Saṃyama auf die Vorstellung bringt Kenntnis fremden Bewusstseins hervor",
        "en": "Saṃyama on the presented idea yields knowledge of another mind"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:Samyama"
      },
      "pm:yieldsCapacity": {
        "id": "pmc:ParacittaJnana"
      },
      "source": "Patañjali, Yogasūtra III.19",
      "type": "pm:Yielding",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "The transmission of the Haṭhayogapradīpikā of Svātmārāma and the manuals around it."
      },
      "id": "pmt:Hathayoga",
      "label": {
        "de": "Haṭhayoga",
        "en": "Haṭhayoga"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The disclosure of harmful operations: the striking of spirits and demons, the killing of the embryo in the womb, the serpent's bite and the stroke of the noonday heat."
      },
      "id": "pmc:StrikingOfSpirits",
      "label": {
        "de": "Schlagen der Geister und der Leibesfrucht",
        "en": "Striking of spirits and of the womb"
      },
      "source": "1 Enoch 69:12 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:SamyamaIsInnerToThePrecedingLimbs",
      "label": {
        "de": "Die drei inneren Glieder sind innerlicher als die vorhergehenden fünf",
        "en": "The three inner limbs are inner to the preceding five"
      },
      "note": {
        "en": "The base text ranks the last three limbs as inner with respect to the preceding five, and then ranks even those three as outer with respect to the seedless absorption. It sets a relation of inner and outer, not a rule that one cannot be attempted before the other, and it says nothing about what follows from disregarding the ranking."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmp:Samyama"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:AstangaLimbs"
      },
      "source": [
        "Patañjali, Yogasūtra III.7",
        "Patañjali, Yogasūtra III.8"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "A Watcher whose teaching concerns celestial signs; the two recensions differ on which."
      },
      "id": "pmc:Baraqel",
      "label": {
        "de": "Baraqel",
        "en": "Baraqel"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "Baraqijal"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The reading of import from the sun."
      },
      "id": "pmc:SignsOfTheSun",
      "label": {
        "de": "Zeichen der Sonne",
        "en": "Signs of the sun"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The pronominal reach of an awareness act, ranging from individual through dyadic and collective to universal."
      },
      "id": "pm:AwarenessSpace",
      "label": {
        "de": "Bewusstseinsraum",
        "en": "Awareness Space"
      },
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The second of the two stages, to which the six yogas belong."
      },
      "id": "pmc:CompletionStage",
      "label": {
        "de": "Vollendungsstufe",
        "en": "Completion stage"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "The channels of the subtle body through which the winds are held to move; Tsongkhapa's presentation counts one hundred and twenty principal ones."
      },
      "id": "pmc:Rtsa",
      "label": {
        "de": "Kanäle",
        "en": "Channels"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "The later step: the practice, state or capacity said not to be reached without the prior one."
      },
      "domain": "pm:Presupposing",
      "id": "pm:dependentStep",
      "label": {
        "de": "abhängiger Schritt",
        "en": "dependent step"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The act of apprehending form within an awareness context."
      },
      "id": "pm:Perceiving",
      "label": {
        "de": "Wahrnehmen",
        "en": "Perceiving"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "dcterms:date": "1927",
      "definition": {
        "en": "The assignment of a fixed set of seven centres to spectral colours and to psychological qualities such as will, expression and security. An ordering imposed in the twentieth century on material that did not carry it."
      },
      "id": "pmc:SevenCentreQualityMapping",
      "label": {
        "de": "Die Zuordnung von sieben Zentren zu Eigenschaften",
        "en": "The seven-centre quality mapping"
      },
      "note": {
        "en": "Colour scheme in Leadbeater 1927, rainbow spectrum in Hills 1977, on the textual basis made available by Avalon's 1919 translation of the Ṣaṭcakranirūpaṇa. Recorded here so that the mapping is available in the graph as what it is, and cannot be mistaken for the tantric material it was built on."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:compiledBy": "C. W. Leadbeater, extended by Christopher Hills",
      "pm:ordersClaim": {
        "id": "pmc:Cakra"
      },
      "source": [
        "A. Avalon, The Serpent Power (1919)",
        "C. W. Leadbeater, The Chakras (1927)",
        "Christopher Hills, Nuclear Evolution (1977)"
      ],
      "type": "pm:Systematizing"
    },
    {
      "definition": {
        "en": "The date on which the count was last carried forward. A protocol without this date claims a scrutiny it does not document."
      },
      "domain": "pm:Testing",
      "id": "pm:protocolUpdated",
      "label": {
        "de": "Protokollstand",
        "en": "protocol updated"
      },
      "range": "xsd:date",
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "A graded emptying in which listening passes from the ears to the heart-mind and from the heart-mind to the qi, until only emptiness remains for the way to gather in."
      },
      "id": "pmc:EmptyingOfTheHeart",
      "label": {
        "de": "Fasten des Herzens",
        "en": "Fasting of the heart"
      },
      "source": "Zhuangzi 4",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "definition": {
        "en": "The restoration of a withered hand and of sight, ascribed to the touch of a ruler in Alexandria."
      },
      "id": "pmc:HealingByTouch",
      "label": {
        "de": "Heilung durch Berührung",
        "en": "Healing by touch"
      },
      "source": [
        "Suetonius, Divus Vespasianus 7",
        "Tacitus, Historiae IV.81"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:GraecoRoman"
    },
    {
      "definition": {
        "en": "The transfer of the seat of awareness into a body other than one's own."
      },
      "id": "pmc:ParakayaPravesa",
      "label": {
        "de": "Eintritt in einen anderen Körper",
        "en": "Entering another body"
      },
      "source": "Patañjali, Yogasūtra III.38",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "The act of one form standing for another within awareness."
      },
      "id": "pm:Symbolizing",
      "label": {
        "de": "Symbolisieren",
        "en": "Symbolizing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "Eight bodily signs held to arise from the inner constitution rather than from will: paralysis, perspiration, horripilation, change of voice, trembling, change of colour, tears, and fainting."
      },
      "id": "pmc:SattvikaBhava",
      "label": {
        "de": "Unwillkürliche Körperzustände",
        "en": "Involuntary bodily states"
      },
      "source": "Nāṭyaśāstra VII",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SanskritDramaturgy"
    },
    {
      "definition": {
        "en": "Restraint, observance, posture, breath regulation, withdrawal of the senses, concentration, meditation and absorption, listed together in a single sūtra."
      },
      "id": "pmc:AstangaLimbs",
      "label": {
        "de": "Die acht Glieder",
        "en": "The eight limbs"
      },
      "note": {
        "en": "The sūtra names them and says nothing about traversing them in order."
      },
      "source": "Patañjali, Yogasūtra II.29",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "A preliminary in which the channels are cleared by visualisation before the heat practice proper; the tradition's own form of the notion that a blockage is a place the energy does not reach."
      },
      "id": "pmp:ChannelPurification",
      "label": {
        "de": "Reinigung der Kanäle",
        "en": "Purification of the channels"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Practicing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "A capacity ascribed to a figure who is not available to report it, in a historian's account of what was told of him."
      },
      "id": "pmc:AristeasJourney",
      "label": {
        "de": "Die Seelenreise, Aristeas zugeschrieben",
        "en": "The soul-journey ascribed to Aristeas"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SoulJourney"
      },
      "pm:attestedBy": {
        "id": "pm:thirdPartyAscription"
      },
      "source": [
        "Herodotus, Histories IV.13-16",
        "Pliny, Naturalis Historia VII.174"
      ],
      "type": "pm:Attributing",
      "withinTradition": "pmt:GraecoRoman"
    },
    {
      "definition": {
        "en": "The first object of the ascent, from which the climb begins."
      },
      "id": "pmc:BeautyOfOneBody",
      "label": {
        "de": "Die Schönheit eines Körpers",
        "en": "The beauty of one body"
      },
      "source": "Plato, Symposium 210a-211c",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Platonic"
    },
    {
      "definition": {
        "en": "The transmission of Chinese texts and practices concerned with the cultivation and circulation of qi."
      },
      "id": "pmt:Daoist",
      "label": {
        "de": "Daoistische Überlieferung",
        "en": "Daoist tradition"
      },
      "source": "Xingqi yupei ming (jade inscription on circulating the qi)",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The transmission of the Śaiva and Śākta tantric corpus and its Kashmirian exegesis."
      },
      "id": "pmt:SaivaSakta",
      "label": {
        "de": "Śaiva- und Śākta-Tantra",
        "en": "Śaiva and Śākta tantra"
      },
      "source": "Pūrṇānanda, Ṣaṭcakranirūpaṇa (1577)",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The source says what fails to happen without the prior step: that the later step is not possible, or does not arise, or turns harmful."
      },
      "id": "pm:statedNecessity",
      "label": {
        "de": "Ausdrücklich gesetzte Notwendigkeit",
        "en": "Stated necessity"
      },
      "type": "pm:PrerequisiteStrength"
    },
    {
      "definition": {
        "en": "A tradition attesting the correspondence for which no route of contact is documented. This is the only kind of attestation that makes a correspondence a finding rather than a citation chain."
      },
      "domain": "pm:Converging",
      "id": "pm:independentAttestation",
      "label": {
        "de": "unabhängige Bezeugung",
        "en": "independent attestation"
      },
      "range": "pm:Tradition",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The raising of the body hair, counted among the eight involuntary signs and treated as a mark of an inner state, not as something to be produced for its own sake."
      },
      "id": "pmc:Romanca",
      "label": {
        "de": "Haaraufrichtung",
        "en": "Horripilation"
      },
      "note": {
        "en": "Attested outside the dramaturgical treatise in the epic corpus, where trembling and horripilation are named together as signs of an overwhelming state."
      },
      "source": [
        "Bhagavadgītā 1.29",
        "Nāṭyaśāstra VII"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SanskritDramaturgy"
    },
    {
      "id": "pmc:BaraqelTeachesAstrology",
      "label": {
        "de": "Baraqel offenbart die Astrologie",
        "en": "Baraqel discloses astrology"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:Astrology"
      },
      "pm:ascribedTo": {
        "id": "pmc:Baraqel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The vital breath or energy held to circulate in the body and to be susceptible of deliberate direction."
      },
      "id": "pmc:Qi",
      "label": {
        "de": "Qi",
        "en": "Qi"
      },
      "source": "Xingqi yupei ming (jade inscription on circulating the qi)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "dcterms:date": "20th century",
      "definition": {
        "en": "The reading of the eight limbs as a ladder that must be climbed in order, each limb a precondition of the next."
      },
      "id": "pmc:SerialReadingOfTheEightLimbs",
      "label": {
        "de": "Die serielle Lesart der acht Glieder",
        "en": "The serial reading of the eight limbs"
      },
      "note": {
        "en": "The inner and outer categories come from the commentarial layer, and the hardening of the ranking into a rule of practice belongs to twentieth-century yoga pedagogy. Recorded here so that the reading is available as what it is. The base text at II.29 enumerates and does not order."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:compiledBy": "The commentarial tradition, sharpened in twentieth-century yoga pedagogy",
      "pm:ordersClaim": {
        "id": "pmc:AstangaLimbs"
      },
      "source": "Patañjali, Yogasūtra II.29",
      "type": "pm:Systematizing"
    },
    {
      "definition": {
        "en": "Transformation by supernormal power, the first of the direct knowledges treated in the handbook."
      },
      "id": "pmc:Iddhividha",
      "label": {
        "de": "Die Arten übernatürlicher Kraft",
        "en": "The kinds of supernormal power"
      },
      "source": "Buddhaghosa, Visuddhimagga XII (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The clearing of impurity from the channels, at which the breath practice is said to aim, and whose accomplishment the text says shows outwardly in the body."
      },
      "id": "pmc:NadiPurification",
      "label": {
        "de": "Reinigung der Kanäle",
        "en": "Purification of the channels"
      },
      "source": [
        "Svātmārāma, Haṭhayogapradīpikā II.19-20",
        "Svātmārāma, Haṭhayogapradīpikā II.6"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The source only presents the material in a sequence. Any necessity is the reader's, and belongs to whoever read it that way."
      },
      "id": "pm:presentationOrder",
      "label": {
        "de": "Darstellungsreihenfolge",
        "en": "Presentation order"
      },
      "type": "pm:PrerequisiteStrength"
    },
    {
      "definition": {
        "en": "The part given over to the life of Christ up to Palm Sunday, and to the following of it."
      },
      "id": "pmc:SecondWeek",
      "label": {
        "de": "Die zweite Woche",
        "en": "The second week"
      },
      "source": "Ignatius of Loyola, Spiritual Exercises 4",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:ChristianAsceticDiscernment"
    },
    {
      "id": "pmc:KasdejaTeachesStrikingOfSpirits",
      "label": {
        "de": "Kasdeja offenbart das Schlagen der Geister",
        "en": "Kasdeja discloses the striking of spirits"
      },
      "note": {
        "en": "Book of Parables; no Aramaic fragment of chapters 37-71 is attested at Qumran."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:StrikingOfSpirits"
      },
      "pm:ascribedTo": {
        "id": "pmc:Kasdeja"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "1 Enoch 69:12 (Ethiopic; Charles 1912)",
        "J.T. Milik, The Books of Enoch: Aramaic Fragments of Qumrân Cave 4 (Oxford, 1976)"
      ],
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:SamyamaYieldsDivyaCaksus",
      "label": {
        "de": "Saṃyama auf die Sonne bringt Weltkenntnis hervor",
        "en": "Saṃyama on the sun yields knowledge of the world"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:Samyama"
      },
      "pm:yieldsCapacity": {
        "id": "pmc:DivyaCaksus"
      },
      "source": "Patañjali, Yogasūtra III.26",
      "type": "pm:Yielding",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "The reading of import from the stars, given in place of the constellations in the Aramaic-Greek witness."
      },
      "id": "pmc:SignsOfTheStars",
      "label": {
        "de": "Zeichen der Sterne",
        "en": "Signs of the stars"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Breath or spirit, named as the first of the ten emanations, from which air issues, from air water, and from water fire."
      },
      "id": "pmc:Ruach",
      "label": {
        "de": "Ruach",
        "en": "Ruaḥ"
      },
      "note": {
        "en": "The text also has the patriarch stirring the letters with breath, which is the closest the source comes to breath as an operative medium; it remains an act of formation, not a conduction through the body."
      },
      "source": [
        "Sefer Yetzirah 1:9-10",
        "Sefer Yetzirah 6:7"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SeferYetzirah"
    },
    {
      "definition": {
        "en": "The breath practice of the second chapter, directed at the clearing of the central channel."
      },
      "id": "pmp:HathaPranayama",
      "label": {
        "de": "Atemregulierung im Haṭhayoga",
        "en": "Breath regulation in Haṭhayoga"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā II",
      "type": "pm:Practicing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The transmission of Greek and Latin historiographical and doxographical reports of extraordinary capacities."
      },
      "id": "pmt:GraecoRoman",
      "label": {
        "de": "Griechisch-römisches Zeugnis",
        "en": "Graeco-Roman testimony"
      },
      "source": "Herodotus, Histories IV.13-16",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "Freedom from the disturbance of the passions, called the flower of ascetic labour."
      },
      "id": "pmc:Apatheia",
      "label": {
        "de": "Apatheia",
        "en": "Apatheia"
      },
      "source": "Evagrius Ponticus, Praktikos 81",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "definition": {
        "en": "A Watcher named as the one who disclosed the signs of the sun."
      },
      "id": "pmc:Shamsiel",
      "label": {
        "de": "Schamsiel",
        "en": "Shamsiel"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The Roman emperor to whom the Alexandrian healings are ascribed by two independent historians."
      },
      "id": "pmc:Vespasian",
      "label": {
        "de": "Vespasian",
        "en": "Vespasian"
      },
      "source": "Tacitus, Historiae IV.81",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:GraecoRoman"
    },
    {
      "definition": {
        "en": "The teaching that discretion is the mother of the virtues, directed against the practitioner who is undone not by laxity but by an excess undertaken in good faith."
      },
      "id": "pmc:ExcessiveAsceticismCaution",
      "label": {
        "de": "Unterscheidung gegen das Übermaß",
        "en": "Discretion against excess"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:cautionsAbout": {
        "id": "pmc:DiscernmentOfOrigins"
      },
      "source": "John Cassian, Collationes II (De discretione)",
      "type": "pm:Cautioning",
      "withinTradition": "pmt:ChristianAsceticDiscernment"
    },
    {
      "definition": {
        "en": "The generation of inner heat, presented in three components: the channels, the syllables, and the heat meditation itself."
      },
      "id": "pmp:Tummo",
      "label": {
        "de": "Tummo",
        "en": "Tummo"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Practicing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "A numbered course of mastery over the meditation objects, among them the order of the kasiṇa and its reverse, skipping the absorption, skipping the object, and the definition of the object."
      },
      "id": "pmp:FourteenfoldMastery",
      "label": {
        "de": "Beherrschung des Geistes in vierzehn Weisen",
        "en": "Control of the mind in fourteen ways"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Buddhaghosa, Visuddhimagga XII.2 (trans. Ñāṇamoli 1956)",
      "type": "pm:Practicing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "Knowledge of the moon's path, the calendrical rather than divinatory form of lunar knowledge."
      },
      "id": "pmc:CourseOfTheMoon",
      "label": {
        "de": "Der Lauf des Mondes",
        "en": "The course of the moon"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Sight beyond the range of the physical eye."
      },
      "id": "pmc:Dibbacakkhu",
      "label": {
        "de": "Göttliches Auge",
        "en": "Divine eye"
      },
      "source": "Buddhaghosa, Visuddhimagga XIII (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "Operative consciousness in which an assertion is made from direct insight rather than from historical reconstruction."
      },
      "id": "pm:GnosticState",
      "label": {
        "de": "Gnostischer Zustand",
        "en": "Gnostic state"
      },
      "note": {
        "en": "Use this context when a triple expresses a claim from within a tradition's first-person perspective."
      },
      "type": "pm:AwarenessContext"
    },
    {
      "definition": {
        "en": "The act of placing one concept in relation to another."
      },
      "id": "pm:Relating",
      "label": {
        "de": "Beziehen",
        "en": "Relating"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The art of fixing speech in ink on paper, treated in the text as a transgression rather than a gift."
      },
      "id": "pmc:WritingWithInk",
      "label": {
        "de": "Schreiben mit Tinte",
        "en": "Writing with ink"
      },
      "source": "1 Enoch 69:9 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:SamyamaYieldsParakayaPravesa",
      "label": {
        "de": "Saṃyama bringt den Eintritt in einen anderen Körper hervor",
        "en": "Saṃyama yields entry into another body"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:Samyama"
      },
      "pm:yieldsCapacity": {
        "id": "pmc:ParakayaPravesa"
      },
      "source": "Patañjali, Yogasūtra III.38",
      "type": "pm:Yielding",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "The transmission of the Nāṭyaśāstra and the theory of aesthetic states that follows from it."
      },
      "id": "pmt:SanskritDramaturgy",
      "label": {
        "de": "Sanskritische Dramaturgie",
        "en": "Sanskrit dramaturgy"
      },
      "source": "Nāṭyaśāstra VII",
      "type": "pm:Tradition"
    },
    {
      "id": "pmc:ShemihazahTeachesRootCutting",
      "label": {
        "de": "Schemichasa offenbart das Wurzelschneiden",
        "en": "Shemihazah discloses root-cutting"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:RootCutting"
      },
      "pm:ascribedTo": {
        "id": "pmc:Shemihazah"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The second of the three parts, the contemplation of created things."
      },
      "id": "pmc:Physike",
      "label": {
        "de": "Physikē",
        "en": "Contemplation of nature"
      },
      "source": "Evagrius Ponticus, Praktikos 1",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "definition": {
        "en": "A Watcher named as the one who disclosed the signs of the earth."
      },
      "id": "pmc:Araqiel",
      "label": {
        "de": "Araqiel",
        "en": "Araqiel"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Knowledge of bracelets and ornaments, of antimony and the painting of the eyelids, of precious stones and colouring tinctures."
      },
      "id": "pmc:AdornmentAndCosmetics",
      "label": {
        "de": "Schmuck und Kosmetik",
        "en": "Adornment and cosmetics"
      },
      "source": "1 Enoch 8:1 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:PracticePresupposesInitiation",
      "label": {
        "de": "Die Praxis setzt die Initiation voraus",
        "en": "The practice presupposes initiation"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmp:SaktipataTransmission"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Diksa"
      },
      "source": [
        "Abhinavagupta, Tantrāloka XV",
        "Mālinīvijayottaratantra VIII"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "A falsifying condition is stated and no case has yet been recorded against it."
      },
      "id": "pm:procedureWithoutCases",
      "label": {
        "de": "Verfahren ohne Fälle",
        "en": "Procedure without cases"
      },
      "type": "pm:ExaminationState"
    },
    {
      "definition": {
        "en": "Undifferentiated awareness in which no object is apprehended."
      },
      "id": "pm:DeepSleepState",
      "label": {
        "de": "Tiefschlafzustand (Suṣupti)",
        "en": "Deep sleep state (Suṣupti)"
      },
      "source": "Māṇḍūkya Upaniṣad, verse 5",
      "type": "pm:AwarenessContext"
    },
    {
      "definition": {
        "en": "First-person singular awareness bounded to a single subject."
      },
      "id": "pm:individualAwareness",
      "label": {
        "de": "Individuelles Bewusstsein",
        "en": "Individual awareness"
      },
      "type": "pm:AwarenessSpace"
    },
    {
      "definition": {
        "en": "A modern work bearing on the claim under examination, given as a bibliographic reference or a work identifier."
      },
      "domain": "pm:Testing",
      "id": "pm:evidenceFrom",
      "label": {
        "de": "Evidenz aus",
        "en": "evidence from"
      },
      "note": {
        "en": "Deliberately not dcterms:source. A modern study is never a witness to a tradition and must never appear as the source of one of its claims; it bears on a claim only as evidence inside an examination. Keeping the two predicates apart is what allows research to enter the record at all without loosening the rule that sources are received works."
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "The reading of import from lightning, given in place of astrology in the Aramaic-Greek witness."
      },
      "id": "pmc:SignsOfLightning",
      "label": {
        "de": "Zeichen der Blitze",
        "en": "Signs of the lightning flashes"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A four-part examination of an inner movement, set out in the image of the money-changer who tests a coin: for the metal, for the stamp, for the lawfulness of its provenance, and for its weight."
      },
      "id": "pmc:TestingOfThoughts",
      "label": {
        "de": "Die Prüfung der Gedanken",
        "en": "The examination of thoughts"
      },
      "note": {
        "en": "Ignatius adds the rule that the whole course of a train of thought is to be examined, since a bad end reveals the origin, and that a consolation arriving after the fact is to be examined well before it is believed."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:examinationState": {
        "id": "pm:procedureWithoutCases"
      },
      "pm:examinedBy": "John Cassian, transmitting Abba Moses; supplemented by Ignatius of Loyola",
      "pm:falsifiedBy": "A movement fails the test if its metal is false, its stamp is not that of right teaching, its provenance is unlawful, or it weighs light of the fear of God and heavy of human vanity; and it fails if the end of the train of thought is bad, however good its beginning.",
      "pm:protocolUpdated": "2026-08-28",
      "pm:tests": {
        "id": "pmc:DiscernmentOfOrigins"
      },
      "source": [
        "Ignatius of Loyola, Spiritual Exercises 334",
        "Ignatius of Loyola, Spiritual Exercises 336",
        "John Cassian, Collationes I.20-22"
      ],
      "type": "pm:Testing",
      "withinTradition": "pmt:ChristianAsceticDiscernment"
    },
    {
      "definition": {
        "en": "The continuous inward prayer that gives the tradition its practice."
      },
      "id": "pmc:PrayerOfTheHeart",
      "label": {
        "de": "Das Herzensgebet",
        "en": "The prayer of the heart"
      },
      "source": [
        "Philokalia IV, Gregory of Sinai, On Stillness and the Two Ways of Prayer",
        "Philokalia IV, Nikephoros the Monk, On Watchfulness and the Guarding of the Heart"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hesychasm"
    },
    {
      "id": "pmc:AbsorptionsAreGraded",
      "label": {
        "de": "Jede Vertiefung setzt die vorhergehende voraus",
        "en": "Each absorption presupposes the one before it"
      },
      "note": {
        "en": "The series is strictly graded in both canon and handbook, each stage defined by what it has let go of. No passage was found that forbids skipping in so many words, which is why this is recorded as an order and not as a necessity."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:FourthJhana"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:FourAbsorptions"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga IV (trans. Ñāṇamoli 1956)",
        "Dīgha Nikāya 2 (Sāmaññaphala Sutta)"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The reading of import from meteors, given in place of the knowledge of the clouds in the Aramaic-Greek witness."
      },
      "id": "pmc:SignsOfShootingStars",
      "label": {
        "de": "Zeichen der Sternschnuppen",
        "en": "Signs of the shooting stars"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:ShemihazahTeachesSpellCasting",
      "label": {
        "de": "Schemichasa offenbart die Beschwörung",
        "en": "Shemihazah discloses spell-casting"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SpellCasting"
      },
      "pm:ascribedTo": {
        "id": "pmc:Shemihazah"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The number of cases recorded under this protocol so far."
      },
      "domain": "pm:Testing",
      "id": "pm:caseCount",
      "label": {
        "de": "Fallzahl",
        "en": "case count"
      },
      "range": "xsd:integer",
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "The standing of a protocol: how far the attempt to fail a claim has actually been carried."
      },
      "id": "pm:ExaminationState",
      "label": {
        "de": "Prüfstand",
        "en": "Examination State"
      },
      "note": {
        "en": "The first two states and the third must never collapse into one another. A claim nobody has devised a way to examine is not a claim that has been examined and found wanting. A record that reports both as unsupported would not be reporting on the claims but on the reach of its own instruments."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "id": "pmc:ShamsielTeachesSignsOfTheSun",
      "label": {
        "de": "Schamsiel offenbart die Zeichen der Sonne",
        "en": "Shamsiel discloses the signs of the sun"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfTheSun"
      },
      "pm:ascribedTo": {
        "id": "pmc:Shamsiel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The act by which a claim entered the record. Instances of this class are modes of entry, not claims; a claim points at one of them through pm:attestedBy."
      },
      "id": "pm:Attesting",
      "label": {
        "de": "Bezeugen",
        "en": "Attesting"
      },
      "note": {
        "en": "Orthogonal to pm:AwarenessContext, which describes the state the asserter was in rather than the route by which the assertion reached the record."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "Sensual desire, ill will, dullness and drowsiness, restlessness and remorse, and doubt, whose abandoning the discourse describes immediately before entry into the first absorption."
      },
      "id": "pmc:FiveHindrances",
      "label": {
        "de": "Die fünf Hemmnisse",
        "en": "The five hindrances"
      },
      "source": "Dīgha Nikāya 2 (Sāmaññaphala Sutta)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The Attic mystery cult of Demeter and Kore, with a lesser rite at Agrai in the spring and the greater rite at Eleusis in the autumn."
      },
      "id": "pmt:EleusinianMysteries",
      "label": {
        "de": "Eleusinische Mysterien",
        "en": "Eleusinian mysteries"
      },
      "source": "Athenian decree concerning Eleusis, IG I³ 6",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "A warning against treating the given states as a further ladder: they descend and pass, and no course of effort produces them."
      },
      "id": "pmc:StatesAreNotOrdered",
      "label": {
        "de": "Die Zustände werden nicht der Reihe nach erlangt",
        "en": "The states are not attained in order"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:cautionsAbout": {
        "id": "pmc:Ahwal"
      },
      "source": [
        "al-Qushayrī, al-Risāla al-Qushayriyya",
        "al-Sarrāj, Kitāb al-Lumaʿ"
      ],
      "type": "pm:Cautioning",
      "withinTradition": "pmt:Sufism"
    },
    {
      "id": "pmc:PrayerPresupposesWatchfulness",
      "label": {
        "de": "Das Herzensgebet setzt Wachsamkeit und Führung voraus",
        "en": "The prayer of the heart presupposes watchfulness and guidance"
      },
      "note": {
        "en": "The writers of this corpus set watchfulness and the direction of a spiritual father before the prayer, and describe the way as passing from purification through illumination to perfection. The chapter divisions vary between the editions of the individual texts; the works and their titles are given so that the passages can be found in whichever edition is at hand."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:PrayerOfTheHeart"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Watchfulness"
      },
      "source": [
        "Philokalia I, Hesychios of Sinai, On Watchfulness and Holiness",
        "Philokalia IV, Gregory of Sinai, On Stillness and the Two Ways of Prayer",
        "Philokalia IV, Nikephoros the Monk, On Watchfulness and the Guarding of the Heart"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Hesychasm"
    },
    {
      "definition": {
        "en": "The transmission of the Book of Formation and its commentaries, in which the world is formed through letters, number and breath."
      },
      "id": "pmt:SeferYetzirah",
      "label": {
        "de": "Sefer Jetzira",
        "en": "Sefer Yetzirah"
      },
      "source": "Sefer Yetzirah 1:9-10",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The first of the three parts of the way, consisting in the keeping of the commandments and the labour against the passions."
      },
      "id": "pmc:Praktike",
      "label": {
        "de": "Praktikē",
        "en": "Ascetic practice"
      },
      "source": "Evagrius Ponticus, Praktikos 1",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "definition": {
        "en": "First-person exclusive awareness shared between two subjects (I and you)."
      },
      "id": "pm:dyadicAwareness",
      "label": {
        "de": "Dyadisches Bewusstsein",
        "en": "Dyadic awareness"
      },
      "type": "pm:AwarenessSpace"
    },
    {
      "definition": {
        "en": "The rite by which a person is admitted to the practice, set out in the tantra and reproduced with commentary in the Kashmirian exegesis."
      },
      "id": "pmc:Diksa",
      "label": {
        "de": "Initiation",
        "en": "Initiation"
      },
      "source": [
        "Abhinavagupta, Tantrāloka XV",
        "Mālinīvijayottaratantra VIII"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "The awareness context in which a statement is asserted."
      },
      "domain": "rdf:Statement",
      "id": "pm:assertedIn",
      "label": {
        "en": "asserted in"
      },
      "range": "pm:AwarenessContext",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The examination of an inner movement for its origin, distinguished threefold as angelic, human or demonic."
      },
      "id": "pmc:DiscernmentOfOrigins",
      "label": {
        "de": "Unterscheidung der Herkunft",
        "en": "Discernment of origins"
      },
      "source": [
        "Evagrius Ponticus, On Thoughts 8",
        "Evagrius Ponticus, Praktikos 80"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:ChristianAsceticDiscernment"
    },
    {
      "id": "pmc:AzazelTeachesMetalworking",
      "label": {
        "de": "Azazel offenbart Metallverarbeitung",
        "en": "Azazel discloses metalworking"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:Metalworking"
      },
      "pm:ascribedTo": {
        "id": "pmc:Azazel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:1 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The transmission of the Indian tantric completion-stage practices in Tibet, of which the six yogas of Nāropa are the best documented cycle."
      },
      "id": "pmt:TibetanTantric",
      "label": {
        "de": "Tibetisch-tantrische Überlieferung",
        "en": "Tibetan tantric tradition"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Tradition"
    },
    {
      "id": "pmc:DirectKnowledgesPresupposeConcentration",
      "label": {
        "de": "Die höheren Kenntnisse setzen die Sammlung voraus",
        "en": "The direct knowledges presuppose concentration"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:consequenceOfSkipping": "The handbook states that the six kinds of direct knowledge are arrived at with the support of perfected concentration and by nothing besides that.",
      "pm:dependentStep": [
        {
          "id": "pmc:Cetopariyanana"
        },
        {
          "id": "pmc:Dibbacakkhu"
        },
        {
          "id": "pmc:Dibbasota"
        },
        {
          "id": "pmc:Iddhividha"
        }
      ],
      "pm:prerequisiteStrength": {
        "id": "pm:statedNecessity"
      },
      "pm:priorStep": {
        "id": "pmc:Samadhi"
      },
      "source": "Buddhaghosa, Visuddhimagga I.11 (trans. Ñāṇamoli 1956)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The transmission of the Islamic mystical path, systematised in the handbooks of the tenth and eleventh centuries."
      },
      "id": "pmt:Sufism",
      "label": {
        "de": "Sufismus",
        "en": "Sufism"
      },
      "source": "al-Qushayrī, al-Risāla al-Qushayriyya",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The act, within a tradition, of warning against a capacity, a practice, or the pursuit of either."
      },
      "id": "pm:Cautioning",
      "label": {
        "de": "Warnen",
        "en": "Cautioning"
      },
      "note": {
        "en": "Held as a node rather than as commentary, because what a tradition warns against is part of what it teaches. A record that carries only the capacities and not the cautions misreports the tradition it claims to hold."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "A Watcher named in the Ethiopic teaching list as the one who disclosed the knowledge of the clouds."
      },
      "id": "pmc:Ezeqeel",
      "label": {
        "de": "Ezeqeel",
        "en": "Ezeqeel"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The first of the three trainings, on which the handbook is built as a commentary on the verse about the tangle."
      },
      "id": "pmc:Sila",
      "label": {
        "de": "Sittlichkeit",
        "en": "Virtue"
      },
      "source": "Buddhaghosa, Visuddhimagga I.1-I.8 (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:AraqielTeachesSignsOfTheEarth",
      "label": {
        "de": "Araqiel offenbart die Zeichen der Erde",
        "en": "Araqiel discloses the signs of the earth"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfTheEarth"
      },
      "pm:ascribedTo": {
        "id": "pmc:Araqiel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Mindfulness of in-breath and out-breath, set out as a sixteen-step progression in the discourse and as a meditation subject in the handbook."
      },
      "id": "pmp:Anapanasati",
      "label": {
        "de": "Ānāpānasati",
        "en": "Ānāpānasati"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga VIII (trans. Ñāṇamoli 1956)",
        "Majjhima Nikāya 118"
      ],
      "type": "pm:Practicing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The second of the three trainings, named in the handbook as the condition for the six direct knowledges."
      },
      "id": "pmc:Samadhi",
      "label": {
        "de": "Sammlung",
        "en": "Concentration"
      },
      "source": "Buddhaghosa, Visuddhimagga I.7-I.11 (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "A cross-tradition structural analogue, weaker than owl:sameAs and distinct from skos:closeMatch in that it asserts role-in-process similarity rather than lexical overlap."
      },
      "domain": "pm:Conceptualizing",
      "id": "pm:analogueConcept",
      "label": {
        "en": "analogue concept"
      },
      "range": "pm:Conceptualizing",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The transmission of the Enoch literature: the Book of the Watchers, the Astronomical Book, the Book of Dreams, the Epistle and, in the Ethiopic canon alone, the Book of Parables."
      },
      "id": "pmt:Enochic",
      "label": {
        "de": "Henochische Überlieferung",
        "en": "Enochic tradition"
      },
      "source": "G.W.E. Nickelsburg, 1 Enoch 1 (Hermeneia, 2001), introduction",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "Shield, breastplate and the sword for slaughter, disclosed as instruments of killing rather than as craft."
      },
      "id": "pmc:WeaponsOfDeath",
      "label": {
        "de": "Die Waffen des Todes",
        "en": "The weapons of death"
      },
      "source": "1 Enoch 69:6 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The claim that the soul leaves the body and returns to it, reported of Aristeas of Proconnesus and of Hermotimus of Clazomenae."
      },
      "id": "pmc:SoulJourney",
      "label": {
        "de": "Seelenreise ohne den Körper",
        "en": "Journey of the soul apart from the body"
      },
      "source": [
        "Herodotus, Histories IV.13-16",
        "Pliny, Naturalis Historia VII.174"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:GraecoRoman"
    },
    {
      "id": "pmc:SpiritPresupposesBreath",
      "label": {
        "de": "Die Verfeinerung des Geistes setzt die des Atems voraus",
        "en": "Refining spirit presupposes refining breath"
      },
      "note": {
        "en": "Recorded from the Yuan-period witness, not from the Han or Song works to which the sequence is commonly credited."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:NeidanThreeStages"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Qi"
      },
      "source": "Chen Zhixu, Jindan dayao, juan 4",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "definition": {
        "en": "The least of the five degrees of rapture, described as able to raise the hairs of the body."
      },
      "id": "pmc:KhuddikaPiti",
      "label": {
        "de": "Geringe Verzückung",
        "en": "Minor rapture"
      },
      "note": {
        "en": "This is the passage that attests piloerection as a recognised concomitant of a meditative state, not as its object."
      },
      "source": "Buddhaghosa, Visuddhimagga IV.94ff. (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The correspondence between the Indian channel-and-heat material and its Tibetan form, held as a node in order to be counted out: the route is documented, so the agreement is reception and carries no weight as evidence of an independently arrived-at structure."
      },
      "id": "pmc:IndoTibetanReception",
      "label": {
        "de": "Indo-tibetische Rezeption, keine Konvergenz",
        "en": "Indo-Tibetan reception, not convergence"
      },
      "note": {
        "en": "Recorded because a graph that only holds findings cannot show its own exclusions. Any later count of independent attestations must skip this pair."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:convergingConcept": [
        {
          "id": "pmc:InnerHeat"
        },
        {
          "id": "pmc:Kundalini"
        },
        {
          "id": "pmc:Rtsa"
        }
      ],
      "pm:transmissionPath": "The six yogas reach Tibet from the Indian mahāsiddha Nāropa through Marpa the translator; the transmission is named in the Tibetan sources themselves.",
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Converging"
    },
    {
      "definition": {
        "en": "Knowledge of the metals of the earth and of working them into blades, shields and body armour."
      },
      "id": "pmc:Metalworking",
      "label": {
        "de": "Metallverarbeitung und Waffenherstellung",
        "en": "Metalworking and weapon-making"
      },
      "source": "1 Enoch 8:1 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A disagreement about whether the eight limbs form a sequence that must be climbed. The sūtra that names them enumerates and says nothing about order; the commentarial layer introduces the categories of outer and inner limb, and later teaching hardens these into a rule of practice."
      },
      "id": "pmc:LimbOrderDispute",
      "label": {
        "de": "Ob die Glieder der Reihe nach zu durchlaufen sind",
        "en": "Whether the limbs must be traversed in order"
      },
      "note": {
        "en": "The disagreement is not between two traditions but between a base text and its readers, which is the commonest shape a dispute takes in this collection and the easiest to lose, because the readers usually win by default."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:disputedClaim": {
        "id": "pmc:AstangaLimbs"
      },
      "source": [
        "Patañjali, Yogasūtra II.29",
        "Vyāsa, Yogabhāṣya on Yogasūtra II.29"
      ],
      "type": "pm:Disputing"
    },
    {
      "definition": {
        "en": "A conclusion drawn by an editor or compiler that the source does not state."
      },
      "id": "pm:compilerInference",
      "label": {
        "de": "Schluss des Bearbeiters",
        "en": "Compiler inference"
      },
      "note": {
        "en": "Admissible as attestation of an ordering act, never of the claim being ordered. Enforced by pm:AttributionShape."
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "A capacity ascribed to a named ruler, in an account whose author remarks that those who were present still tell it although there is now no reward for the lie."
      },
      "id": "pmc:VespasianHealing",
      "label": {
        "de": "Heilung durch Berührung, Vespasian zugeschrieben",
        "en": "Healing by touch ascribed to Vespasian"
      },
      "note": {
        "en": "The remark about eyewitnesses is part of the ascription, not an endorsement of it. It records how the historian wanted the claim received."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:HealingByTouch"
      },
      "pm:ascribedTo": {
        "id": "pmc:Vespasian"
      },
      "pm:attestedBy": {
        "id": "pm:thirdPartyAscription"
      },
      "source": [
        "Suetonius, Divus Vespasianus 7",
        "Tacitus, Historiae IV.81"
      ],
      "type": "pm:Attributing",
      "withinTradition": "pmt:GraecoRoman"
    },
    {
      "definition": {
        "en": "A disagreement about a claim, carried on within a tradition, between traditions, or among the scholars who edit their texts."
      },
      "id": "pm:Disputing",
      "label": {
        "de": "Bestreiten",
        "en": "Disputing"
      },
      "note": {
        "en": "Without this class a disagreement can only be recorded by silently preferring one side, or by leaving the claim out because it is contested. Both losses are worse than the disagreement. A dispute node names what is at issue and cites each side, and a dispute with only one source cited is not a dispute."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "Repentance, placed first among the stations in the handbook enumeration."
      },
      "id": "pmc:Tawba",
      "label": {
        "de": "Umkehr",
        "en": "Turning back"
      },
      "source": "al-Qushayrī, al-Risāla al-Qushayriyya, chapter on the stations",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Sufism"
    },
    {
      "definition": {
        "en": "First-person inclusive awareness bounded to an identified group."
      },
      "id": "pm:collectiveAwareness",
      "label": {
        "de": "Kollektives Bewusstsein",
        "en": "Collective awareness"
      },
      "type": "pm:AwarenessSpace"
    },
    {
      "definition": {
        "en": "Perception of what is distant, hidden or obstructed."
      },
      "id": "pmc:DivyaCaksus",
      "label": {
        "de": "Göttliches Auge",
        "en": "Divine eye"
      },
      "source": "Patañjali, Yogasūtra III.26",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "The absorption from which the handbook has the supernormal powers proceed, and which it calls their natural plane."
      },
      "id": "pmc:FourthJhana",
      "label": {
        "de": "Die vierte Vertiefung",
        "en": "The fourth absorption"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga XII.1 (trans. Ñāṇamoli 1956)",
        "Buddhaghosa, Visuddhimagga XII.49 (trans. Ñāṇamoli 1956)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:StillnessPresupposesRepentance",
      "label": {
        "de": "Stille und Liebe setzen Buße und den Kampf gegen die Leidenschaften voraus",
        "en": "Stillness and love presuppose repentance and the labour against the passions"
      },
      "note": {
        "en": "The work is emphatic that neither stillness nor the love of God is reached without the prior repentance and the fight with the passions. It does not, however, state for every rung that the next is unreachable without it, and the image of the ladder is didactic before it is ontological, which is why the strength here is order and not necessity."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:LadderOfThirtySteps"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Praktike"
      },
      "source": "John Climacus, The Ladder of Divine Ascent, steps 1-30",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "definition": {
        "en": "What the source says happens if the prior step is passed over."
      },
      "domain": "pm:Presupposing",
      "id": "pm:consequenceOfSkipping",
      "label": {
        "de": "Folge des Überspringens",
        "en": "consequence of skipping"
      },
      "note": {
        "en": "Required wherever the strength is pm:statedNecessity. Claiming that a text sets a necessity obliges the claimant to say what the text says goes wrong without it; a necessity nobody can quote a consequence for is an order read as a necessity."
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "The observation that a body or seat of awareness distinct from the physical one is claimed in the Pāli handbooks, in the Yogasūtra, and in Greek reports of men whose souls left them."
      },
      "id": "pmc:ExteriorisationCorrespondence",
      "label": {
        "de": "Die Entsprechung der Exteriorisation",
        "en": "The exteriorisation correspondence"
      },
      "note": {
        "en": "The Indian pair share a sphere and a technical vocabulary and are not independent of each other. The Greek reports are of a different kind entirely: they are second-hand ascriptions to figures long dead, made by historians rather than by practitioners, and a route of contact with the Indian material has been proposed but not shown."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:convergingConcept": [
        {
          "id": "pmc:Manomayakaya"
        },
        {
          "id": "pmc:ParakayaPravesa"
        },
        {
          "id": "pmc:SoulJourney"
        }
      ],
      "pm:independentAttestation": {
        "id": "pmt:GraecoRoman"
      },
      "pm:transmissionPath": "Theravāda and Pātañjala Yoga share the Indian sphere and a common technical vocabulary. A Scythian or shamanic route to the Greek reports has been proposed in the scholarship but is not documented.",
      "source": [
        "Dīgha Nikāya 2 (Sāmaññaphala Sutta, DN i.77)",
        "Herodotus, Histories IV.13-16",
        "Patañjali, Yogasūtra III.38"
      ],
      "type": "pm:Converging"
    },
    {
      "definition": {
        "en": "A graded series in which each stage is reached by letting go of a factor still present in the one before it."
      },
      "id": "pmc:FourAbsorptions",
      "label": {
        "de": "Die vier Vertiefungen",
        "en": "The four absorptions"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga IV (trans. Ñāṇamoli 1956)",
        "Dīgha Nikāya 2 (Sāmaññaphala Sutta)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:LimbPracticeYieldsLightOfKnowledge",
      "label": {
        "de": "Die Übung der Glieder bringt das Leuchten der Erkenntnis hervor",
        "en": "Practice of the limbs yields the light of knowledge"
      },
      "note": {
        "en": "The sūtra makes the arising conditional on the wearing away of impurity, which is itself said to come from the practice. The condition is part of the claim and is not to be dropped when the claim is quoted."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:PracticeOfTheLimbs"
      },
      "pm:yieldsCapacity": {
        "id": "pmc:LightOfKnowledge"
      },
      "source": "Patañjali, Yogasūtra II.28",
      "type": "pm:Yielding",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "id": "pmc:GreaterPresupposeLesser",
      "label": {
        "de": "Die großen Mysterien setzen die kleinen voraus",
        "en": "The greater mysteries presuppose the lesser"
      },
      "note": {
        "en": "The requirement is institutional and concerns admission, not efficacy. The inscription regulates participation in both rites; nothing in it says that the greater rite would fail for one who had skipped the lesser, only that such a one is not admitted."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:GreaterMysteries"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:LesserMysteries"
      },
      "source": "Athenian decree concerning Eleusis, IG I³ 6, face C",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:EleusinianMysteries"
    },
    {
      "definition": {
        "en": "The capacity that an attribution ascribes."
      },
      "domain": "pm:Attributing",
      "id": "pm:ascribedCapacity",
      "label": {
        "de": "zugeschriebenes Vermögen",
        "en": "ascribed capacity"
      },
      "range": "pm:Conceptualizing",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "An examination of the claim that the tummo practice produces inner heat, taken up because this is the one pairing in the collection whose capacity has an outward side that instruments reach."
      },
      "id": "pmc:TummoHeatExamination",
      "label": {
        "de": "Prüfung der Tummo-Hitze-Behauptung",
        "en": "Examination of the tummo heat claim"
      },
      "note": {
        "en": "What the measurements bear on is the somatic claim and nothing beyond it. Reported temperature rises are consistent with the practice producing heat; they say nothing about the cosmology the practice is embedded in, and the node must not be read as though they did. The reported effect also depends on the forceful-breath component together with the visualisation, which means the claim that is actually supported is narrower than the one the tradition makes."
      },
      "pm:attestedBy": {
        "id": "pm:protocolledPractice"
      },
      "pm:baseRate": "Temperature change under comparable breathing effort without the practice, in matched participants.",
      "pm:evidenceFrom": [
        "H. Benson et al., Body temperature changes during the practice of g-tummo yoga, Nature 295 (1982), 234-236",
        "M. Kozhevnikov et al., Neurocognitive and somatic components of temperature increases during g-tummo meditation, PLoS ONE 8(3) (2013), e58244, doi:10.1371/journal.pone.0058244"
      ],
      "pm:examinationState": {
        "id": "pm:casesWithDeviation"
      },
      "pm:examinedBy": "H. Benson and colleagues; M. Kozhevnikov and colleagues",
      "pm:falsifiedBy": "Practitioners of the forceful-breath tummo method show no rise in measured body temperature beyond that produced by the breathing alone in matched non-practitioners.",
      "pm:protocolUpdated": "2026-08-28",
      "pm:tests": {
        "id": "pmc:TummoYieldsInnerHeat"
      },
      "type": "pm:Testing"
    },
    {
      "definition": {
        "en": "The observation that several traditions name something conducted or borne in the body and susceptible of deliberate direction."
      },
      "id": "pmc:VitalEnergyCorrespondence",
      "label": {
        "de": "Die Entsprechung der Lebensenergie",
        "en": "The vital-energy correspondence"
      },
      "note": {
        "en": "The correspondence is weaker than it looks. Pneuma is a principle of cosmic cohesion and not a faculty; the breath of the Sefer Yetzirah is a medium of formation and not a conduction through the limbs. Only the Chinese and the Indian material carries the operative sense the modern draft assumes."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:convergingConcept": [
        {
          "id": "pmc:InnerHeat"
        },
        {
          "id": "pmc:Kundalini"
        },
        {
          "id": "pmc:Piti"
        },
        {
          "id": "pmc:Pneuma"
        },
        {
          "id": "pmc:Prana"
        },
        {
          "id": "pmc:Qi"
        },
        {
          "id": "pmc:Ruach"
        }
      ],
      "pm:independentAttestation": [
        {
          "id": "pmt:Daoist"
        },
        {
          "id": "pmt:Upanisadic"
        }
      ],
      "pm:transmissionPath": "The Tibetan material reaches Tibet from the Indian mahāsiddha Nāropa through Marpa the translator and is therefore reception, not independent attestation. Buddhist and Daoist exchange along the trade routes is documented and forbids treating the Chinese and Buddhist testimony as wholly separate. The Greek and Hebrew items are neither route-linked nor operatively parallel.",
      "source": [
        "Chāndogya Upaniṣad 7.15.1",
        "Xingqi yupei ming (jade inscription on circulating the qi)"
      ],
      "type": "pm:Converging"
    },
    {
      "id": "pmc:StationsPresupposeTheOneBelow",
      "label": {
        "de": "Eine Station setzt die darunterliegende voraus",
        "en": "A station presupposes the station below it"
      },
      "note": {
        "en": "The handbooks set turning back as the first station and hold that the one below must be kept before the one above is reached. The enumeration and the count of the stations differ between the handbooks; the precedence of turning back does not."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:Maqamat"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Tawba"
      },
      "source": [
        "al-Qushayrī, al-Risāla al-Qushayriyya, chapter on the stations",
        "al-Sarrāj, Kitāb al-Lumaʿ"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Sufism"
    },
    {
      "definition": {
        "en": "How far the attempt to fail the claim has been carried."
      },
      "domain": "pm:Testing",
      "id": "pm:examinationState",
      "label": {
        "de": "Prüfstand",
        "en": "examination state"
      },
      "range": "pm:ExaminationState",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "Inward-turned awareness of subtle objects generated by the mind."
      },
      "id": "pm:DreamingState",
      "label": {
        "de": "Traumzustand (Svapna)",
        "en": "Dreaming state (Svapna)"
      },
      "source": "Māṇḍūkya Upaniṣad, verse 4",
      "type": "pm:AwarenessContext"
    },
    {
      "definition": {
        "en": "The general and the tantra-specific preliminaries, placed before the training in either stage."
      },
      "id": "pmp:Preliminaries",
      "label": {
        "de": "Die Vorbereitungen",
        "en": "The preliminaries"
      },
      "note": {
        "en": "A dating warning belongs here. The preliminaries are set before the training in the fifteenth-century treatise, but the sharpest codification of them as an obligatory course is nineteenth-century, in Patrul Rinpoche's manual. Their presence in the older text does not license reading the later regime back into it."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "Patrul Rinpoche, Kun bzang bla ma'i zhal lung (19th century)",
        "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)"
      ],
      "type": "pm:Practicing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "One party ascribes the capacity to another, who does not report it. Common for capacities said to be lost, since no bearer remains to be asked."
      },
      "id": "pm:thirdPartyAscription",
      "label": {
        "de": "Fremdzuschreibung",
        "en": "Third-party ascription"
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "A second body, formed and complete in its faculties, said to be produced from this one; the classical form of the claim the modern draft calls exteriorisation."
      },
      "id": "pmc:Manomayakaya",
      "label": {
        "de": "Geistgemachter Körper",
        "en": "Mind-made body"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga XII (trans. Ñāṇamoli 1956)",
        "Dīgha Nikāya 2 (Sāmaññaphala Sutta, DN i.77)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The discourse distinguishes three marvels, of psychic power, of mind-reading and of instruction, and holds only instruction to be reliable; the display of power for the sake of persuasion is refused as something to be ashamed of."
      },
      "id": "pmc:DisplayOfPowersRefused",
      "label": {
        "de": "Zurschaustellung der Kräfte verweigert",
        "en": "Display of powers refused"
      },
      "note": {
        "en": "The Vinaya rule against displaying superhuman states to laypeople stands alongside it."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:cautionsAbout": [
        {
          "id": "pmc:Cetopariyanana"
        },
        {
          "id": "pmc:Dibbacakkhu"
        },
        {
          "id": "pmc:Dibbasota"
        },
        {
          "id": "pmc:Manomayakaya"
        }
      ],
      "source": [
        "Dīgha Nikāya 11 (Kevaṭṭa Sutta)",
        "Vinaya, Cūḷavagga V.8"
      ],
      "type": "pm:Cautioning",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The emergence of a form out of a prior undifferentiated ground."
      },
      "id": "pm:Manifesting",
      "label": {
        "de": "Manifestieren",
        "en": "Manifesting"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "id": "pmc:AnapanasatiYieldsPiti",
      "label": {
        "de": "Atemachtsamkeit bringt Verzückung hervor",
        "en": "Mindfulness of breathing yields rapture"
      },
      "note": {
        "en": "Rapture appears in the handbook as a factor of absorption reached through the meditation subject, not as something aimed at directly. The pairing is recorded at that strength."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:Anapanasati"
      },
      "pm:yieldsCapacity": {
        "id": "pmc:Piti"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga IV.94ff. (trans. Ñāṇamoli 1956)",
        "Buddhaghosa, Visuddhimagga VIII (trans. Ñāṇamoli 1956)"
      ],
      "type": "pm:Yielding",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "Awareness whose reach is unbounded across all possible subjects."
      },
      "id": "pm:universalAwareness",
      "label": {
        "de": "Universelles Bewusstsein",
        "en": "Universal awareness"
      },
      "type": "pm:AwarenessSpace"
    },
    {
      "definition": {
        "en": "The claim, made within a tradition, that a named practice produces a named capacity."
      },
      "id": "pm:Yielding",
      "label": {
        "de": "Hervorbringen",
        "en": "Yielding"
      },
      "note": {
        "en": "Held as a node and not as an edge for the same reason pm:Attributing is: only a node can carry its own source, its own mode of attestation, and a protocol that tries to fail it. A bare edge would make every such claim look alike, whatever it rests on, and would leave nothing for pm:Testing to point at. The question of which capacities a practice actually develops is answerable only where the pairing itself is addressable."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "id": "pmc:ApatheiaPresupposesAscesis",
      "label": {
        "de": "Apatheia setzt asketische Arbeit voraus",
        "en": "Apatheia presupposes ascetic labour"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:consequenceOfSkipping": "Apatheia is called the flower of ascetic labour and ascetic labour is defined as the keeping of the commandments, so that where the labour is absent the freedom from the passions does not appear at all rather than appearing in a lesser degree.",
      "pm:dependentStep": {
        "id": "pmc:Apatheia"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:statedNecessity"
      },
      "pm:priorStep": {
        "id": "pmc:Praktike"
      },
      "source": "Evagrius Ponticus, Praktikos 81",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "definition": {
        "en": "The guarding of the heart and the attention to what arises in it, treated as the groundwork on which the prayer of the heart is built."
      },
      "id": "pmc:Watchfulness",
      "label": {
        "de": "Wachsamkeit",
        "en": "Watchfulness"
      },
      "source": [
        "Philokalia I, Diadochus of Photice, Gnostic Chapters",
        "Philokalia I, Hesychios of Sinai, On Watchfulness and Holiness"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hesychasm"
    },
    {
      "id": "pmc:SixteenStepsOfBreathing",
      "label": {
        "de": "Die sechzehn Schritte der Atemachtsamkeit",
        "en": "The sixteen steps of mindfulness of breathing"
      },
      "note": {
        "en": "Recorded at the weakest strength on purpose. The discourse sets out four tetrads of four steps and assigns them to the four foundations of mindfulness. It presents a progression; it does not say that a step is unreachable without the one before it, and the question whether the order is binding or expository is contested among practitioners to this day."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmp:Anapanasati"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:presentationOrder"
      },
      "pm:priorStep": {
        "id": "pmp:Anapanasati"
      },
      "source": "Majjhima Nikāya 118",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The third of the three parts, the knowledge of God."
      },
      "id": "pmc:Theologike",
      "label": {
        "de": "Theologikē",
        "en": "Knowledge of God"
      },
      "source": "Evagrius Ponticus, Praktikos 1",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "id": "pmc:SuccessPresupposesNadiPurification",
      "label": {
        "de": "Erfolg der Praxis setzt die Reinigung der Kanäle voraus",
        "en": "Success in the practice presupposes purification of the channels"
      },
      "note": {
        "en": "The text directs the breath practice at clearing the impurity of the central channel and gives the outward signs by which accomplished purification is known. It makes success depend on the purification without stating in these verses what befalls one who proceeds without it, which is why the strength here is order and not necessity."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmp:HathaPranayama"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:NadiPurification"
      },
      "source": [
        "Svātmārāma, Haṭhayogapradīpikā II.19-20",
        "Svātmārāma, Haṭhayogapradīpikā II.6"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The named compiler who performed the ordering act. Without it, an order made in the present is indistinguishable from an order found in the source."
      },
      "domain": "pm:Systematizing",
      "id": "pm:compiledBy",
      "label": {
        "de": "geordnet von",
        "en": "compiled by"
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "The deliberate raising and sustaining of a chosen affective state as a meditation subject in its own right."
      },
      "id": "pmp:BrahmaviharaBhavana",
      "label": {
        "de": "Kultivierung der göttlichen Verweilungen",
        "en": "Cultivation of the divine abidings"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Buddhaghosa, Visuddhimagga IX (trans. Ñāṇamoli 1956)",
      "type": "pm:Practicing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:PranayamaPresupposesAsana",
      "label": {
        "de": "Atemregulierung setzt Festigkeit in der Haltung voraus",
        "en": "Breath regulation presupposes firmness in posture"
      },
      "note": {
        "en": "The verse opens the breath chapter by requiring that the practitioner first be established in posture and in a measured diet, and that the breath practice then follow the instruction of a teacher. The condition is in the base text, not in a commentary."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmp:HathaPranayama"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Asana"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā II.1",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The capacity a yielding claim arrives at. That the tradition says so is the claim; that the practice produces it is not asserted."
      },
      "domain": "pm:Yielding",
      "id": "pm:yieldsCapacity",
      "label": {
        "de": "bringt Vermögen hervor",
        "en": "yields capacity"
      },
      "range": "pm:Conceptualizing",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "Nobody has stated a condition under which the claim would count as refuted. This is a statement about the means of examination, not about the claim."
      },
      "id": "pm:noProcedureDevised",
      "label": {
        "de": "Kein Verfahren ersonnen",
        "en": "No procedure devised"
      },
      "type": "pm:ExaminationState"
    },
    {
      "id": "pmc:ConcentrationPresupposesVirtue",
      "label": {
        "de": "Sammlung setzt Sittlichkeit voraus",
        "en": "Concentration presupposes virtue"
      },
      "note": {
        "en": "The handbook is built as a commentary on a canonical verse in which the one established in virtue develops mind and understanding, and it glosses the order accordingly."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:Samadhi"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Sila"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga I.1 (trans. Ñāṇamoli 1956)",
        "Buddhaghosa, Visuddhimagga I.7-I.8 (trans. Ñāṇamoli 1956)"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "Hearing beyond the range of the physical ear."
      },
      "id": "pmc:Dibbasota",
      "label": {
        "de": "Göttliches Ohr",
        "en": "Divine ear"
      },
      "source": "Buddhaghosa, Visuddhimagga XIII (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:KokabelTeachesConstellations",
      "label": {
        "de": "Kokabel offenbart die Sternbilder",
        "en": "Kokabel discloses the constellations"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:Constellations"
      },
      "pm:ascribedTo": {
        "id": "pmc:Kokabel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The initiatory act by which the descent of power is conferred."
      },
      "id": "pmp:SaktipataTransmission",
      "label": {
        "de": "Übertragung der Herabkunft der Kraft",
        "en": "Conferring the descent of power"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "Abhinavagupta, Tantrasāra XI",
        "Abhinavagupta, Tantrāloka XIII"
      ],
      "type": "pm:Practicing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "How firmly the source sets the prerequisite."
      },
      "domain": "pm:Presupposing",
      "id": "pm:prerequisiteStrength",
      "label": {
        "de": "Stärke der Voraussetzung",
        "en": "prerequisite strength"
      },
      "range": "pm:PrerequisiteStrength",
      "type": "owl:ObjectProperty"
    },
    {
      "comment": {
        "en": "Consciousness-first meta-ontology. Processes, not substances."
      },
      "id": "https://pajew.ski/prima-materia/ontology",
      "license": "https://creativecommons.org/publicdomain/zero/1.0/",
      "title": {
        "en": "prima-materia core ontology"
      },
      "type": "owl:Ontology"
    },
    {
      "definition": {
        "en": "Ten states arising in practice, among them luminosity, rapture, tranquillity, pleasure and resolve, which are not defilements in themselves but become obstacles when taken as proof of attainment."
      },
      "id": "pmc:ImperfectionsOfInsight",
      "label": {
        "de": "Die Unvollkommenheiten der Einsicht",
        "en": "The imperfections of insight"
      },
      "note": {
        "en": "The handbook illustrates the error with the monk who held himself awakened for sixty years. This is the tradition's own answer to the question of how a practitioner mistakes a state for a result."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:cautionsAbout": {
        "id": "pmc:Piti"
      },
      "source": "Buddhaghosa, Visuddhimagga XX.105ff. (trans. Ñāṇamoli 1956)",
      "type": "pm:Cautioning",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:ZiqelTeachesSignsOfShootingStars",
      "label": {
        "de": "Ziqel offenbart die Zeichen der Sternschnuppen",
        "en": "Ziqel discloses the signs of the shooting stars"
      },
      "note": {
        "en": "Stands in the position the Ethiopic fills with Ezeqeel and the knowledge of the clouds."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfShootingStars"
      },
      "pm:ascribedTo": {
        "id": "pmc:Ziqel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A bounded subgraph that carries emergent meaning irreducible to its individual triples. Designed for vector embedding as a unit."
      },
      "id": "pm:MeaningCluster",
      "label": {
        "de": "Bedeutungs-Cluster",
        "en": "Meaning Cluster"
      },
      "note": {
        "en": "Implements the Sphoṭa principle (Bhartṛhari): meaning resides in the whole utterance, not in isolated phonemes. The subgraph is the phoneme-analog; the cluster is the sphoṭa."
      },
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The preparatory rite at Agrai, held in the month Anthesterion."
      },
      "id": "pmc:LesserMysteries",
      "label": {
        "de": "Die kleinen Mysterien",
        "en": "The lesser mysteries"
      },
      "source": "Athenian decree concerning Eleusis, IG I³ 6, face C",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:EleusinianMysteries"
    },
    {
      "definition": {
        "en": "A documented route of historical contact between the traditions in which the correspondence appears. Its presence downgrades the correspondence from convergence to reception."
      },
      "domain": "pm:Converging",
      "id": "pm:transmissionPath",
      "label": {
        "de": "Übertragungsweg",
        "en": "transmission path"
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "Associates a process instance with the tradition in which it is situated."
      },
      "id": "pm:withinTradition",
      "label": {
        "en": "within tradition"
      },
      "range": "pm:Tradition",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The capacities of the third chapter are named obstacles with respect to samādhi and attainments only with respect to the outward-turned state. The tradition that catalogues them is the same one that warns against them."
      },
      "id": "pmc:SiddhisAsObstacle",
      "label": {
        "de": "Die Kräfte sind Hindernisse für samādhi",
        "en": "The powers are obstacles to samādhi"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:cautionsAbout": [
        {
          "id": "pmc:DivyaCaksus"
        },
        {
          "id": "pmc:DivyaSrotra"
        },
        {
          "id": "pmc:ParacittaJnana"
        },
        {
          "id": "pmc:ParakayaPravesa"
        }
      ],
      "source": "Patañjali, Yogasūtra III.37",
      "type": "pm:Cautioning",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "id": "pmc:KnowledgePresupposesContemplation",
      "label": {
        "de": "Gotteserkenntnis setzt Naturschau voraus",
        "en": "Knowledge of God presupposes contemplation of nature"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:Theologike"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Physike"
      },
      "source": "Evagrius Ponticus, Praktikos 1",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "id": "pmc:KokabelTeachesSignsOfTheStars",
      "label": {
        "de": "Kokabel offenbart die Zeichen der Sterne",
        "en": "Kokabel discloses the signs of the stars"
      },
      "note": {
        "en": "Stands in the position the Ethiopic fills with the constellations."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfTheStars"
      },
      "pm:ascribedTo": {
        "id": "pmc:Kokabel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A Watcher whose teaching concerns the moon; the Ethiopic gives its course, the Aramaic-Greek witness gives its signs under the name Sahriel."
      },
      "id": "pmc:Sariel",
      "label": {
        "de": "Sariel",
        "en": "Sariel"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The source instructs that one comes before the other, without saying what follows from disregarding it."
      },
      "id": "pm:prescribedOrder",
      "label": {
        "de": "Angeordnete Reihenfolge",
        "en": "Prescribed order"
      },
      "type": "pm:PrerequisiteStrength"
    },
    {
      "definition": {
        "en": "The binding of persons or events by spoken formula."
      },
      "id": "pmc:SpellCasting",
      "label": {
        "de": "Beschwörung",
        "en": "Spell-casting"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "How firmly a source sets a prerequisite: as a necessity, as an instruction, or merely by the order in which it presents its material."
      },
      "id": "pm:PrerequisiteStrength",
      "label": {
        "de": "Stärke der Voraussetzung",
        "en": "Prerequisite Strength"
      },
      "note": {
        "en": "The three must not collapse. A list of eight limbs in the order given is not the same claim as a sentence saying that the eighth is unreachable without the seventh, and reading the first as the second is the commonest way a modern system acquires an ancient warrant it never had."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The warning that an experience of luminosity or consolation may be counterfeit, and that the counterfeit is recognised by its circumstances rather than by its brightness."
      },
      "id": "pmc:AngelOfLightDeception",
      "label": {
        "de": "Die Täuschung, die als Licht erscheint",
        "en": "The deception that appears as light"
      },
      "note": {
        "en": "Diadochus distinguishes the true consolation, which comes with the body awake and in warm love, from the false, which comes in a light half-sleep."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:cautionsAbout": {
        "id": "pmc:DiscernmentOfOrigins"
      },
      "source": [
        "Diadochus of Photice, Gnostic Chapters 40",
        "Evagrius Ponticus, On Thoughts 39"
      ],
      "type": "pm:Cautioning",
      "withinTradition": "pmt:ChristianAsceticDiscernment"
    },
    {
      "definition": {
        "en": "The stated condition under which the claim counts as refuted."
      },
      "domain": "pm:Testing",
      "id": "pm:falsifiedBy",
      "label": {
        "de": "widerlegt durch",
        "en": "falsified by"
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "Who devised or carried the protocol. A protocol without a named author is unaccountable, and an unaccountable protocol is not evidence of anything."
      },
      "domain": "pm:Testing",
      "id": "pm:examinedBy",
      "label": {
        "de": "geprüft von",
        "en": "examined by"
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "The rite at Eleusis, held in the month Boedromion."
      },
      "id": "pmc:GreaterMysteries",
      "label": {
        "de": "Die großen Mysterien",
        "en": "The greater mysteries"
      },
      "source": "Athenian decree concerning Eleusis, IG I³ 6, face C",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:EleusinianMysteries"
    },
    {
      "id": "pmc:SamyamaYieldsDivyaSrotra",
      "label": {
        "de": "Saṃyama bringt das göttliche Ohr hervor",
        "en": "Saṃyama yields the divine ear"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:Samyama"
      },
      "pm:yieldsCapacity": {
        "id": "pmc:DivyaSrotra"
      },
      "source": "Patañjali, Yogasūtra III.41",
      "type": "pm:Yielding",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "Heat held to be generated within the body by deliberate practice rather than received from outside it."
      },
      "id": "pmc:InnerHeat",
      "label": {
        "de": "Innere Hitze",
        "en": "Inner heat"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "A disagreement among editors about the age of the inscription on circulating the qi and about how its opening is to be construed. One dating places it in the late fourth or early third century before the common era, another in the middle of the sixth; one reading takes the opening characters as a title and begins the text at the second line, another counts and construes differently."
      },
      "id": "pmc:XingqiInscriptionDispute",
      "label": {
        "de": "Datierung und Lesung der Jadeinschrift",
        "en": "The dating and reading of the jade inscription"
      },
      "note": {
        "en": "Held as a node rather than as a remark, because the dating decides whether this is the earliest datable witness to deliberate circulation of the qi or one witness among several, and because a citation that names only the inscription conceals that anything is at issue."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:disputedClaim": {
        "id": "pmp:Xingqi"
      },
      "source": [
        "D. Harper, Early Chinese Medical Literature (1998), p. 125",
        "H.D. Roth, Original Tao (1999)",
        "J. Needham, Science and Civilisation in China II (1956), p. 143"
      ],
      "type": "pm:Disputing"
    },
    {
      "definition": {
        "en": "The reading of import from terrestrial phenomena."
      },
      "id": "pmc:SignsOfTheEarth",
      "label": {
        "de": "Zeichen der Erde",
        "en": "Signs of the earth"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:ThreefoldAscentOrder",
      "label": {
        "de": "Naturschau setzt asketische Praxis voraus",
        "en": "Contemplation of nature presupposes ascetic practice"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:Physike"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Praktike"
      },
      "source": "Evagrius Ponticus, Praktikos 1",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "definition": {
        "en": "Knowledge of the fixed groupings of stars."
      },
      "id": "pmc:Constellations",
      "label": {
        "de": "Die Sternbilder",
        "en": "The constellations"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The act of imposing an order on material that did not carry it: a list, a sequence, a correspondence table. Named, dated, and attributed to the compiler who performed it, never to the source that is being ordered."
      },
      "id": "pm:Systematizing",
      "label": {
        "de": "Systematisieren",
        "en": "Systematizing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "id": "pmc:TrainingPresupposesPreliminaries",
      "label": {
        "de": "Das Training setzt die Vorbereitungen voraus",
        "en": "The training presupposes the preliminaries"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:GenerationStage"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmp:Preliminaries"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "id": "pmc:IddhiPresupposesFourteenfoldMastery",
      "label": {
        "de": "Übernatürliche Kraft setzt die vierzehnfache Beherrschung voraus",
        "en": "Supernormal power presupposes the fourteenfold mastery"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:consequenceOfSkipping": "The handbook states that it is not possible for a meditator even to begin to accomplish transformation by supernormal power without having first completed the development of control of the mind in those fourteen ways.",
      "pm:dependentStep": {
        "id": "pmc:Iddhividha"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:statedNecessity"
      },
      "pm:priorStep": {
        "id": "pmp:FourteenfoldMastery"
      },
      "source": "Buddhaghosa, Visuddhimagga XII.8 (trans. Ñāṇamoli 1956)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "A light held to be uncreated, and held to shine through the whole person, body as well as soul; the defence is explicitly that the body participates and is not merely the site of an event in the soul."
      },
      "id": "pmc:UncreatedLight",
      "label": {
        "de": "Ungeschaffenes Licht",
        "en": "Uncreated light"
      },
      "note": {
        "en": "This is a claim about what shines through the practitioner, not about an emanation the practitioner produces or directs."
      },
      "source": "Gregory Palamas, Triads in Defence of the Holy Hesychasts (trans. Gendle 1983)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hesychasm"
    },
    {
      "definition": {
        "en": "The transmission of the Yogasūtra of Patañjali and its commentarial literature."
      },
      "id": "pmt:PatanjalaYoga",
      "label": {
        "de": "Pātañjala-Yoga",
        "en": "Pātañjala Yoga"
      },
      "source": "Patañjali, Yogasūtra",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The transmission of the Pāli canon and its commentarial literature, of which the Visuddhimagga of Buddhaghosa is the systematising handbook."
      },
      "id": "pmt:Theravada",
      "label": {
        "de": "Theravāda",
        "en": "Theravāda"
      },
      "source": "Buddhaghosa, Visuddhimagga (trans. Ñāṇamoli 1956)",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "Rapture as a bodily felt state, graded in the handbook into five degrees of increasing pervasion."
      },
      "id": "pmc:Piti",
      "label": {
        "de": "Pīti",
        "en": "Pīti"
      },
      "note": {
        "en": "The five degrees are khuddikā, khaṇikā, okkantikā, ubbegā and pharaṇā."
      },
      "source": "Buddhaghosa, Visuddhimagga IV.94ff. (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:QiListeningPresupposesEmptying",
      "label": {
        "de": "Das Hören mit dem Qi setzt das Leeren des Herzens voraus",
        "en": "Attending with the qi presupposes the emptying of the heart"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:consequenceOfSkipping": "In the dialogue the disciple is told outright that he is not yet ready, and is sent back to empty the heart before anything further; the hearing that stops at the ears and the heart-mind does not reach the qi at all.",
      "pm:dependentStep": {
        "id": "pmc:Qi"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:statedNecessity"
      },
      "pm:priorStep": {
        "id": "pmc:EmptyingOfTheHeart"
      },
      "source": "Zhuangzi 4",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "id": "pmc:IddhiPresupposesFourthJhana",
      "label": {
        "de": "Übernatürliche Kraft setzt die vierte Vertiefung voraus",
        "en": "Supernormal power presupposes the fourth absorption"
      },
      "note": {
        "en": "The handbook assigns the task to a meditator who has reached the fourth absorption and calls that absorption the natural plane for obtaining the power. It does not, at these places, say what happens to one who attempts it from elsewhere."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:Iddhividha"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:FourthJhana"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga XII.1 (trans. Ñāṇamoli 1956)",
        "Buddhaghosa, Visuddhimagga XII.12-13 (trans. Ñāṇamoli 1956)"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:InitiationPresupposesSaktipata",
      "label": {
        "de": "Die Initiation setzt die Herabkunft der Kraft voraus",
        "en": "Initiation presupposes the descent of power"
      },
      "note": {
        "en": "The exegesis asks who is qualified for initiation and answers by taking up the descent of power, which places the descent before the rite and before the path. Later and other traditions have read the descent as the fruit of practice instead; the direction recorded here is the one Abhinavagupta sets."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:Diksa"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Saktipata"
      },
      "source": [
        "Abhinavagupta, Tantrasāra XI",
        "Abhinavagupta, Tantrāloka XIII"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "An experiential account given in the first person by the one who had it, recorded once."
      },
      "id": "pm:firstPersonReport",
      "label": {
        "de": "Erfahrungsbericht",
        "en": "First-person report"
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "The reading of weather and import from cloud formations."
      },
      "id": "pmc:KnowledgeOfClouds",
      "label": {
        "de": "Wolkenkunde",
        "en": "Knowledge of the clouds"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The reading of terrestrial import from the position of the heavenly bodies."
      },
      "id": "pmc:Astrology",
      "label": {
        "de": "Astrologie",
        "en": "Astrology"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "What the disagreement is about."
      },
      "domain": "pm:Disputing",
      "id": "pm:disputedClaim",
      "label": {
        "de": "strittiger Gegenstand",
        "en": "disputed claim"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The observation that the raising of the body hair is codified as a sign of an inner state in two Indian genres that have no common subject matter: a meditation handbook and a treatise on dramatic performance."
      },
      "id": "pmc:HorripilationCorrespondence",
      "label": {
        "de": "Die Entsprechung der Haaraufrichtung",
        "en": "The horripilation correspondence"
      },
      "note": {
        "en": "The strongest item in this file, and still not what it first appears. The independence is generic and not cultural: both texts belong to the Indian sphere, so a common background cannot be excluded. What can be excluded is that one borrowed the observation from the other, since neither is about the other's subject. A universal physiology codified twice is a finding about the physiology."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:convergingConcept": [
        {
          "id": "pmc:KhuddikaPiti"
        },
        {
          "id": "pmc:Romanca"
        }
      ],
      "pm:independentAttestation": [
        {
          "id": "pmt:SanskritDramaturgy"
        },
        {
          "id": "pmt:Theravada"
        }
      ],
      "pm:transmissionPath": "Both codifications arise within the Indian cultural sphere; independence holds at the level of genre and subject matter, not at the level of culture.",
      "source": [
        "Buddhaghosa, Visuddhimagga IV.94ff. (trans. Ñāṇamoli 1956)",
        "Nāṭyaśāstra VII"
      ],
      "type": "pm:Converging"
    },
    {
      "definition": {
        "en": "The performance of the eight limbs, taken together as one course of practice."
      },
      "id": "pmp:PracticeOfTheLimbs",
      "label": {
        "de": "Übung der Glieder",
        "en": "Practice of the limbs"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Patañjali, Yogasūtra II.28",
      "type": "pm:Practicing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "An ascent in thirty steps, running from renunciation and exile through the active virtues to stillness, prayer, freedom from the passions and love, and passing in its course from human labour to what is given."
      },
      "id": "pmc:LadderOfThirtySteps",
      "label": {
        "de": "Die Leiter der dreißig Stufen",
        "en": "The ladder of thirty steps"
      },
      "source": "John Climacus, The Ladder of Divine Ascent, steps 1-30",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "definition": {
        "en": "A structural correspondence observed across traditions, held as a node so that it can carry its routes of transmission and its counterexamples instead of asserting universality."
      },
      "id": "pm:Converging",
      "label": {
        "de": "Konvergieren",
        "en": "Converging"
      },
      "note": {
        "en": "Most apparent universality in the Western esoteric record is diffusion from few sources. A graph that counts a citation chain as independent confirmation measures reception history and reports it as structure."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "A figure named in the Book of Parables as the one who disclosed the striking of spirits, the killing of the embryo and the serpent's bite."
      },
      "id": "pmc:Kasdeja",
      "label": {
        "de": "Kasdeja",
        "en": "Kasdeja"
      },
      "source": "1 Enoch 69:12 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A centre of the subtle body, described in the source with its seed syllables and its position along the central channel."
      },
      "id": "pmc:Cakra",
      "label": {
        "de": "Cakra",
        "en": "Cakra"
      },
      "note": {
        "en": "The count varies across the older tantras, which give four, five or six. The tradition does not assign the centres the psychological qualities that modern presentations attach to them."
      },
      "source": "Pūrṇānanda, Ṣaṭcakranirūpaṇa (1577)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "The earlier step the later one is said to require."
      },
      "domain": "pm:Presupposing",
      "id": "pm:priorStep",
      "label": {
        "de": "vorausgesetzter Schritt",
        "en": "prior step"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "An ongoing attempt to fail a claim under a stated condition. A protocol that names no condition under which the claim would be refuted is not a test of it."
      },
      "id": "pm:Testing",
      "label": {
        "de": "Prüfen",
        "en": "Testing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "An epistemic mode in which a statement is asserted. Individual instances are defined in ontology/consciousness.ttl."
      },
      "id": "pm:AwarenessContext",
      "label": {
        "de": "Bewusstseinskontext",
        "en": "Awareness Context"
      },
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "A Watcher whose teaching concerns the stars; the two recensions differ on whether it is the constellations or the signs of the stars."
      },
      "id": "pmc:Kokabel",
      "label": {
        "de": "Kokabel",
        "en": "Kokabel"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Ordinary outward-turned awareness of gross objects."
      },
      "id": "pm:WakingState",
      "label": {
        "de": "Wachzustand (Jāgrat)",
        "en": "Waking state (Jāgrat)"
      },
      "source": "Māṇḍūkya Upaniṣad, verse 3",
      "type": "pm:AwarenessContext"
    },
    {
      "definition": {
        "en": "The root class of all ongoing acts modelled by prima-materia. Every substantive class in the ontology is a subclass of pm:Process."
      },
      "id": "pm:Process",
      "label": {
        "de": "Prozess",
        "en": "Process"
      },
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "A figure named in the Book of Parables as the one who disclosed the distinction of bitter and sweet and the art of writing."
      },
      "id": "pmc:Penemue",
      "label": {
        "de": "Penemue",
        "en": "Penemue"
      },
      "source": "1 Enoch 69:8 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "What is said to arise, on the wearing away of impurity, and to continue up to discriminative discernment."
      },
      "id": "pmc:LightOfKnowledge",
      "label": {
        "de": "Das Leuchten der Erkenntnis",
        "en": "The light of knowledge"
      },
      "source": "Patañjali, Yogasūtra II.28",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "An operative procedure enacted within a tradition."
      },
      "id": "pm:Practicing",
      "label": {
        "de": "Praktizieren",
        "en": "Practicing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The final object of the ascent, seen only by one who has climbed by way of the intervening rungs."
      },
      "id": "pmc:BeautyItself",
      "label": {
        "de": "Die Schönheit selbst",
        "en": "Beauty itself"
      },
      "source": "Plato, Symposium 211c-212a",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Platonic"
    },
    {
      "definition": {
        "en": "The transmission of the Upaniṣads as the speculative layer of the Vedic corpus."
      },
      "id": "pmt:Upanisadic",
      "label": {
        "de": "Upaniṣadische Überlieferung",
        "en": "Upaniṣadic tradition"
      },
      "source": "Chāndogya Upaniṣad",
      "type": "pm:Tradition"
    }
  ]
}