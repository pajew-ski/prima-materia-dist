      },
      "pm:principalCorpus": "Castaneda, The Teachings of Don Juan; Castaneda, The Art of Dreaming",
      "type": "pm:Tradition"
    },
    {
      "id": "pmc:ParakayaPravesaIsDisplaced",
      "label": {
        "de": "Der Eintritt in einen anderen Körper ist ein verlagerter Ort",
        "en": "Entering another body is a displaced locus"
      },
      "pm:attestedBy": {
