      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "First-person exclusive awareness shared between two subjects (I and you)."
      },
      "id": "pm:dyadicAwareness",
      "label": {
        "de": "Dyadisches Bewusstsein",
        "en": "Dyadic awareness"
      },
      "type": "pm:AwarenessSpace"
    },
    {
      "definition": {
        "en": "Ordinary outward-turned awareness of gross objects."
      },
      "id": "pm:WakingState",
      "label": {
        "de": "Wachzustand (Jāgrat)",
        "en": "Waking state (Jāgrat)"
      },
      "source": "Māṇḍūkya Upaniṣad, verse 3",
      "type": "pm:AwarenessContext"
    },
    {
      "id": "pmc:ZiqelTeachesSignsOfShootingStars",
      "label": {
        "de": "Ziqel offenbart die Zeichen der Sternschnuppen",
        "en": "Ziqel discloses the signs of the shooting stars"
      },
      "note": {
        "en": "Stands in the position the Ethiopic fills with Ezeqeel and the knowledge of the clouds."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfShootingStars"
      },
      "pm:ascribedTo": {
        "id": "pmc:Ziqel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Inward-turned awareness of subtle objects generated by the mind."
      },
      "id": "pm:DreamingState",
      "label": {
        "de": "Traumzustand (Svapna)",
        "en": "Dreaming state (Svapna)"
      },
      "source": "Māṇḍūkya Upaniṣad, verse 4",
      "type": "pm:AwarenessContext"
    },
    {
      "id": "pmc:SamyamaYieldsDivyaSrotra",
      "label": {
        "de": "Saṃyama bringt das göttliche Ohr hervor",
        "en": "Saṃyama yields the divine ear"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:Samyama"
      },
