      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:ThreefoldAscentOrder",
      "label": {
        "de": "Naturschau setzt asketische Praxis voraus",
        "en": "Contemplation of nature presupposes ascetic practice"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
