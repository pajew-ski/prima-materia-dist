      },
      "pm:situationGround": {
        "@language": "en",
        "@value": "The sūtra has the seat of awareness transferred into a body other than the practitioner's own. The awareness is thereby located away from the body it started in, which is the criterion this value names."
      },
      "source": "Patañjali, Yogasūtra III.38 (Sanskrit sūtra text; received four-pāda numbering)",
      "type": "pm:Situating"
    },
    {
