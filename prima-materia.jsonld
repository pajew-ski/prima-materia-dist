      ],
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The Byzantine tradition of the prayer of the heart and of the vision of the uncreated light, defended in the fourteenth century against the objection that such a light must be created."
      },
      "id": "pmt:Hesychasm",
      "label": {
        "de": "Hesychasmus",
        "en": "Hesychasm"
      },
      "source": "Gregory Palamas, Triads in Defence of the Holy Hesychasts",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The claim stands in a received work, at a passage that can be cited and read independently of this graph."
      },
      "id": "pm:textualAttestation",
      "label": {
        "de": "Textzeugnis",
        "en": "Textual attestation"
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "Knowledge of the fixed groupings of stars."
      },
      "id": "pmc:Constellations",
