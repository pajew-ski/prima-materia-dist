      "type": "pm:AwarenessContext"
    },
    {
      "definition": {
        "en": "A subtle vehicle carried by the soul, whose purity is held to decide whether what appears in a dream is clear and true or clouded."
      },
      "id": "pmc:PneumaticVehicle",
      "label": {
        "de": "Das pneumatische Seelenfahrzeug",
        "en": "The pneumatic vehicle of the soul"
      },
      "source": "Synesius of Cyrene, De insomniis",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:NeoplatonicTheurgy"
    },
    {
      "definition": {
        "en": "The formation of a concept as an act within awareness; instances of this class are concept nodes such as pmc:Pleroma or pmc:Hen."
      },
      "id": "pm:Conceptualizing",
      "label": {
        "de": "Begriffsbildung",
        "en": "Conceptualizing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The power is imagined rising in the form of lightning, at each centre in turn and step by step, upward as far as three fists, and at the end of that ascent stands the great awakening."
      },
      "id": "pmc:AscentThroughEachCentre",
      "label": {
        "de": "Der Aufstieg, der in einer Bewegung jedes Zentrum durchläuft",
        "en": "The ascent that passes through every centre in one movement"
      },
      "note": {
        "en": "The two phrases that carry this are praticakram, at each centre, and kramāt kramam, step by step. Recorded because it settles two questions at once. It gives a body measure in the base text, three fists for the upward reach, where a modern draft gives an arm's length; and it makes the passage through several centres a single exercise, where the same draft allows one centre per session and calls a change of centre a break. See prima-materia#38 and prima-materia#40."
      },
      "source": [
        "Vijñānabhairava 28 (Sanskrit; verse numbering of Dyczkowski and the current editions)",
        "Vijñānabhairava 29 (Sanskrit; verse numbering of Dyczkowski and the current editions)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "id": "pmc:AscentPresupposesTheRungs",
      "label": {
        "de": "Die Schau der Schönheit selbst setzt den Aufstieg über die Stufen voraus",
        "en": "The vision of beauty itself presupposes the ascent by rungs"
      },
      "note": {
        "en": "The word rendered as rungs stands in the base text at 211c, which is why this counts as a stated ordering and not as a modern reading of a sequence of paragraphs."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:consequenceOfSkipping": "The ascent is described as rightly conducted only when it proceeds as by rungs of a ladder, from one body to two, from bodies to pursuits, from pursuits to studies, and thence to beauty itself; the one who does not go this way does not arrive at the final vision.",
      "pm:dependentStep": {
        "id": "pmc:BeautyItself"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:statedNecessity"
      },
      "pm:priorStep": {
        "id": "pmc:BeautyOfOneBody"
      },
      "source": "Plato, Symposium 211c",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Platonic"
    },
    {
      "definition": {
        "en": "A numbered course of mastery over the meditation objects, among them the order of the kasiṇa and its reverse, skipping the absorption, skipping the object, and the definition of the object."
      },
      "id": "pmp:FourteenfoldMastery",
      "label": {
        "de": "Beherrschung des Geistes in vierzehn Weisen",
        "en": "Control of the mind in fourteen ways"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Buddhaghosa, Visuddhimagga XII.2 (trans. Ñāṇamoli 1956)",
      "type": "pm:Practicing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:StationsPresupposeTheOneBelow",
      "label": {
        "de": "Eine Station setzt die darunterliegende voraus",
        "en": "A station presupposes the station below it"
      },
      "note": {
        "en": "The handbooks set turning back as the first station and hold that the one below must be kept before the one above is reached. The enumeration and the count of the stations differ between the handbooks; the precedence of turning back does not."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:Maqamat"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Tawba"
      },
      "source": [
        "al-Qushayrī, al-Risāla al-Qushayriyya, chapter on the stations",
        "al-Sarrāj, Kitāb al-Lumaʿ"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Sufism"
    },
    {
      "definition": {
        "en": "Called the offspring of apatheia and the keeper of the door to the contemplation of created things."
      },
      "id": "pmc:Agape",
      "label": {
        "de": "Liebe",
        "en": "Love"
      },
      "source": [
        "Evagrius Ponticus, Praktikos 81",
        "Evagrius Ponticus, Praktikos 84"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "definition": {
        "en": "The transmission of the Śaiva and Śākta tantric corpus and its Kashmirian exegesis."
      },
      "id": "pmt:SaivaSakta",
      "label": {
        "de": "Śaiva- und Śākta-Tantra",
        "en": "Śaiva and Śākta tantra"
      },
      "note": {
        "en": [
          "A caution governs everything read out of this tradition. What is old is a set of subtle centres carrying seed syllables, and the older tantras vary in how many they count. The fixed system of seven centres with spectral colours and assigned psychological qualities belongs to the twentieth century and to no tantra; it is held in this file as pmc:SevenCentreQualityMapping so that it is available as what it is, and it must not be read back into the material it was built on.",
          "Edition finding, prima-materia#45. The Vijñānabhairava citations name the numbering they were read in. For the Ṣaṭcakranirūpaṇa, the Tantrāloka, the Tantrasāra and the Mālinīvijayottaratantra the edition is not recoverable and is left unstated rather than guessed; those passages are to be reopened, and the chapter divisions of the Kashmirian exegesis are edition-dependent."
        ]
      },
      "source": "Pūrṇānanda, Ṣaṭcakranirūpaṇa (1577)",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The wind whose course is downward is said to be made to go upward by force; the manual states the natural course and the reversal in the same verse."
      },
      "id": "pmc:ApanaForcedAgainstItsCourse",
      "label": {
        "de": "Der abwärts gerichtete Wind wird mit Gewalt aufwärts getrieben",
        "en": "The downward wind driven upward by force"
      },
      "note": {
        "en": "This is the direct reversal of any scheme that assigns downward carriage to an operation in the lower abdomen. The manual has the abdominal operation carry upward, and has the operation at the throat press the other wind down. Both assignments are the opposite of the one the modern draft makes. See prima-materia#28."
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā III.62 (Sanskrit vulgate; Sinh 1915)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "A retention in which the breath is drawn in through the mouth with the tongue between the lips, producing a hissing sound, and is not let out the same way."
      },
      "id": "pmp:Sitkari",
      "label": {
        "de": "Sītkārī",
        "en": "Sītkārī"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā II.54-56 (Sanskrit vulgate; Sinh 1915)",
      "type": "pm:Practicing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "id": "pmc:KokabelTeachesConstellations",
      "label": {
        "de": "Kokabel offenbart die Sternbilder",
        "en": "Kokabel discloses the constellations"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:Constellations"
      },
      "pm:ascribedTo": {
        "id": "pmc:Kokabel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The continuous inward prayer that gives the tradition its practice."
      },
      "id": "pmc:PrayerOfTheHeart",
      "label": {
        "de": "Das Herzensgebet",
        "en": "The prayer of the heart"
      },
      "source": [
        "Philokalia IV, Gregory of Sinai, On Stillness and the Two Ways of Prayer",
        "Philokalia IV, Nikephoros the Monk, On Watchfulness and the Guarding of the Heart"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hesychasm"
    },
    {
      "definition": {
        "en": "The claim stands in a received work at a passage that can be named, but the passage was read in a second work that quotes or reports it, because the first could not be obtained."
      },
      "id": "pm:mediatedAttestation",
      "label": {
        "de": "Vermitteltes Zeugnis",
        "en": "Mediated attestation"
      },
      "note": {
        "en": [
          "Admissible only where the work itself is out of reach — not digitised, out of print, held internally, in a language not commanded. Effort is not a reason: the mode exists so that unreachable material can enter at its true strength, not so that reachable material can enter cheaply. See SPEC §10 and SPEC §15.",
          "Every claim carrying this mode must name the intermediary with pm:readVia, enforced by pm:MediatedAttestationShape. dcterms:source keeps naming the work that carries the claim, because that is what a later reader must obtain; pm:readVia names what the writer of the node actually had in front of him. Collapsing the two would hide exactly the fact this mode exists to record.",
          "Weaker than pm:textualAttestation and stronger than nothing, and the record has to be able to say which of the two it has. A claim read through an intermediary carries that intermediary's selection, its translation and its silence; a reader who cannot see that the passage came second-hand cannot weigh any of it."
        ]
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "Perception of what is distant, hidden or obstructed."
      },
      "id": "pmc:DivyaCaksus",
      "label": {
        "de": "Göttliches Auge",
        "en": "Divine eye"
      },
      "source": "Patañjali, Yogasūtra III.26",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "The art of fixing speech in ink on paper, treated in the text as a transgression rather than a gift."
      },
      "id": "pmc:WritingWithInk",
      "label": {
        "de": "Schreiben mit Tinte",
        "en": "Writing with ink"
      },
      "source": "1 Enoch 69:9 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "First-person inclusive awareness bounded to an identified group."
      },
      "id": "pm:collectiveAwareness",
      "label": {
        "de": "Kollektives Bewusstsein",
        "en": "Collective awareness"
      },
      "type": "pm:AwarenessSpace"
    },
    {
      "definition": {
        "en": "The reading of import from the stars, given in place of the constellations in the Aramaic-Greek witness."
      },
      "id": "pmc:SignsOfTheStars",
      "label": {
        "de": "Zeichen der Sterne",
        "en": "Signs of the stars"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The seat, treated in the first chapter as the first limb of the practice."
      },
      "id": "pmc:Asana",
      "label": {
        "de": "Sitzhaltung",
        "en": "Posture"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā I (Sanskrit vulgate; Sinh 1915)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The discourse distinguishes three marvels, of psychic power, of mind-reading and of instruction, and holds only instruction to be reliable; the display of power for the sake of persuasion is refused as something to be ashamed of."
      },
      "id": "pmc:DisplayOfPowersRefused",
      "label": {
        "de": "Zurschaustellung der Kräfte verweigert",
        "en": "Display of powers refused"
      },
      "note": {
        "en": "The Vinaya rule against displaying superhuman states to laypeople stands alongside it."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:cautionsAbout": [
        {
          "id": "pmc:Cetopariyanana"
        },
        {
          "id": "pmc:Dibbacakkhu"
        },
        {
          "id": "pmc:Dibbasota"
        },
        {
          "id": "pmc:Manomayakaya"
        }
      ],
      "source": [
        "Dīgha Nikāya 11 (Kevaṭṭa Sutta)",
        "Vinaya, Cūḷavagga V.8"
      ],
      "type": "pm:Cautioning",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "Conditions that descend on the wayfarer as a gift and pass, distinguished in the handbooks from the stations precisely by not being attainable through effort."
      },
      "id": "pmc:Ahwal",
      "label": {
        "de": "Zustände",
        "en": "States"
      },
      "note": {
        "en": "No prerequisite claim is entered for these. The tradition holds that they cannot be worked for, which is a claim about the limits of any ordering and not an omission in this record."
      },
      "source": [
        "al-Qushayrī, al-Risāla al-Qushayriyya",
        "al-Sarrāj, Kitāb al-Lumaʿ"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Sufism"
    },
    {
      "definition": {
        "en": "The work in which the passage was actually read, given as a bibliographic reference, where that work is not the one carrying the claim."
      },
      "id": "pm:readVia",
      "label": {
        "de": "gelesen über",
        "en": "read via"
      },
      "note": {
        "en": [
          "Deliberately separate from dcterms:source, for the same reason pm:evidenceFrom is. dcterms:source names what a reader must obtain to check the claim; this names what the writer of the node had in front of him. A record that fused them would report second-hand reading as first-hand and would lose the one distinction that makes an unreachable source admissible at all.",
          "Required wherever pm:attestedBy is pm:mediatedAttestation. Carries a bibliographic reference and never a URL, enforced by pm:ReadViaIsLiteratureShape."
        ]
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "id": "pmc:AzazelTeachesAdornment",
      "label": {
        "de": "Azazel offenbart Schmuck und Kosmetik",
        "en": "Azazel discloses adornment and cosmetics"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:AdornmentAndCosmetics"
      },
      "pm:ascribedTo": {
        "id": "pmc:Azazel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:1 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Two marks set on the practice: one is not to hear the sound of one's own breathing, and a feather held before nose and mouth is not to stir; and one is always to give out less than one has taken in."
      },
      "id": "pmc:InaudibleAndUnevenBreath",
      "label": {
        "de": "Der für den Übenden selbst unhörbare Atem, kürzer aus als ein",
        "en": "The breath inaudible to its own bearer and shorter out than in"
      },
      "note": {
        "en": "The intake is at the nose and the release at the mouth. The distribution is the reverse of the one a modern draft assigns, which treats mouth breathing as a fault on the intake and says nothing of the release. The passage also fixes the pace by an external test rather than by a count of seconds, which is what makes it examinable at all. See prima-materia#26."
      },
      "source": "Ge Hong, Baopuzi neipian 8",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "definition": {
        "en": "The leader of the Watchers who binds the others by oath on Mount Hermon and is named as the teacher of spells and root-cutting."
      },
      "id": "pmc:Shemihazah",
      "label": {
        "de": "Schemichasa",
        "en": "Shemihazah"
      },
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Amezarak"
        },
        {
          "@language": "en",
          "@value": "Semjaza"
        }
      ],
      "source": "1 Enoch 6:3, 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The disclosure of the distinction of bitter from sweet, given in the text alongside the secrets of wisdom."
      },
      "id": "pmc:DiscernmentOfBitterAndSweet",
      "label": {
        "de": "Unterscheidung von bitter und süß",
        "en": "Discernment of bitter and sweet"
      },
      "source": "1 Enoch 69:8 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The claim this protocol attempts to fail."
      },
      "domain": "pm:Testing",
      "id": "pm:tests",
      "label": {
        "de": "prüft",
        "en": "tests"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "A negative finding, held as a node so that it is not lost: the old traditions test a claimed movement by its origin and its fruits, and none of those examined here tests a claimed capacity by counting hits against the rate obtainable by guessing."
      },
      "id": "pmc:NoQuantitativeVerification",
      "label": {
        "de": "Keine Zählung gegen den Zufall in den alten Quellen",
        "en": "No count against chance in the old sources"
      },
      "note": {
        "en": "Any protocol that counts outcomes against a base rate is a modern addition and is to be recorded as one, not as the recovery of an ancient method."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:cautionsAbout": {
        "id": "pmc:TestingOfThoughts"
      },
      "source": [
        "Ignatius of Loyola, Spiritual Exercises 313-336",
        "John Cassian, Collationes I.20-22"
      ],
      "type": "pm:Cautioning"
    },
    {
      "definition": {
        "en": "The breath practice of the second chapter, directed at the clearing of the central channel."
      },
      "id": "pmp:HathaPranayama",
      "label": {
        "de": "Atemregulierung im Haṭhayoga",
        "en": "Breath regulation in Haṭhayoga"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā II (Sanskrit vulgate; Sinh 1915)",
      "type": "pm:Practicing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The least of the five degrees of rapture, described as able to raise the hairs of the body."
      },
      "id": "pmc:KhuddikaPiti",
      "label": {
        "de": "Geringe Verzückung",
        "en": "Minor rapture"
      },
      "note": {
        "en": "This is the passage that attests piloerection as a recognised concomitant of a meditative state, not as its object."
      },
      "source": "Buddhaghosa, Visuddhimagga IV.94ff. (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "What a path says becomes of the bounded self at its end: whether the self is to be dissolved into what exceeds it, strengthened and preserved as its own absolute, or whether the path declines the question. An instance of this class is a value on that axis and never a path."
      },
      "id": "pm:TelicOrientation",
      "label": {
        "de": "Ausrichtung des Zieles",
        "en": "Telic Orientation"
      },
      "note": {
        "en": [
          "The values name what a source claims, not what happens. Nothing on this axis is examined by holding it; where somebody takes up the examination, that is a pm:Testing node pointing at the claim, and the examination states of the two values are not symmetric.",
          "This is the axis the Western terms were built to carry, and the axis they carry badly, because they carry the other one at the same time. A record that wants to state where a path claims to end has to be able to state that without also stating how it proceeds. See prima-materia#52."
        ]
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The claim, made within a tradition, that one step of a path presupposes another: that a practice, state or capacity is not reached except by way of something else."
      },
      "id": "pm:Presupposing",
      "label": {
        "de": "Voraussetzen",
        "en": "Presupposing"
      },
      "note": {
        "en": "A node and not an edge, for the same reason as pm:Attributing and pm:Yielding. A prerequisite claim differs enormously in what carries it, and the difference is not visible on an edge. It matters whether a text sets an order or a reader inferred one from the order of the chapters."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "A seat defined by sitting evenly with the body straight; the straightness is part of what the posture is, not a separate instruction."
      },
      "id": "pmc:ErectTrunkInSwastikasana",
      "label": {
        "de": "Der gerade Rumpf als Merkmal einer Sitzhaltung",
        "en": "The straight trunk as the mark of a seat"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā I.21 (Sanskrit vulgate; Sinh 1915)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The named compiler who performed the ordering act. Without it, an order made in the present is indistinguishable from an order found in the source."
      },
      "domain": "pm:Systematizing",
      "id": "pm:compiledBy",
      "label": {
        "de": "geordnet von",
        "en": "compiled by"
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "What the disagreement is about."
      },
      "domain": "pm:Disputing",
      "id": "pm:disputedClaim",
      "label": {
        "de": "strittiger Gegenstand",
        "en": "disputed claim"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The initiatory act by which the descent of power is conferred."
      },
      "id": "pmp:SaktipataTransmission",
      "label": {
        "de": "Übertragung der Herabkunft der Kraft",
        "en": "Conferring the descent of power"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "Abhinavagupta, Tantrasāra XI",
        "Abhinavagupta, Tantrāloka XIII"
      ],
      "type": "pm:Practicing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "The deliberate use of dreams as a source of knowledge, treated in this literature as available to anyone and requiring no instrument beyond the sleeper."
      },
      "id": "pmp:DreamDivination",
      "label": {
        "de": "Traumdivination",
        "en": "Dream divination"
      },
      "note": {
        "en": "The absence of an instrument and of an office is the point at which this tradition differs from the incubation cult: no temple, no priest, no fee."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Synesius of Cyrene, De insomniis",
      "type": "pm:Practicing",
      "withinTradition": "pmt:NeoplatonicTheurgy"
    },
    {
      "id": "pmc:SarielTeachesCourseOfTheMoon",
      "label": {
        "de": "Sariel offenbart den Lauf des Mondes",
        "en": "Sariel discloses the course of the moon"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:CourseOfTheMoon"
      },
      "pm:ascribedTo": {
        "id": "pmc:Sariel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The transmission of the Islamic mystical path, systematised in the handbooks of the tenth and eleventh centuries."
      },
      "id": "pmt:Sufism",
      "label": {
        "de": "Sufismus",
        "en": "Sufism"
      },
      "note": {
        "en": "Edition finding, prima-materia#45. For both works the edition or translation the passages were read from is not recoverable, and it is left unstated rather than guessed. Neither citation carries a page or section number, and the printed editions of the Kitāb al-Lumaʿ and the Risāla divide their material differently, so the passages are to be reopened before anything in this file is cited by place."
      },
      "source": "al-Qushayrī, al-Risāla al-Qushayriyya",
      "type": "pm:Tradition"
    },
    {
      "id": "pmc:AraqielTeachesSignsOfTheEarth",
      "label": {
        "de": "Araqiel offenbart die Zeichen der Erde",
        "en": "Araqiel discloses the signs of the earth"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfTheEarth"
      },
      "pm:ascribedTo": {
        "id": "pmc:Araqiel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Inward-turned awareness of subtle objects generated by the mind."
      },
      "id": "pm:DreamingState",
      "label": {
        "de": "Traumzustand (Svapna)",
        "en": "Dreaming state (Svapna)"
      },
      "source": "Māṇḍūkya Upaniṣad, verse 4",
      "type": "pm:AwarenessContext"
    },
    {
      "definition": {
        "en": "The later step: the practice, state or capacity said not to be reached without the prior one."
      },
      "domain": "pm:Presupposing",
      "id": "pm:dependentStep",
      "label": {
        "de": "abhängiger Schritt",
        "en": "dependent step"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "Hearing beyond the range of the physical ear."
      },
      "id": "pmc:Dibbasota",
      "label": {
        "de": "Göttliches Ohr",
        "en": "Divine ear"
      },
      "source": "Buddhaghosa, Visuddhimagga XIII (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "An epistemic mode in which a statement is asserted. Individual instances are defined in ontology/consciousness.ttl."
      },
      "id": "pm:AwarenessContext",
      "label": {
        "de": "Bewusstseinskontext",
        "en": "Awareness Context"
      },
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The root class of all ongoing acts modelled by prima-materia. Every substantive class in the ontology is a subclass of pm:Process."
      },
      "id": "pm:Process",
      "label": {
        "de": "Prozess",
        "en": "Process"
      },
      "type": "owl:Class"
    },
    {
      "id": "pmc:DreamDivinationPresupposesPurityOfTheVehicle",
      "label": {
        "de": "Traumdivination setzt die Reinheit des Fahrzeugs voraus",
        "en": "Dream divination presupposes purity of the vehicle"
      },
      "note": {
        "en": "The condition is on the state of the seer, not on a technique of sleeping. Recorded as order rather than necessity because the treatise makes the clarity of the dream depend on the vehicle without stating at that place what befalls one who proceeds with an unpurified one. Chapter divisions vary between editions; the work and its subject are given so that the passage can be found in whichever edition is at hand."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmp:DreamDivination"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:PneumaticVehicle"
      },
      "source": "Synesius of Cyrene, De insomniis",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:NeoplatonicTheurgy"
    },
    {
      "id": "pmc:SamyamaYieldsParakayaPravesa",
      "label": {
        "de": "Saṃyama bringt den Eintritt in einen anderen Körper hervor",
        "en": "Saṃyama yields entry into another body"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:Samyama"
      },
      "pm:yieldsCapacity": {
        "id": "pmc:ParakayaPravesa"
      },
      "source": "Patañjali, Yogasūtra III.38 (Sanskrit sūtra text; received four-pāda numbering)",
      "type": "pm:Yielding",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "The rite by which a person is admitted to the practice, set out in the tantra and reproduced with commentary in the Kashmirian exegesis."
      },
      "id": "pmc:Diksa",
      "label": {
        "de": "Initiation",
        "en": "Initiation"
      },
      "source": [
        "Abhinavagupta, Tantrāloka XV",
        "Mālinīvijayottaratantra VIII"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "The third of the three parts, the knowledge of God."
      },
      "id": "pmc:Theologike",
      "label": {
        "de": "Theologikē",
        "en": "Knowledge of God"
      },
      "source": "Evagrius Ponticus, Praktikos 1",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "dcterms:date": "1916",
      "definition": {
        "en": "The claim that a creature which ceases to distinguish falls into the undifferentiated fullness, ceases to be a creature and is given over to dissolution in nothingness, so that its natural striving runs towards distinctiveness against a primeval and perilous sameness; and that the striving is nevertheless not after difference but after the creature's own being."
      },
      "id": "pmc:DistinctivenessAgainstDissolution",
      "label": {
        "de": "Die Unterschiedenheit als Streben des Geschöpfs gegen die Auflösung",
        "en": "Distinctiveness as the striving of the creature against dissolution"
      },
      "note": {
        "en": [
          "Recorded because it is the only position located so far that names both ends of the axis as a loss and then states a third movement. Dissolution into the fullness is called the death of the creature outright, which rules out the unitive end; and the striving is expressly not after difference as it is thought, which rules out the separative one. What remains is a striving after one's own being, and the source gives it the name principium individuationis.",
          "The attribution is why this is an origination and not a witness of gnostic transmission. The author printed the text under the name of a second-century teacher of Alexandria who did not write it, and it continues to be read and cited as gnostic teaching. pm:circulatesAs records that, and the node makes no judgement about the author's own reading of the ancient material.",
          "The god named above the god of the pairs of opposites belongs to the same argument and not to a separate doctrine: the qualities of the fullness are given as pairs, and what is set above them unites the full and the empty. A reading that takes this for a third party in a pantheon takes the figure for the argument."
        ]
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:circulatesAs": "A gnostic text of the second century, printed under the name of Basilides of Alexandria and read as ancient teaching rather than as a work written in 1916.",
      "pm:originatedBy": "C. G. Jung",
      "source": "C. G. Jung, Septem Sermones ad Mortuos, Sermo I (English translation of the 1916 private printing, Gnostic Society Library electronic edition)",
      "type": "pm:Originating"
    },
    {
      "definition": {
        "en": "The rate against which observed outcomes are compared, with the population it was taken from."
      },
      "domain": "pm:Testing",
      "id": "pm:baseRate",
      "label": {
        "de": "Basisrate",
        "en": "base rate"
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "id": "pmc:IddhiPresupposesFourteenfoldMastery",
      "label": {
        "de": "Übernatürliche Kraft setzt die vierzehnfache Beherrschung voraus",
        "en": "Supernormal power presupposes the fourteenfold mastery"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:consequenceOfSkipping": "The handbook states that it is not possible for a meditator even to begin to accomplish transformation by supernormal power without having first completed the development of control of the mind in those fourteen ways.",
      "pm:dependentStep": {
        "id": "pmc:Iddhividha"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:statedNecessity"
      },
      "pm:priorStep": {
        "id": "pmp:FourteenfoldMastery"
      },
      "source": "Buddhaghosa, Visuddhimagga XII.8 (trans. Ñāṇamoli 1956)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:SamyamaYieldsDivyaSrotra",
      "label": {
        "de": "Saṃyama bringt das göttliche Ohr hervor",
        "en": "Saṃyama yields the divine ear"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:Samyama"
      },
      "pm:yieldsCapacity": {
        "id": "pmc:DivyaSrotra"
      },
      "source": "Patañjali, Yogasūtra III.41",
      "type": "pm:Yielding",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "The transfer of power from one who has it to one who does not, graded in the Kashmirian exegesis into nine degrees."
      },
      "id": "pmc:Saktipata",
      "label": {
        "de": "Herabkunft der Kraft",
        "en": "Descent of power"
      },
      "note": {
        "en": "The sources give transfer by glance, by touch and by word. The specifically manual modality of the modern draft is not attested here."
      },
      "source": [
        "Abhinavagupta, Tantrasāra XI",
        "Abhinavagupta, Tantrāloka XIII",
        "Mālinīvijayottaratantra"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "The first of the two stages of the highest tantra, treated before the completion stage in the training."
      },
      "id": "pmc:GenerationStage",
      "label": {
        "de": "Erzeugungsstufe",
        "en": "Generation stage"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "The combined application of dhāraṇā, dhyāna and samādhi to a single object, presented as the general operator from which the capacities of the third chapter follow."
      },
      "id": "pmp:Samyama",
      "label": {
        "de": "Saṃyama",
        "en": "Saṃyama"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Patañjali, Yogasūtra III.1-3",
      "type": "pm:Practicing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "A claim that this ordering act groups. The claims keep their own attestation; only the grouping belongs to the compiler."
      },
      "domain": "pm:Systematizing",
      "id": "pm:ordersClaim",
      "label": {
        "de": "ordnet Behauptung",
        "en": "orders claim"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The earlier step the later one is said to require."
      },
      "domain": "pm:Presupposing",
      "id": "pm:priorStep",
      "label": {
        "de": "vorausgesetzter Schritt",
        "en": "prior step"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "id": "pmc:DescentPresupposesDepth",
      "label": {
        "de": "Der Abstieg setzt die Tiefe voraus, die den Atem sammelt",
        "en": "The descent presupposes the depth that gathers the breath"
      },
      "note": {
        "en": "Recorded at stated necessity because a consequence is quotable, which is unusual: most sequences in this collection state an order and leave the consequence unsaid. The strength rests on the closing line, not on the chain of conditionals, which on its own would carry only a prescribed order."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:consequenceOfSkipping": "The inscription closes by setting the two outcomes against each other: to go with the sequence is to live, to go against it is to die. The consequence is stated for the order as a whole, and every stage is joined to the one before it by the same conditional form.",
      "pm:dependentStep": {
        "id": "pmc:XingqiDescent"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:statedNecessity"
      },
      "pm:priorStep": {
        "id": "pmc:XingqiDepth"
      },
      "source": "Xingqi yupei ming, in D. Harper, Early Chinese Medical Literature (1998), p. 125",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "definition": {
        "en": "The channels of the subtle body through which the winds are held to move; Tsongkhapa's presentation counts one hundred and twenty principal ones."
      },
      "id": "pmc:Rtsa",
      "label": {
        "de": "Kanäle",
        "en": "Channels"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "Places a tradition, a practice or a claim on the axis of the end state. Asserting it is a claim about a source and carries the same burden as any other."
      },
      "id": "pm:telicOrientation",
      "label": {
        "de": "Ausrichtung des Zieles",
        "en": "telic orientation"
      },
      "note": {
        "en": "Where a source claims one end state for a stage and another for the whole, both are stated on their own nodes rather than averaged. An averaged orientation reports a path no source teaches, in the same way an averaged reading reports a text no witness gives."
      },
      "range": "pm:TelicOrientation",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "A retention counted in heartbeats: the breath is drawn in through the nose and held, then released in the smallest quantities through the mouth, the count being raised only by degrees."
      },
      "id": "pmp:Biqi",
      "label": {
        "de": "Das Verschließen des Atems",
        "en": "Closing off the breath"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Ge Hong, Baopuzi neipian 8",
      "type": "pm:Practicing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "definition": {
        "en": "The claim, made within a tradition, that a named practice produces a named capacity."
      },
      "id": "pm:Yielding",
      "label": {
        "de": "Hervorbringen",
        "en": "Yielding"
      },
      "note": {
        "en": "Held as a node and not as an edge for the same reason pm:Attributing is: only a node can carry its own source, its own mode of attestation, and a protocol that tries to fail it. A bare edge would make every such claim look alike, whatever it rests on, and would leave nothing for pm:Testing to point at. The question of which capacities a practice actually develops is answerable only where the pairing itself is addressable."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "A warning that the breath is to be mastered by degrees as a lion, an elephant or a tiger is mastered, and that it destroys the one who proceeds otherwise; performed wrongly, the practice is said to generate the very ailments it removes when performed rightly."
      },
      "id": "pmc:ForcedBreathCaution",
      "label": {
        "de": "Ein erzwungener statt allmählich gezähmter Atem tötet den Übenden",
        "en": "Breath forced rather than tamed by degrees kills the practitioner"
      },
      "note": {
        "en": "The named consequences are hiccough, laboured breathing, cough, and pain in head, ears and eyes. This is the strongest thing the manual says about the manner of breathing, and it concerns pace and force, not the opening the breath passes through. See prima-materia#26."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:cautionsAbout": {
        "id": "pmp:HathaPranayama"
      },
      "source": [
        "Svātmārāma, Haṭhayogapradīpikā II.15 (Sanskrit vulgate; Sinh 1915)",
        "Svātmārāma, Haṭhayogapradīpikā II.16-17 (Sanskrit vulgate; Sinh 1915)"
      ],
      "type": "pm:Cautioning",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The act of first putting forward a claim that no transmission carries, in a work that can be named and dated, where the claim afterwards circulates as though it were old."
      },
      "id": "pm:Originating",
      "label": {
        "de": "Urheben",
        "en": "Originating"
      },
      "note": {
        "en": [
          "Distinct from pm:Systematizing, which arranges material that was already there and names what it arranges. An origination arranges nothing: the claim begins with it. Holding the two apart is what keeps the record from reporting an invention as an ordering of something ancient, which is the commonest way a modern construction acquires a warrant.",
          "The circulating ascription is the point of the class, not an addendum to it. A node that names only the author and the work is a bibliography; a node that also names what the claim is taken for is the finding, and it is the kind of finding this project exists to make."
        ]
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The source only presents the material in a sequence. Any necessity is the reader's, and belongs to whoever read it that way."
      },
      "id": "pm:presentationOrder",
      "label": {
        "de": "Darstellungsreihenfolge",
        "en": "Presentation order"
      },
      "type": "pm:PrerequisiteStrength"
    },
    {
      "definition": {
        "en": "The act by which a claim entered the record. Instances of this class are modes of entry, not claims; a claim points at one of them through pm:attestedBy."
      },
      "id": "pm:Attesting",
      "label": {
        "de": "Bezeugen",
        "en": "Attesting"
      },
      "note": {
        "en": "Orthogonal to pm:AwarenessContext, which describes the state the asserter was in rather than the route by which the assertion reached the record."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The ascription under which the claim is commonly reported: the tradition, the age or the authority it is credited to and does not have."
      },
      "domain": "pm:Originating",
      "id": "pm:circulatesAs",
      "label": {
        "de": "zirkuliert als",
        "en": "circulates as"
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "The source holds that the question is malformed for its path: there is no bounded self that could either be dissolved or preserved, so neither end state is what it aims at."
      },
      "id": "pm:selfBoundaryDeclined",
      "label": {
        "de": "Abgelehnte Selbstgrenze",
        "en": "Self boundary declined"
      },
      "note": {
        "en": "As with pm:normDistinctionDeclined, this is a positive claim about a source and not a place to put an undetermined case."
      },
      "type": "pm:TelicOrientation"
    },
    {
      "definition": {
        "en": "A division of practitioners into three kinds, the bound, the heroic and the divine, which governs the rites a person is competent for. The source describes the divine as all but a god, pure of heart, alike towards opposites and unattached, and the bound as one who must gather his own offerings and who may neither look at a Śūdra nor think of a woman."
      },
      "id": "pmc:BhavaClassification",
      "label": {
        "de": "Die drei Dispositionen: paśu, vīra, divya",
        "en": "The three dispositions: paśu, vīra, divya"
      },
      "note": {
        "en": "This is the tradition's own answer to the question why one person takes one way and another another: not by choosing, but by what he is held competent for. The text presses the point polemically — it argues that if the bound disposition cannot exist in this age, the divine cannot either, and that only the heroic rites bear visible fruit. A record that reports the two paths as a choice between camps reports the later Western reading and not this one. See prima-materia#54."
      },
      "source": [
        "Mahānirvāṇa Tantra I.50-57 (trans. A. Avalon, Tantra of the Great Liberation, London 1913)",
        "Mahānirvāṇa Tantra IV.19-20 (trans. A. Avalon, Tantra of the Great Liberation, London 1913)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "The transmission of the Indian tantric completion-stage practices in Tibet, of which the six yogas of Nāropa are the best documented cycle."
      },
      "id": "pmt:TibetanTantric",
      "label": {
        "de": "Tibetisch-tantrische Überlieferung",
        "en": "Tibetan tantric tradition"
      },
      "note": {
        "en": "Edition finding, prima-materia#45. The Tsongkhapa and Bar do thos grol citations name the translation they were read in. For Patrul Rinpoche's Kun bzang bla ma'i zhal lung neither edition nor translation is recorded, and the citation names no chapter; it is left unstated rather than guessed and the passage is to be reopened."
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The examination of an inner movement for its origin, distinguished threefold as angelic, human or demonic."
      },
      "id": "pmc:DiscernmentOfOrigins",
      "label": {
        "de": "Unterscheidung der Herkunft",
        "en": "Discernment of origins"
      },
      "source": [
        "Evagrius Ponticus, On Thoughts 8",
        "Evagrius Ponticus, Praktikos 80"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:ChristianAsceticDiscernment"
    },
    {
      "id": "pmc:BaraqelTeachesSignsOfLightning",
      "label": {
        "de": "Baraqel offenbart die Zeichen der Blitze",
        "en": "Baraqel discloses the signs of the lightning flashes"
      },
      "note": {
        "en": "Stands in the position the Ethiopic fills with astrology."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfLightning"
      },
      "pm:ascribedTo": {
        "id": "pmc:Baraqel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The reading of import from meteors, given in place of the knowledge of the clouds in the Aramaic-Greek witness."
      },
      "id": "pmc:SignsOfShootingStars",
      "label": {
        "de": "Zeichen der Sternschnuppen",
        "en": "Signs of the shooting stars"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The stopping of a fluid held to fall from above and to be consumed below, whose loss the manual makes responsible for ageing and death."
      },
      "id": "pmc:RetentionOfTheDescendingNectar",
      "label": {
        "de": "Das Zurückhalten des herabfließenden Nektars",
        "en": "The retention of the descending nectar"
      },
      "source": [
        "Svātmārāma, Haṭhayogapradīpikā III.51-52 (Sanskrit vulgate; Sinh 1915)",
        "Svātmārāma, Haṭhayogapradīpikā III.77 (Sanskrit vulgate; Sinh 1915)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "id": "pmc:CompletionPresupposesGeneration",
      "label": {
        "de": "Die Vollendungsstufe setzt die Erzeugungsstufe voraus",
        "en": "The completion stage presupposes the generation stage"
      },
      "note": {
        "en": "The order is set by the arrangement of the treatise, which takes the generation-stage meditations before the completion-stage yogas. That the six yogas belong to the completion stage places tummo after the generation stage as well."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:CompletionStage"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:GenerationStage"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "The transmission of Greek and Latin historiographical and doxographical reports of extraordinary capacities."
      },
      "id": "pmt:GraecoRoman",
      "label": {
        "de": "Griechisch-römisches Zeugnis",
        "en": "Graeco-Roman testimony"
      },
      "note": {
        "en": "Edition finding, prima-materia#45. For every citation in this file the edition or translation the passage was read from is not recoverable, and it is left unstated rather than guessed. The book and chapter numbers are stable across the modern critical editions, which is why the loss is smaller here than elsewhere; it is still a loss, because it is unknown whether the passages were read in the original or in translation."
      },
      "source": "Herodotus, Histories IV.13-16",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "A bounded subgraph that carries emergent meaning irreducible to its individual triples. Designed for vector embedding as a unit."
      },
      "id": "pm:MeaningCluster",
      "label": {
        "de": "Bedeutungs-Cluster",
        "en": "Meaning Cluster"
      },
      "note": {
        "en": "Implements the Sphoṭa principle (Bhartṛhari): meaning resides in the whole utterance, not in isolated phonemes. The subgraph is the phoneme-analog; the cluster is the sphoṭa."
      },
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The restoration of a withered hand and of sight, ascribed to the touch of a ruler in Alexandria."
      },
      "id": "pmc:HealingByTouch",
      "label": {
        "de": "Heilung durch Berührung",
        "en": "Healing by touch"
      },
      "source": [
        "Suetonius, Divus Vespasianus 7",
        "Tacitus, Historiae IV.81"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:GraecoRoman"
    },
    {
      "definition": {
        "en": "The reading of import from the sun."
      },
      "id": "pmc:SignsOfTheSun",
      "label": {
        "de": "Zeichen der Sonne",
        "en": "Signs of the sun"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:InitiationPresupposesSaktipata",
      "label": {
        "de": "Die Initiation setzt die Herabkunft der Kraft voraus",
        "en": "Initiation presupposes the descent of power"
      },
      "note": {
        "en": "The exegesis asks who is qualified for initiation and answers by taking up the descent of power, which places the descent before the rite and before the path. Later and other traditions have read the descent as the fruit of practice instead; the direction recorded here is the one Abhinavagupta sets."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:Diksa"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:Saktipata"
      },
      "source": [
        "Abhinavagupta, Tantrasāra XI",
        "Abhinavagupta, Tantrāloka XIII"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "Repentance, placed first among the stations in the handbook enumeration."
      },
      "id": "pmc:Tawba",
      "label": {
        "de": "Umkehr",
        "en": "Turning back"
      },
      "source": "al-Qushayrī, al-Risāla al-Qushayriyya, chapter on the stations",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Sufism"
    },
    {
      "definition": {
        "en": "A disagreement among editors about what belongs to the manual and how its verses are numbered. The widely circulated editions descend from single manuscripts and differ in the count and extent of their chapters; a critical edition drawn from more than two hundred manuscripts, with the oldest dated 1496, settles neither question in favour of the numbering that most citations use."
      },
      "id": "pmc:HathapradipikaRecensionDispute",
      "label": {
        "de": "Textbestand und Verszählung des Handbuchs hängen von der Ausgabe ab",
        "en": "The text and the verse numbering of the manual are edition-dependent"
      },
      "note": {
        "en": "Held as a node because every citation in this file carries a verse number, and a number is only as stable as the recension it comes from. The numbering used throughout this file follows the widely circulated vulgate text; a reader working from the critical edition may find the same passage under a different number. Naming the manual without naming the edition conceals that anything is at issue."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:disputedClaim": {
        "id": "pmt:Hathayoga"
      },
      "source": [
        "Svātmārāma, Haṭhapradīpikā, critical edition, Kaivalyadhama S.M.Y.M. Samiti, Lonavla",
        "Svātmārāma, Haṭhapradīpikā, critical edition, ed. J. Mallinson, J. Birch, J. Hanneder, M. Demoto and N.-J. Liersch (2024)",
        "Svātmārāma, Haṭhayogapradīpikā, ed. and tr. P. Sinh (1915)"
      ],
      "type": "pm:Disputing"
    },
    {
      "id": "pmc:SuccessPresupposesNadiPurification",
      "label": {
        "de": "Erfolg der Praxis setzt die Reinigung der Kanäle voraus",
        "en": "Success in the practice presupposes purification of the channels"
      },
      "note": {
        "en": "The text directs the breath practice at clearing the impurity of the central channel and gives the outward signs by which accomplished purification is known. It makes success depend on the purification without stating in these verses what befalls one who proceeds without it, which is why the strength here is order and not necessity."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmp:HathaPranayama"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:NadiPurification"
      },
      "source": [
        "Svātmārāma, Haṭhayogapradīpikā II.19-20 (Sanskrit vulgate; Sinh 1915)",
        "Svātmārāma, Haṭhayogapradīpikā II.6 (Sanskrit vulgate; Sinh 1915)"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "id": "pmc:AbsorptionsAreGraded",
      "label": {
        "de": "Jede Vertiefung setzt die vorhergehende voraus",
        "en": "Each absorption presupposes the one before it"
      },
      "note": {
        "en": "The series is strictly graded in both canon and handbook, each stage defined by what it has let go of. No passage was found that forbids skipping in so many words, which is why this is recorded as an order and not as a necessity."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:FourthJhana"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:FourAbsorptions"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga IV (trans. Ñāṇamoli 1956)",
        "Dīgha Nikāya 2, Sāmaññaphala Sutta (trans. Ṭhānissaro Bhikkhu)"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The clearing of impurity from the channels, at which the breath practice is said to aim, and whose accomplishment the text says shows outwardly in the body."
      },
      "id": "pmc:NadiPurification",
      "label": {
        "de": "Reinigung der Kanäle",
        "en": "Purification of the channels"
      },
      "source": [
        "Svātmārāma, Haṭhayogapradīpikā II.19-20 (Sanskrit vulgate; Sinh 1915)",
        "Svātmārāma, Haṭhayogapradīpikā II.6 (Sanskrit vulgate; Sinh 1915)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "id": "pmc:TraversalPresupposesSequence",
      "label": {
        "de": "Die Durchquerung setzt voraus, dass ihre Stationen der Reihe nach genommen werden",
        "en": "The traversal presupposes that its stations are taken in order"
      },
      "note": {
        "en": "Recorded at prescribed order and not at stated necessity, on purpose and against the reading a modern draft makes. The sources say kramaśaḥ and kramāt kramam, in sequence and step by step, and they say it more than once. What no source consulted says is what happens to one who skips a station. A prohibition needs a consequence somebody can quote, and this one has none; without it the claim is an instruction that a later reader hardened into a rule. See prima-materia#36."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:WorldPathTraversal"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:AscentThroughEachCentre"
      },
      "source": [
        "Vijñānabhairava 29 (Sanskrit; verse numbering of Dyczkowski and the current editions)",
        "Vijñānabhairava 56 (Sanskrit; verse numbering of Dyczkowski and the current editions)"
      ],
      "type": "pm:Presupposing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "definition": {
        "en": "A figure named in the Book of Parables as the one who led Eve astray and disclosed the weapons of death."
      },
      "id": "pmc:Gadreel",
      "label": {
        "de": "Gadreel",
        "en": "Gadreel"
      },
      "source": "1 Enoch 69:6 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The act, within a tradition, of warning against a capacity, a practice, or the pursuit of either."
      },
      "id": "pm:Cautioning",
      "label": {
        "de": "Warnen",
        "en": "Cautioning"
      },
      "note": {
        "en": "Held as a node rather than as commentary, because what a tradition warns against is part of what it teaches. A record that carries only the capacities and not the cautions misreports the tradition it claims to hold."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The capacity a yielding claim arrives at. That the tradition says so is the claim; that the practice produces it is not asserted."
      },
      "domain": "pm:Yielding",
      "id": "pm:yieldsCapacity",
      "label": {
        "de": "bringt Vermögen hervor",
        "en": "yields capacity"
      },
      "range": "pm:Conceptualizing",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "A tradition attesting the correspondence for which no route of contact is documented. This is the only kind of attestation that makes a correspondence a finding rather than a citation chain."
      },
      "domain": "pm:Converging",
      "id": "pm:independentAttestation",
      "label": {
        "de": "unabhängige Bezeugung",
        "en": "independent attestation"
      },
      "range": "pm:Tradition",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The transmission of the Pāli canon and its commentarial literature, of which the Visuddhimagga of Buddhaghosa is the systematising handbook."
      },
      "id": "pmt:Theravada",
      "label": {
        "de": "Theravāda",
        "en": "Theravāda"
      },
      "note": {
        "en": "Edition finding, prima-materia#45. The Visuddhimagga citations name the translation they were read from, and Dīgha Nikāya 2 was reopened for this purpose. For Majjhima Nikāya 118, Dīgha Nikāya 11 and Vinaya, Cūḷavagga V.8 the edition or translation is not recoverable and is left unstated rather than guessed; those three passages are to be reopened."
      },
      "source": "Buddhaghosa, Visuddhimagga (trans. Ñāṇamoli 1956)",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The correspondence between the Indian channel-and-heat material and its Tibetan form, held as a node in order to be counted out: the route is documented, so the agreement is reception and carries no weight as evidence of an independently arrived-at structure."
      },
      "id": "pmc:IndoTibetanReception",
      "label": {
        "de": "Indo-tibetische Rezeption, keine Konvergenz",
        "en": "Indo-Tibetan reception, not convergence"
      },
      "note": {
        "en": "Recorded because a graph that only holds findings cannot show its own exclusions. Any later count of independent attestations must skip this pair."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:convergingConcept": [
        {
          "id": "pmc:InnerHeat"
        },
        {
          "id": "pmc:Kundalini"
        },
        {
          "id": "pmc:Rtsa"
        }
      ],
      "pm:transmissionPath": "The six yogas reach Tibet from the Indian mahāsiddha Nāropa through Marpa the translator; the transmission is named in the Tibetan sources themselves.",
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Converging"
    },
    {
      "definition": {
        "en": "The number of cases recorded under this protocol so far."
      },
      "domain": "pm:Testing",
      "id": "pm:caseCount",
      "label": {
        "de": "Fallzahl",
        "en": "case count"
      },
      "range": "xsd:integer",
      "type": "owl:DatatypeProperty"
    },
    {
      "id": "pmc:BaraqelTeachesAstrology",
      "label": {
        "de": "Baraqel offenbart die Astrologie",
        "en": "Baraqel discloses astrology"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:Astrology"
      },
      "pm:ascribedTo": {
        "id": "pmc:Baraqel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The stage at which the gathered and extended breath goes downward, after which it settles and becomes firm; the sequence then turns and rises."
      },
      "id": "pmc:XingqiDescent",
      "label": {
        "de": "Der Abstieg als Stufe der Folge",
        "en": "Descent as a stage of the sequence"
      },
      "note": {
        "en": "The inscription assigns direction to a place in a sequence, not to a phase of breathing. Descent follows gathering and extension; ascent follows sprouting and growing. The closing lines set the two directions against the two powers, the dynamism of heaven showing in what rises and that of earth in what descends. Nothing here binds a direction to inhaling or to exhaling. See prima-materia#27 and prima-materia#28."
      },
      "source": "Xingqi yupei ming, in D. Harper, Early Chinese Medical Literature (1998), p. 125",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "definition": {
        "en": "The awareness context in which a statement is asserted."
      },
      "domain": "rdf:Statement",
      "id": "pm:assertedIn",
      "label": {
        "en": "asserted in"
      },
      "range": "pm:AwarenessContext",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "A four-part examination of an inner movement, set out in the image of the money-changer who tests a coin: for the metal, for the stamp, for the lawfulness of its provenance, and for its weight."
      },
      "id": "pmc:TestingOfThoughts",
      "label": {
        "de": "Die Prüfung der Gedanken",
        "en": "The examination of thoughts"
      },
      "note": {
        "en": "Ignatius adds the rule that the whole course of a train of thought is to be examined, since a bad end reveals the origin, and that a consolation arriving after the fact is to be examined well before it is believed."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:examinationState": {
        "id": "pm:procedureWithoutCases"
      },
      "pm:examinedBy": "John Cassian, transmitting Abba Moses; supplemented by Ignatius of Loyola",
      "pm:falsifiedBy": "A movement fails the test if its metal is false, its stamp is not that of right teaching, its provenance is unlawful, or it weighs light of the fear of God and heavy of human vanity; and it fails if the end of the train of thought is bad, however good its beginning.",
      "pm:protocolUpdated": "2026-08-28",
      "pm:tests": {
        "id": "pmc:DiscernmentOfOrigins"
      },
      "source": [
        "Ignatius of Loyola, Spiritual Exercises 334",
        "Ignatius of Loyola, Spiritual Exercises 336",
        "John Cassian, Collationes I.20-22"
      ],
      "type": "pm:Testing",
      "withinTradition": "pmt:ChristianAsceticDiscernment"
    },
    {
      "definition": {
        "en": "A breath practice inscribed in forty-five characters on a twelve-sided jade block, setting out the deliberate movement of qi through the body."
      },
      "id": "pmp:Xingqi",
      "label": {
        "de": "Zirkulation des Qi",
        "en": "Circulating the qi"
      },
      "note": {
        "en": "The two axes of disagreement belong to the claim and are recorded with it. Dating: Harper places the inscription in the late fourth or early third century BCE, Needham in the middle of the sixth. Reading: Harper takes the opening two characters as the title and begins the text at the second line, where Roth counts and construes differently. A citation that names only the inscription conceals both."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "H.D. Roth, Original Tao (1999)",
        "Xingqi yupei ming, in D. Harper, Early Chinese Medical Literature (1998), p. 125",
        "Xingqi yupei ming, in J. Needham, Science and Civilisation in China II (1956), p. 143"
      ],
      "type": "pm:Practicing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "definition": {
        "en": "Cases have been recorded and show a deviation from the stated base rate. What deviates is what the protocol measured, which is rarely the whole of what the claim asserts."
      },
      "id": "pm:casesWithDeviation",
      "label": {
        "de": "Fälle mit Abweichung",
        "en": "Cases with deviation"
      },
      "type": "pm:ExaminationState"
    },
    {
      "definition": {
        "en": "The transmission of the Yogasūtra of Patañjali and its commentarial literature."
      },
      "id": "pmt:PatanjalaYoga",
      "label": {
        "de": "Pātañjala-Yoga",
        "en": "Pātañjala Yoga"
      },
      "note": {
        "en": "Edition finding, prima-materia#45. Only Yogasūtra III.38 carries the edition it was read from; it was reopened in the Sanskrit for that purpose. For every other citation in this file, and for the Yogabhāṣya, the edition or translation the passage was read from is not recoverable: the session that entered them did not record it, and it cannot be reconstructed from the wording of the nodes. It is stated here rather than guessed, because an edition entered by inference would be a claim about the compiler's work that is not true. Until the passages are reopened, the verse numbers in this file stand on the received four-pāda division and nothing further."
      },
      "source": "Patañjali, Yogasūtra",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The observation that several traditions mark the passage between sleeping and waking as the place where a communication is received, while none of them makes it the place where a faculty is exercised."
      },
      "id": "pmc:ThresholdReceptionCorrespondence",
      "label": {
        "de": "Die Schwelle als Ort des Empfangs",
        "en": "The threshold as a place of reception"
      },
      "note": {
        "en": "Two axes have to be held apart, and the modern draft that prompted this examination runs them together. On the reception axis the threshold is well attested: a voice, a light and an immobility of the eyes in the Neoplatonic account, the nightly ascent of the soul in the Kabbalistic one, the true dream in the Islamic one. On the execution axis, where sight, hearing and the mind-made body are actively exercised, the sources bind the capacities to waking absorption instead. No source found so far puts an actively exercised faculty in the threshold state."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:convergingConcept": [
        {
          "id": "pmc:ClearLightOfSleep"
        },
        {
          "id": "pmc:Theopemptos"
        }
      ],
      "pm:transmissionPath": "The correspondence must not be counted as independent attestation. The Tibetan material reaches Tibet from the Indian mahāsiddha Nāropa through Marpa and is reception, as the file that holds it records. The Mediterranean witnesses are worse still for this purpose: the later Jewish and Islamic dream theory rests on a Neoplatonic substrate, so an agreement between the Greek, the Jewish and the Islamic account is a shared inheritance and not three independent observations. What would count as a finding is a tradition outside both blocks, and none has been located.",
      "source": [
        "Iamblichus, De mysteriis III.2-3 (ed. des Places 1966)",
        "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005), the yoga of the clear light of sleep"
      ],
      "type": "pm:Converging"
    },
    {
      "definition": {
        "en": "The transmission of the Nāṭyaśāstra and the theory of aesthetic states that follows from it."
      },
      "id": "pmt:SanskritDramaturgy",
      "label": {
        "de": "Sanskritische Dramaturgie",
        "en": "Sanskrit dramaturgy"
      },
      "note": {
        "en": "Edition finding, prima-materia#45. For both citations the edition or translation the passage was read from is not recoverable, and it is left unstated rather than guessed. The chapter division of the Nāṭyaśāstra differs between the recensions, so the number seven does not by itself locate the passage on the bodily signs."
      },
      "source": "Nāṭyaśāstra VII",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The first of the three trainings, on which the handbook is built as a commentary on the verse about the tangle."
      },
      "id": "pmc:Sila",
      "label": {
        "de": "Sittlichkeit",
        "en": "Virtue"
      },
      "source": "Buddhaghosa, Visuddhimagga I.1-I.8 (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:ZiqelTeachesSignsOfShootingStars",
      "label": {
        "de": "Ziqel offenbart die Zeichen der Sternschnuppen",
        "en": "Ziqel discloses the signs of the shooting stars"
      },
      "note": {
        "en": "Stands in the position the Ethiopic fills with Ezeqeel and the knowledge of the clouds."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfShootingStars"
      },
      "pm:ascribedTo": {
        "id": "pmc:Ziqel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A capacity ascribed to a named ruler, in an account whose author remarks that those who were present still tell it although there is now no reward for the lie."
      },
      "id": "pmc:VespasianHealing",
      "label": {
        "de": "Heilung durch Berührung, Vespasian zugeschrieben",
        "en": "Healing by touch ascribed to Vespasian"
      },
      "note": {
        "en": "The remark about eyewitnesses is part of the ascription, not an endorsement of it. It records how the historian wanted the claim received."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:HealingByTouch"
      },
      "pm:ascribedTo": {
        "id": "pmc:Vespasian"
      },
      "pm:attestedBy": {
        "id": "pm:thirdPartyAscription"
      },
      "source": [
        "Suetonius, Divus Vespasianus 7",
        "Tacitus, Historiae IV.81"
      ],
      "type": "pm:Attributing",
      "withinTradition": "pmt:GraecoRoman"
    },
    {
      "definition": {
        "en": "Heat held to be generated within the body by deliberate practice rather than received from outside it."
      },
      "id": "pmc:InnerHeat",
      "label": {
        "de": "Innere Hitze",
        "en": "Inner heat"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "dcterms:date": "1995",
      "definition": {
        "en": "The claim that emotional and mental states occupy fixed positions on a single numbered scale, ascending from shame through fear, anger and pride to reason, love, joy, peace and enlightenment, and that the position can be established by testing."
      },
      "id": "pmc:HawkinsConsciousnessScale",
      "label": {
        "de": "Die Ordnung der Affekte nach gemessener Stufe",
        "en": "The ranking of emotions by measured level"
      },
      "note": {
        "en": "No tradition located so far ranks emotions by reach or by energy on a single ordered scale. The seventeen steps, the relative order of shame, guilt, fear and anger, and the placement of willingness are the specific things a later list can be measured against, and they begin here."
      },
      "pm:circulatesAs": "A perennial map of consciousness, reported as the distilled agreement of the mystical traditions.",
      "pm:originatedBy": "David R. Hawkins",
      "source": "D. R. Hawkins, Power vs. Force (1995)",
      "type": "pm:Originating"
    },
    {
      "definition": {
        "en": "The capacity that an attribution ascribes."
      },
      "domain": "pm:Attributing",
      "id": "pm:ascribedCapacity",
      "label": {
        "de": "zugeschriebenes Vermögen",
        "en": "ascribed capacity"
      },
      "range": "pm:Conceptualizing",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The state ascribed to the cooling retention: fever, bile, hunger, thirst and the effect of poisons are said to be put down."
      },
      "id": "pmc:CoolingAndQuenching",
      "label": {
        "de": "Kühlung und das Stillen von Hunger und Durst",
        "en": "Cooling and the quenching of hunger and thirst"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā II.58 (Sanskrit vulgate; Sinh 1915)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The generation of inner heat, presented in three components: the channels, the syllables, and the heat meditation itself."
      },
      "id": "pmp:Tummo",
      "label": {
        "de": "Tummo",
        "en": "Tummo"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Practicing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "Ten states arising in practice, among them luminosity, rapture, tranquillity, pleasure and resolve, which are not defilements in themselves but become obstacles when taken as proof of attainment."
      },
      "id": "pmc:ImperfectionsOfInsight",
      "label": {
        "de": "Die Unvollkommenheiten der Einsicht",
        "en": "The imperfections of insight"
      },
      "note": {
        "en": "The handbook illustrates the error with the monk who held himself awakened for sixty years. This is the tradition's own answer to the question of how a practitioner mistakes a state for a result."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:cautionsAbout": {
        "id": "pmc:Piti"
      },
      "source": "Buddhaghosa, Visuddhimagga XX.105ff. (trans. Ñāṇamoli 1956)",
      "type": "pm:Cautioning",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The transmission of Chinese texts and practices concerned with the cultivation and circulation of qi."
      },
      "id": "pmt:Daoist",
      "label": {
        "de": "Daoistische Überlieferung",
        "en": "Daoist tradition"
      },
      "note": {
        "en": [
          "Edition finding, prima-materia#45. The citations of the jade inscription name the work they were read in. For Zhuangzi 4, Baopuzi neipian 8 and Chen Zhixu's Jindan dayao the edition or translation is not recoverable and is left unstated rather than guessed; those three passages are to be reopened, and for the Jindan dayao the juan division is itself edition-dependent.",
          "Thin on purpose, and the thinness is the finding. Of the material this tradition is credited with, two places could be run down to a text that names its own words: the jade inscription, which is the earliest datable witness located for a deliberate circulation of qi through the body, and the eighth chapter of the Baopuzi, which states the manner of the breathing in terms an examination could take hold of. How early the inscription is remains contested, and the dispute node holds that. What is widely reported and was not run down to a citable passage stays out rather than being approximated: the absorption of solar, lunar and stellar qi (fuqi) and the abstention from grain (bigu) are recorded at prima-materia#17, not here."
        ]
      },
      "source": "Xingqi yupei ming (jade inscription on circulating the qi)",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "Sensual desire, ill will, dullness and drowsiness, restlessness and remorse, and doubt, whose abandoning the discourse describes immediately before entry into the first absorption."
      },
      "id": "pmc:FiveHindrances",
      "label": {
        "de": "Die fünf Hemmnisse",
        "en": "The five hindrances"
      },
      "source": "Dīgha Nikāya 2, Sāmaññaphala Sutta (trans. Ṭhānissaro Bhikkhu)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "Refining essence into breath, breath into spirit, and spirit back into emptiness."
      },
      "id": "pmc:NeidanThreeStages",
      "label": {
        "de": "Die drei Stufen des inneren Elixiers",
        "en": "The three stages of the inner elixir"
      },
      "note": {
        "en": "A dating warning belongs on this node. The sequence is routinely attributed to the Cantong qi or to the Wuzhen pian, but neither carries it as a fixed numbered progression; the Wuzhen pian sets only a precedence of vital force before inner nature, and of doing before non-doing. The earliest ordered witness located for the full triad is the Yuan-period Jindan dayao."
      },
      "source": "Chen Zhixu, Jindan dayao, juan 4",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Daoist"
    },
    {
      "definition": {
        "en": "The emergence of a form out of a prior undifferentiated ground."
      },
      "id": "pm:Manifesting",
      "label": {
        "de": "Manifestieren",
        "en": "Manifesting"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "A disagreement about what is required for absorption. The discourses describe it as reached in the ordinary course of the training; the handbook sets a far higher bar, remarking that only one in a hundred or a thousand accomplishes it."
      },
      "id": "pmc:AbsorptionThresholdDispute",
      "label": {
        "de": "Wie hoch die Schwelle der Vertiefung liegt",
        "en": "How high the threshold of absorption stands"
      },
      "note": {
        "en": "The disagreement bears directly on every prerequisite in this file that runs through the fourth absorption. If the handbook's threshold is the right one, the capacities it makes conditional on that absorption are conditional on something very few reach; if the discourses' is, they are not."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:disputedClaim": {
        "id": "pmc:FourAbsorptions"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga XII (trans. Ñāṇamoli 1956)",
        "Dīgha Nikāya 2, Sāmaññaphala Sutta (trans. Ṭhānissaro Bhikkhu)"
      ],
      "type": "pm:Disputing"
    },
    {
      "definition": {
        "en": "Knowledge of the state of another consciousness."
      },
      "id": "pmc:Cetopariyanana",
      "label": {
        "de": "Kenntnis fremden Bewusstseins",
        "en": "Knowledge encompassing another mind"
      },
      "source": "Buddhaghosa, Visuddhimagga XIII (trans. Ñāṇamoli 1956)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "A disagreement about a claim, carried on within a tradition, between traditions, or among the scholars who edit their texts."
      },
      "id": "pm:Disputing",
      "label": {
        "de": "Bestreiten",
        "en": "Disputing"
      },
      "note": {
        "en": "Without this class a disagreement can only be recorded by silently preferring one side, or by leaving the claim out because it is contested. Both losses are worse than the disagreement. A dispute node names what is at issue and cites each side, and a dispute with only one source cited is not a dispute."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "A figure named in the Book of Parables as the one who disclosed the striking of spirits, the killing of the embryo and the serpent's bite."
      },
      "id": "pmc:Kasdeja",
      "label": {
        "de": "Kasdeja",
        "en": "Kasdeja"
      },
      "source": "1 Enoch 69:12 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The apāna is raised from below while the prāṇa is pressed down from the throat, and the two are brought together in the region of the navel."
      },
      "id": "pmc:OpposedDirectionsOfPranaAndApana",
      "label": {
        "de": "Die beiden Winde werden zugleich in entgegengesetzte Richtungen getrieben",
        "en": "The two winds are driven in opposite directions at once"
      },
      "note": {
        "en": "The manual assigns direction to the two winds, not to the two phases of breathing. Both directions run in the same operation and against each other, so a scheme that reads inhalation as upward and exhalation as downward, or the reverse, has no purchase here. See prima-materia#27 and prima-materia#28."
      },
      "source": [
        "Svātmārāma, Haṭhayogapradīpikā I.50 (Sanskrit vulgate; Sinh 1915)",
        "Svātmārāma, Haṭhayogapradīpikā II.47 (Sanskrit vulgate; Sinh 1915)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "definition": {
        "en": "The transmission of the Upaniṣads as the speculative layer of the Vedic corpus."
      },
      "id": "pmt:Upanisadic",
      "label": {
        "de": "Upaniṣadische Überlieferung",
        "en": "Upaniṣadic tradition"
      },
      "note": {
        "en": "Edition finding, prima-materia#45. Chāndogya 7.15.1 carries the edition it was read from and was reopened in the Sanskrit for that purpose. For 1.11.5 the edition is not recoverable and is left unstated rather than guessed."
      },
      "source": "Chāndogya Upaniṣad",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "Cases have been recorded and show no deviation from the stated base rate."
      },
      "id": "pm:casesWithoutDeviation",
      "label": {
        "de": "Fälle ohne Abweichung",
        "en": "Cases without deviation"
      },
      "type": "pm:ExaminationState"
    },
    {
      "dcterms:date": "1888",
      "definition": {
        "en": "The claim that humanity divided at a datable point of its history into two opposed paths of knowledge, a right-hand and a left-hand one, and that the two magics called white and black were sown as seeds at that moment."
      },
      "id": "pmc:TwoPathsOfKnowledge",
      "label": {
        "de": "Die Verzweigung der Menschheit in einen rechten und einen linken Pfad des Wissens",
        "en": "The branching of humanity into a right-hand and a left-hand path of knowledge"
      },
      "note": {
        "en": [
          "Checked against the earlier work rather than assumed from it. The full text of Isis Unveiled (1877), both volumes, carries no occurrence of a right-hand or a left-hand path, and none of the tantric vocabulary the names come from. The usual account, which dates the introduction of the terms to 1877, is wrong by eleven years: the passage stands in the work of 1888. See prima-materia#58.",
          "The claim is presented as a quotation from a commentary of unstated antiquity, and it is the commentary rather than the author that later reporting cites. That is what pm:circulatesAs records here, and it is why this node is an origination and not an ordering: an ordering names what it arranges, and this one arranges nothing.",
          "What is new here is not the pair of names, which stands in the orientalist literature from 1832 and is held as pmc:RightAndLeftHandNomenclature. What is new is that the pair becomes a history: two parties, a moment of origin, and a lineage of adepts on either side. Everything the later occult milieu inherits — that there are two camps and that a person may join one of them — rests on this move and not on the naming."
        ]
      },
      "pm:circulatesAs": "The ancient meaning of the two paths, credited to a commentary of unstated age rather than to the work of 1888 in which it first stands.",
      "pm:originatedBy": "Helena P. Blavatsky",
      "source": "H. P. Blavatsky, The Secret Doctrine I: Cosmogenesis (London 1888), in the discussion of the fourth race, at the sentence on the branching of humanity into the right- and left-hand paths of knowledge or Vidya",
      "type": "pm:Originating"
    },
    {
      "definition": {
        "en": "Mindfulness of in-breath and out-breath, set out as a sixteen-step progression in the discourse and as a meditation subject in the handbook."
      },
      "id": "pmp:Anapanasati",
      "label": {
        "de": "Ānāpānasati",
        "en": "Ānāpānasati"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga VIII (trans. Ñāṇamoli 1956)",
        "Majjhima Nikāya 118"
      ],
      "type": "pm:Practicing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "How far the attempt to fail the claim has been carried."
      },
      "domain": "pm:Testing",
      "id": "pm:examinationState",
      "label": {
        "de": "Prüfstand",
        "en": "examination state"
      },
      "range": "pm:ExaminationState",
      "type": "owl:ObjectProperty"
    },
    {
      "id": "pmc:BhastrikaPresupposesLevelNeckAndTrunk",
      "label": {
        "de": "Der Blasebalgatem setzt einen gerade gehaltenen Hals und Rumpf voraus",
        "en": "The bellows breath presupposes neck and trunk held level"
      },
      "note": {
        "en": "The verse binds the lotus seat, a level neck and trunk, and a carefully closed mouth into the one instruction that opens the bellows breath. It is the only place in the breath chapter where the alignment of the spine is stated as a condition of a breath practice, and it is stated for one practice, not for the chapter. See prima-materia#29."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmp:HathaPranayama"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:ErectTrunkInSwastikasana"
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā II.60 (Sanskrit vulgate; Sinh 1915)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "id": "pmc:ShemihazahTeachesSpellCasting",
      "label": {
        "de": "Schemichasa offenbart die Beschwörung",
        "en": "Shemihazah discloses spell-casting"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SpellCasting"
      },
      "pm:ascribedTo": {
        "id": "pmc:Shemihazah"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "One party ascribes the capacity to another, who does not report it. Common for capacities said to be lost, since no bearer remains to be asked."
      },
      "id": "pm:thirdPartyAscription",
      "label": {
        "de": "Fremdzuschreibung",
        "en": "Third-party ascription"
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "A disagreement about where the higher perceptual capacities are exercised. The handbooks of absorption place them in a waking, fully concentrated state and say so with a stated necessity; the ascetic literature marks the light half-sleep as the place of counterfeit consolation; the theurgic account, by contrast, treats the edge of sleep as the mark of a genuine divine communication."
      },
      "id": "pmc:ThresholdIsNotTheExecutionState",
      "label": {
        "de": "Ob der Schwellenzustand die Vermögen trägt",
        "en": "Whether the threshold state carries the faculties"
      },
      "note": {
        "en": [
          "Edition finding, prima-materia#45. Two of the three sides name the edition or translation they were read in. For Diadochus the edition is not recoverable and is left unstated rather than guessed; the passage is to be reopened, and until then the chapter number stands on whichever numbering the earlier session used.",
          "Recorded as a dispute between sources and not as a verdict on the modern draft. A draft is not a side: it carries no attestation, so a claim it makes has no standing here. What the sources actually disagree about is narrower and more interesting than the draft's question, namely whether the threshold is evidential at all, and both sides of that are attested."
        ]
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:disputedClaim": {
        "id": "pmc:Theopemptos"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga I.11 (trans. Ñāṇamoli 1956)",
        "Diadochus of Photice, Gnostic Chapters 40",
        "Iamblichus, De mysteriis III.2-3 (ed. des Places 1966)"
      ],
      "type": "pm:Disputing"
    },
    {
      "definition": {
        "en": "The transmission of the Haṭhayogapradīpikā of Svātmārāma and the manuals around it."
      },
      "id": "pmt:Hathayoga",
      "label": {
        "de": "Haṭhayoga",
        "en": "Haṭhayoga"
      },
      "note": {
        "en": "Edition finding, prima-materia#45. Every verse cited in this file was read in the Sanskrit of the widely circulated vulgate, in the recension that the 1915 edition and translation of Sinh carries, and each citation now says so. The critical edition drawn from the manuscript tradition numbers differently in places; pmc:HathapradipikaRecensionDispute holds what is at issue."
      },
      "source": "Svātmārāma, Haṭhayogapradīpikā (Sanskrit vulgate; Sinh 1915)",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The disclosure of harmful operations: the striking of spirits and demons, the killing of the embryo in the womb, the serpent's bite and the stroke of the noonday heat."
      },
      "id": "pmc:StrikingOfSpirits",
      "label": {
        "de": "Schlagen der Geister und der Leibesfrucht",
        "en": "Striking of spirits and of the womb"
      },
      "source": "1 Enoch 69:12 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The second of the three parts, the contemplation of created things."
      },
      "id": "pmc:Physike",
      "label": {
        "de": "Physikē",
        "en": "Contemplation of nature"
      },
      "source": "Evagrius Ponticus, Praktikos 1",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "definition": {
        "en": "A second body, formed and complete in its faculties, said to be produced from this one; the classical form of the claim the modern draft calls exteriorisation."
      },
      "id": "pmc:Manomayakaya",
      "label": {
        "de": "Geistgemachter Körper",
        "en": "Mind-made body"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga XII (trans. Ñāṇamoli 1956)",
        "Dīgha Nikāya 2, Sāmaññaphala Sutta, DN i.77 (trans. Ṭhānissaro Bhikkhu)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The transfer of the seat of awareness into a body other than one's own."
      },
      "id": "pmc:ParakayaPravesa",
      "label": {
        "de": "Eintritt in einen anderen Körper",
        "en": "Entering another body"
      },
      "source": "Patañjali, Yogasūtra III.38 (Sanskrit sūtra text; received four-pāda numbering)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "Associates a concept with one or more symbolic representations (sigils, diagrams, glyphs)."
      },
      "id": "pm:hasSymbolicForm",
      "label": {
        "en": "has symbolic form"
      },
      "range": "pm:Symbolizing",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "An ascent in thirty steps, running from renunciation and exile through the active virtues to stillness, prayer, freedom from the passions and love, and passing in its course from human labour to what is given."
      },
      "id": "pmc:LadderOfThirtySteps",
      "label": {
        "de": "Die Leiter der dreißig Stufen",
        "en": "The ladder of thirty steps"
      },
      "source": "John Climacus, The Ladder of Divine Ascent, steps 1-30",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:DesertMonasticism"
    },
    {
      "definition": {
        "en": "A limit named as the end of twelve, at which the mind or the risen power comes to rest. The verses give the number and leave the unit unstated."
      },
      "id": "pmc:Dvadasanta",
      "label": {
        "de": "Das Ende der Zwölf",
        "en": "The end of the twelve"
      },
      "note": {
        "en": [
          "The count itself fluctuates. What is verse 50 in the numbering used here appears as 51 in other editions, and the following verse shifts with it. A reader working from a different edition should expect the two verses cited here to sit one number further on.",
          "Two things this node deliberately does not say. It does not fix the unit: the base text says end-of-twelve, and the reading that makes this twelve finger-breadths from the tip of the nose belongs to the commentarial layer, not to the verse. And it does not fix the place: the exegesis of Lakṣmaṇjoo counts several such limits in the body, at the crown, the brows, the throat, the base of the heart and the navel, and the verse that follows says outright that it may be reached in any manner and in any place. Nothing here yields a fixed radius. See prima-materia#38."
        ]
      },
      "source": [
        "Vijñānabhairava 28 (Sanskrit; verse numbering of Dyczkowski and the current editions)",
        "Vijñānabhairava 50 (Sanskrit; verse numbering of Dyczkowski and the current editions)",
        "Vijñānabhairava 51 (Sanskrit; verse numbering of Dyczkowski and the current editions)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "id": "pmc:KhecariYieldsRetention",
      "label": {
        "de": "Die über den Gaumen gelegte Zunge bringt das Zurückhalten des Nektars hervor",
        "en": "The tongue set above the palate yields the retention of the nectar"
      },
      "note": {
        "en": "The contact at the palate is attested, and what it is said to do is stop a descent. It is not bound to a phase of breathing anywhere in the chapter, and it is not said to carry anything upward. The same holds for the seal at the throat, which is described as closing off a downward flow. A scheme that pairs the palate with inhalation and with upward carriage takes a stopping and reports it as a conveyance. See prima-materia#28."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:Khecari"
      },
      "pm:yieldsCapacity": {
        "id": "pmc:RetentionOfTheDescendingNectar"
      },
      "source": [
        "Svātmārāma, Haṭhayogapradīpikā III.42 (Sanskrit vulgate; Sinh 1915)",
        "Svātmārāma, Haṭhayogapradīpikā III.51-52 (Sanskrit vulgate; Sinh 1915)"
      ],
      "type": "pm:Yielding",
      "withinTradition": "pmt:Hathayoga"
    },
    {
      "comment": {
        "en": "Consciousness-first meta-ontology. Processes, not substances."
      },
      "id": "https://pajew.ski/prima-materia/ontology",
      "license": "https://creativecommons.org/publicdomain/zero/1.0/",
      "title": {
        "en": "prima-materia core ontology"
      },
      "type": "owl:Ontology"
    },
    {
      "id": "pmc:TrainingPresupposesPreliminaries",
      "label": {
        "de": "Das Training setzt die Vorbereitungen voraus",
        "en": "The training presupposes the preliminaries"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:GenerationStage"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmp:Preliminaries"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "A warning against treating the given states as a further ladder: they descend and pass, and no course of effort produces them."
      },
      "id": "pmc:StatesAreNotOrdered",
      "label": {
        "de": "Die Zustände werden nicht der Reihe nach erlangt",
        "en": "The states are not attained in order"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:cautionsAbout": {
        "id": "pmc:Ahwal"
      },
      "source": [
        "al-Qushayrī, al-Risāla al-Qushayriyya",
        "al-Sarrāj, Kitāb al-Lumaʿ"
      ],
      "type": "pm:Cautioning",
      "withinTradition": "pmt:Sufism"
    },
    {
      "definition": {
        "en": "An operative procedure enacted within a tradition."
      },
      "id": "pm:Practicing",
      "label": {
        "de": "Praktizieren",
        "en": "Practicing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "dcterms:date": "1927",
      "definition": {
        "en": "The assignment of a fixed set of seven centres to spectral colours and to psychological qualities such as will, expression and security. An ordering imposed in the twentieth century on material that did not carry it."
      },
      "id": "pmc:SevenCentreQualityMapping",
      "label": {
        "de": "Die Zuordnung von sieben Zentren zu Eigenschaften",
        "en": "The seven-centre quality mapping"
      },
      "note": {
        "en": "Colour scheme in Leadbeater 1927, rainbow spectrum in Hills 1977, on the textual basis made available by Avalon's 1919 translation of the Ṣaṭcakranirūpaṇa. Recorded here so that the mapping is available in the graph as what it is, and cannot be mistaken for the tantric material it was built on."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:compiledBy": "C. W. Leadbeater, extended by Christopher Hills and Ken Dychtwald",
      "pm:ordersClaim": {
        "id": "pmc:Cakra"
      },
      "source": [
        "A. Avalon, The Serpent Power (1919)",
        "C. W. Leadbeater, The Chakras (1927)",
        "Christopher Hills, Nuclear Evolution (1977)",
        "Ken Dychtwald, Bodymind (1977)"
      ],
      "type": "pm:Systematizing"
    },
    {
      "dcterms:date": "1975",
      "definition": {
        "en": "The claim that the Egyptian term for becoming, coming into being, personified in the scarab god and signifying self-generation and the dawn, names the transformation and evolution of the will, and that it is uttered as the word of a new age succeeding the age of indulgence."
      },
      "id": "pmc:XeperAsSelfGeneration",
      "label": {
        "de": "Xeper als das Wort der Selbsthervorbringung",
        "en": "Xeper as the word of self-generation"
      },
      "note": {
        "en": [
          "Held as an origination because of the shape of the claim rather than its content. The word is Egyptian and its lexical sense is not in dispute; what begins in 1975 is its use as the formula of a path, in a sequence of ages with named predecessors. The Egyptological reference is present in the source and does not make the doctrine ancient.",
          "This is the end state the milieu sets against dissolution, and it is worth recording in the author's own terms rather than in the summaries: not the preservation of an ego as ordinarily meant, but a self-generation modelled on a god who brings himself forth. A record that reports it as mere ego-preservation reports the criticism and not the claim."
        ]
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:circulatesAs": "A doctrine recovered from Egyptian antiquity, reported as the teaching the word is drawn from rather than as a formula first uttered in 1975.",
      "pm:originatedBy": "Michael A. Aquino",
      "source": "M. A. Aquino, The Temple of Set (Temple of Set, San Francisco), in the account of the Word Xeper and its Egyptian derivation",
      "type": "pm:Originating"
    },
    {
      "definition": {
        "en": "The named author with whom the claim begins."
      },
      "domain": "pm:Originating",
      "id": "pm:originatedBy",
      "label": {
        "de": "aufgestellt von",
        "en": "originated by"
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "The bearer to whom the capacity is ascribed: a named figure, a class of beings, humanity before a stated event."
      },
      "domain": "pm:Attributing",
      "id": "pm:ascribedTo",
      "label": {
        "de": "zugeschrieben an",
        "en": "ascribed to"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "A Watcher named in the teaching list as the one who disclosed the undoing of spells."
      },
      "id": "pmc:Armaros",
      "label": {
        "de": "Armaros",
        "en": "Armaros"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "Hermani"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The observation that the raising of the body hair is codified as a sign of an inner state in two Indian genres that have no common subject matter: a meditation handbook and a treatise on dramatic performance."
      },
      "id": "pmc:HorripilationCorrespondence",
      "label": {
        "de": "Die Entsprechung der Haaraufrichtung",
        "en": "The horripilation correspondence"
      },
      "note": {
        "en": "The strongest item in this file, and still not what it first appears. The independence is generic and not cultural: both texts belong to the Indian sphere, so a common background cannot be excluded. What can be excluded is that one borrowed the observation from the other, since neither is about the other's subject. A universal physiology codified twice is a finding about the physiology."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:convergingConcept": [
        {
          "id": "pmc:KhuddikaPiti"
        },
        {
          "id": "pmc:Romanca"
        }
      ],
      "pm:independentAttestation": [
        {
          "id": "pmt:SanskritDramaturgy"
        },
        {
          "id": "pmt:Theravada"
        }
      ],
      "pm:transmissionPath": "Both codifications arise within the Indian cultural sphere; independence holds at the level of genre and subject matter, not at the level of culture.",
      "source": [
        "Buddhaghosa, Visuddhimagga IV.94ff. (trans. Ñāṇamoli 1956)",
        "Nāṭyaśāstra VII"
      ],
      "type": "pm:Converging"
    },
    {
      "definition": {
        "en": "The capacity, practice or pursuit a warning is directed at."
      },
      "domain": "pm:Cautioning",
      "id": "pm:cautionsAbout",
      "label": {
        "de": "warnt vor",
        "en": "cautions about"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "id": "pmc:LimbPracticeYieldsLightOfKnowledge",
      "label": {
        "de": "Die Übung der Glieder bringt das Leuchten der Erkenntnis hervor",
        "en": "Practice of the limbs yields the light of knowledge"
      },
      "note": {
        "en": "The sūtra makes the arising conditional on the wearing away of impurity, which is itself said to come from the practice. The condition is part of the claim and is not to be dropped when the claim is quoted."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:PracticeOfTheLimbs"
      },
      "pm:yieldsCapacity": {
        "id": "pmc:LightOfKnowledge"
      },
      "source": "Patañjali, Yogasūtra II.28",
      "type": "pm:Yielding",
      "withinTradition": "pmt:PatanjalaYoga"
    },
    {
      "definition": {
        "en": "The transmission of the Platonic dialogues and the ascent they describe from particular to intelligible beauty."
      },
      "id": "pmt:Platonic",
      "label": {
        "de": "Platonische Überlieferung",
        "en": "Platonic tradition"
      },
      "note": {
        "en": "Edition finding, prima-materia#45. The edition the Symposium was read in is not recoverable and is left unstated rather than guessed. The Stephanus pagination is stable across the modern editions, so the citations locate the text; what is unknown is whether the Greek or a translation was read."
      },
      "source": "Plato, Symposium 210a-212a",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "The teaching that the figures met in the intermediate state are appearances of the one who meets them and not independently existing beings, and that recognising them as such is what frees."
      },
      "id": "pmc:AppearancesAreSelfArising",
      "label": {
        "de": "Die Erscheinungen sind Selbst-Erscheinung",
        "en": "The appearances are self-arising"
      },
      "note": {
        "en": "Tibetan rang snang, self-appearance. A dating warning belongs on this node: the work is traditionally ascribed to Padmasambhava in the eighth century but is a treasure text of the fourteenth, revealed by Karma Lingpa; the older ascription is not held in the scholarship. Note also the scope. The doctrine holds of all appearance in this tradition, waking included, and is therefore not a statement about the threshold state in particular."
      },
      "source": "Bar do thos grol (Karma Lingpa recension, 14th century; trans. Gyurme Dorje 2006), the intermediate state of reality",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "id": "pmc:PenemueTeachesBitterAndSweet",
      "label": {
        "de": "Penemue offenbart bitter und süß",
        "en": "Penemue discloses bitter and sweet"
      },
      "note": {
        "en": "Book of Parables; no Aramaic fragment of chapters 37-71 is attested at Qumran."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:DiscernmentOfBitterAndSweet"
      },
      "pm:ascribedTo": {
        "id": "pmc:Penemue"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "1 Enoch 69:8 (Ethiopic; Charles 1912)",
        "J.T. Milik, The Books of Enoch: Aramaic Fragments of Qumrân Cave 4 (Oxford, 1976)"
      ],
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:DirectKnowledgesPresupposeConcentration",
      "label": {
        "de": "Die höheren Kenntnisse setzen die Sammlung voraus",
        "en": "The direct knowledges presuppose concentration"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:consequenceOfSkipping": "The handbook states that the six kinds of direct knowledge are arrived at with the support of perfected concentration and by nothing besides that.",
      "pm:dependentStep": [
        {
          "id": "pmc:Cetopariyanana"
        },
        {
          "id": "pmc:Dibbacakkhu"
        },
        {
          "id": "pmc:Dibbasota"
        },
        {
          "id": "pmc:Iddhividha"
        }
      ],
      "pm:prerequisiteStrength": {
        "id": "pm:statedNecessity"
      },
      "pm:priorStep": {
        "id": "pmc:Samadhi"
      },
      "source": "Buddhaghosa, Visuddhimagga I.11 (trans. Ñāṇamoli 1956)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "id": "pmc:SecondWeekPresupposesFirst",
      "label": {
        "de": "Die zweite Woche setzt die erste voraus",
        "en": "The second week presupposes the first"
      },
      "note": {
        "en": "The same annotation that sets the order removes any fixed duration from it: the weeks need not have seven or eight days, and one who needs longer in the first is to be given longer. The order is set, the schedule is not."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmc:SecondWeek"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:FirstWeek"
      },
      "source": "Ignatius of Loyola, Spiritual Exercises 4",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:ChristianAsceticDiscernment"
    },
    {
      "definition": {
        "en": "The claim that the soul leaves the body and returns to it, reported of Aristeas of Proconnesus and of Hermotimus of Clazomenae."
      },
      "id": "pmc:SoulJourney",
      "label": {
        "de": "Seelenreise ohne den Körper",
        "en": "Journey of the soul apart from the body"
      },
      "source": [
        "Herodotus, Histories IV.13-16",
        "Pliny, Naturalis Historia VII.174"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:GraecoRoman"
    },
    {
      "definition": {
        "en": "The transmission of the ascetic literature of the Egyptian desert and its Byzantine continuation, in which the path is set out as an ordered ascent."
      },
      "id": "pmt:DesertMonasticism",
      "label": {
        "de": "Wüstenmönchtum",
        "en": "Desert monasticism"
      },
      "note": {
        "en": "Edition finding, prima-materia#45. For every citation in this file the edition or translation the passage was read from is not recoverable, and it is left unstated rather than guessed. The chapter numbering of the Praktikos and the step division of the Ladder both vary between editions, so the numbers here stand on nothing until the passages are reopened."
      },
      "source": "Evagrius Ponticus, Praktikos",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "A graded order of ways of practice in which each is declared superior to the one before: the Veda above all others, the Vaiṣṇava above the Veda, the Śaiva above the Vaiṣṇava, the Dakṣiṇa above the Śaiva, the Vāma above the Dakṣiṇa, the Siddhānta above the Vāma, the Kaula above the Siddhānta, and nothing above the Kaula."
      },
      "id": "pmc:AcaraLadder",
      "label": {
        "de": "Die aufsteigende Ordnung der ācāras",
        "en": "The ascending order of the ācāras"
      },
      "note": {
        "en": [
          "The chapter and verse are not recoverable from the copy read, which is an OCR of a printed translation whose running structure the scan does not carry reliably. Work, section and edition are named instead, which meets the standard of findability; a later reader working from another edition should expect a different numbering. See prima-materia#45 and prima-materia#56.",
          "This is the passage Wilson translates in 1832 without naming a place in the work, and on which pmc:RightAndLeftHandNomenclature rests. It is now located in an edition, so the order is a claim of the tantra and no longer only a claim of its reporter.",
          "Two things follow that the Western pair of names cannot carry. The order has seven steps and not two, so a scheme with two is not a simplification of it but a replacement. And within the order the left stands above the right, so the English rendering keeps the pair and reverses its valuation. Whoever explains the modern left-hand path out of this passage explains it out of a text that ranks the left higher than the right and both below two further steps."
        ]
      },
      "source": "Kulārṇava Tantra, in the section on the superiority of the Kula-dharma, at the verses giving the order of superiority of the ācāras (text with English translation by Ram Kumar Rai, Varanasi 1999)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "dcterms:date": "1997",
      "definition": {
        "en": "The claim that the left-hand path is constituted by the goal of self-deification rather than by any particular practice, and that it falls into two branches: an immanent one, materialistic in outlook and pronounced in its transgression, and a transcendental one, centred on intellect and eternal forms."
      },
      "id": "pmc:LeftHandPathTwoBranches",
      "label": {
        "de": "Der linke Pfad, über sein Ziel bestimmt, mit zwei nach der Methode unterschiedenen Zweigen",
        "en": "The left-hand path defined by its goal, with two branches differing in method"
      },
      "note": {
        "en": [
          "That is the case this graph was given a separate method axis for. In the same work the goal is held constant across both branches while the degree of transgression varies between them — an author varying one axis and holding the other fixed, without drawing the axes. See prima-materia#52 and prima-materia#67.",
          "The passage that matters most for this record is the one that denies a methodological definition outright. The source states that there are no categorical methodological proscriptions on the path in any of its traditions, eastern or western, and that methods are chosen pragmatically; the antinomian element is described as often strong, not as constitutive. The author who is usually cited as fixing the path by transgression therefore says the opposite of what he is cited for.",
          "The transcendental branch is the standing candidate for the quadrant that a one-axis scheme cannot name: a goal of self-deification without transgression as its means. Whether it actually sits there is not settled by this node and is the question of prima-materia#72."
        ]
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:circulatesAs": "The old distinction of the Indian tantric traditions, reported as though the two-criteria definition were carried by them rather than formulated in 1997.",
      "pm:originatedBy": "Stephen E. Flowers",
      "source": "S. E. Flowers, Lords of the Left-Hand Path: A History of Spiritual Dissent (Smithville 1997), in the chapter setting out the criteria and the two branches",
      "type": "pm:Originating"
    },
    {
      "definition": {
        "en": "The act of imposing an order on material that did not carry it: a list, a sequence, a correspondence table. Named, dated, and attributed to the compiler who performed it, never to the source that is being ordered."
      },
      "id": "pm:Systematizing",
      "label": {
        "de": "Systematisieren",
        "en": "Systematizing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The fourth state: pure awareness that is neither outward- nor inward-turned, and not a negation of either."
      },
      "id": "pm:TranscendentState",
      "label": {
        "de": "Transzendenter Zustand (Turīya)",
        "en": "Transcendent state (Turīya)"
      },
      "source": "Māṇḍūkya Upaniṣad, verse 7",
      "type": "pm:AwarenessContext"
    },
    {
      "definition": {
        "en": "The operative means keep the norm of the order the path is transmitted in: what is prohibited there stays prohibited here."
      },
      "id": "pm:conformingMethod",
      "label": {
        "de": "Ordnungstreue Methode",
        "en": "Conforming method"
      },
      "type": "pm:MethodOrientation"
    },
    {
      "definition": {
        "en": "The part given over to the life of Christ up to Palm Sunday, and to the following of it."
      },
      "id": "pmc:SecondWeek",
      "label": {
        "de": "Die zweite Woche",
        "en": "The second week"
      },
      "source": "Ignatius of Loyola, Spiritual Exercises 4",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:ChristianAsceticDiscernment"
    },
    {
      "definition": {
        "en": "The absorption from which the handbook has the supernormal powers proceed, and which it calls their natural plane."
      },
      "id": "pmc:FourthJhana",
      "label": {
        "de": "Die vierte Vertiefung",
        "en": "The fourth absorption"
      },
      "source": [
        "Buddhaghosa, Visuddhimagga XII.1 (trans. Ñāṇamoli 1956)",
        "Buddhaghosa, Visuddhimagga XII.49 (trans. Ñāṇamoli 1956)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Theravada"
    },
    {
      "definition": {
        "en": "The undoing of a binding laid by another, held in the text as a distinct art from the laying of it."
      },
      "id": "pmc:LoosingOfSpells",
      "label": {
        "de": "Lösen von Beschwörungen",
        "en": "Loosing of spells"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A falsifying condition is stated and no case has yet been recorded against it."
      },
      "id": "pm:procedureWithoutCases",
      "label": {
        "de": "Verfahren ohne Fälle",
        "en": "Procedure without cases"
      },
      "type": "pm:ExaminationState"
    },
    {
      "definition": {
        "en": "The gathering and preparation of plant material for pharmacological or operative use."
      },
      "id": "pmc:RootCutting",
      "label": {
        "de": "Wurzelschneiden",
        "en": "Root-cutting"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The five elements of the rite belonging to heroic practice, named in the source as wine, meat, fish, parched grain, and the union of man and woman."
      },
      "id": "pmc:Panchatattva",
      "label": {
        "de": "Die fünf Tattvas des heroischen Ritus",
        "en": "The five tattvas of the heroic rite"
      },
      "note": {
        "en": [
          "The fourth element is parched grain and not a ritual gesture. Wilson renders the same list in 1832 with mudrā glossed as gesticulations of the fingers and maithuna as women; the divergence is his and not the text's, and it matters because grain makes that element a food where a gesture would make it an act. Recorded so that the current gloss can be checked against a verse instead of against another summary. See prima-materia#53.",
          "The same passage carries its own caution, and the caution is not a Western addition: the source says that the men of this age, being greedy and lustful, will neglect the discipline, drink for the pleasure of it, and lose the distinction of right and wrong. The warning against the rite stands inside the text that prescribes it."
        ]
      },
      "source": [
        "Mahānirvāṇa Tantra I.58-59 (trans. A. Avalon, Tantra of the Great Liberation, London 1913)",
        "Mahānirvāṇa Tantra I.61 (trans. A. Avalon, Tantra of the Great Liberation, London 1913)"
      ],
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:SaivaSakta"
    },
    {
      "id": "pmc:DreamYogaPresupposesClearLight",
      "label": {
        "de": "Traumyoga setzt das Halten des klaren Lichts voraus",
        "en": "Dream yoga presupposes holding the clear light of sleep"
      },
      "note": {
        "en": "The treatise takes the recognition of the clear light before the training in the dream. It does not state at that place what befalls one who begins elsewhere, which is why the strength is order and not necessity."
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:dependentStep": {
        "id": "pmp:DreamYoga"
      },
      "pm:prerequisiteStrength": {
        "id": "pm:prescribedOrder"
      },
      "pm:priorStep": {
        "id": "pmc:ClearLightOfSleep"
      },
      "source": "Tsongkhapa, A Book of Three Inspirations (trans. Mullin 2005)",
      "type": "pm:Presupposing",
      "withinTradition": "pmt:TibetanTantric"
    },
    {
      "definition": {
        "en": "A Watcher whose teaching concerns the stars; the two recensions differ on whether it is the constellations or the signs of the stars."
      },
      "id": "pmc:Kokabel",
      "label": {
        "de": "Kokabel",
        "en": "Kokabel"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The binding of persons or events by spoken formula."
      },
      "id": "pmc:SpellCasting",
      "label": {
        "de": "Beschwörung",
        "en": "Spell-casting"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The observation that a body or seat of awareness distinct from the physical one is claimed in the Pāli handbooks, in the Yogasūtra, and in Greek reports of men whose souls left them."
      },
      "id": "pmc:ExteriorisationCorrespondence",
      "label": {
        "de": "Die Entsprechung der Exteriorisation",
        "en": "The exteriorisation correspondence"
      },
      "note": {
        "en": "The Indian pair share a sphere and a technical vocabulary and are not independent of each other. The Greek reports are of a different kind entirely: they are second-hand ascriptions to figures long dead, made by historians rather than by practitioners, and a route of contact with the Indian material has been proposed but not shown."
      },
      "pm:attestedBy": {
        "id": "pm:compilerInference"
      },
      "pm:convergingConcept": [
        {
          "id": "pmc:Manomayakaya"
        },
        {
          "id": "pmc:ParakayaPravesa"
        },
        {
          "id": "pmc:SoulJourney"
        }
      ],
      "pm:independentAttestation": {
        "id": "pmt:GraecoRoman"
      },
      "pm:transmissionPath": "Theravāda and Pātañjala Yoga share the Indian sphere and a common technical vocabulary. A Scythian or shamanic route to the Greek reports has been proposed in the scholarship but is not documented.",
      "source": [
        "Dīgha Nikāya 2, Sāmaññaphala Sutta, DN i.77 (trans. Ṭhānissaro Bhikkhu)",
        "Herodotus, Histories IV.13-16",
        "Patañjali, Yogasūtra III.38 (Sanskrit sūtra text; received four-pāda numbering)"
      ],
      "type": "pm:Converging"
    },
    {
      "id": "pmc:SamyamaYieldsDivyaCaksus",
      "label": {
        "de": "Saṃyama auf die Sonne bringt Weltkenntnis hervor",
        "en": "Saṃyama on the sun yields knowledge of the world"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "pm:byPractice": {
        "id": "pmp:Samyama"
      },
      "pm:yieldsCapacity": {
