  "@graph": [
    {
      "definition": {
        "en": "First-person exclusive awareness shared between two subjects (I and you)."
      },
      "id": "pm:dyadicAwareness",
      "label": {
        "de": "Dyadisches Bewusstsein",
        "en": "Dyadic awareness"
      },
      "type": "pm:AwarenessSpace"
    },
    {
      "definition": {
        "en": "A Watcher whose teaching concerns celestial signs; the two recensions differ on which."
      },
      "id": "pmc:Baraqel",
      "label": {
        "de": "Baraqel",
        "en": "Baraqel"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "Baraqijal"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:KokabelTeachesSignsOfTheStars",
      "label": {
        "de": "Kokabel offenbart die Zeichen der Sterne",
        "en": "Kokabel discloses the signs of the stars"
      },
      "note": {
        "en": "Stands in the position the Ethiopic fills with the constellations."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfTheStars"
      },
      "pm:ascribedTo": {
        "id": "pmc:Kokabel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The disclosure of harmful operations: the striking of spirits and demons, the killing of the embryo in the womb, the serpent's bite and the stroke of the noonday heat."
      },
      "id": "pmc:StrikingOfSpirits",
      "label": {
        "de": "Schlagen der Geister und der Leibesfrucht",
        "en": "Striking of spirits and of the womb"
      },
      "source": "1 Enoch 69:12 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Undifferentiated awareness in which no object is apprehended."
      },
      "id": "pm:DeepSleepState",
      "label": {
        "de": "Tiefschlafzustand (Suṣupti)",
        "en": "Deep sleep state (Suṣupti)"
      },
      "source": "Māṇḍūkya Upaniṣad, verse 5",
      "type": "pm:AwarenessContext"
    },
    {
      "definition": {
        "en": "A structural correspondence observed across traditions, held as a node so that it can carry its routes of transmission and its counterexamples instead of asserting universality."
      },
      "id": "pm:Converging",
      "label": {
        "de": "Konvergieren",
        "en": "Converging"
      },
      "note": {
        "en": "Most apparent universality in the Western esoteric record is diffusion from few sources. A graph that counts a citation chain as independent confirmation measures reception history and reports it as structure."
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "A leader among the Watchers, named in the Book of the Watchers as the one who disclosed metallurgy, weaponry and adornment."
      },
      "id": "pmc:Azazel",
      "label": {
        "de": "Azazel",
        "en": "Azazel"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "Asael"
      },
      "source": "1 Enoch 8:1 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A Watcher named as the one who disclosed the signs of the earth."
      },
      "id": "pmc:Araqiel",
      "label": {
        "de": "Araqiel",
        "en": "Araqiel"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Operative consciousness in which an assertion is made from direct insight rather than from historical reconstruction."
      },
      "id": "pm:GnosticState",
      "label": {
        "de": "Gnostischer Zustand",
        "en": "Gnostic state"
      },
      "note": {
        "en": "Use this context when a triple expresses a claim from within a tradition's first-person perspective."
      },
      "type": "pm:AwarenessContext"
    },
    {
      "definition": {
        "en": "The emergence of a form out of a prior undifferentiated ground."
      },
      "id": "pm:Manifesting",
      "label": {
        "de": "Manifestieren",
        "en": "Manifesting"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "Associates a process instance with the pronominal reach of its awareness."
      },
      "id": "pm:hasAwarenessSpace",
      "label": {
        "en": "has awareness space"
      },
      "range": "pm:AwarenessSpace",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "Shield, breastplate and the sword for slaughter, disclosed as instruments of killing rather than as craft."
      },
      "id": "pmc:WeaponsOfDeath",
      "label": {
        "de": "Die Waffen des Todes",
        "en": "The weapons of death"
      },
      "source": "1 Enoch 69:6 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A tradition attesting the correspondence for which no route of contact is documented. This is the only kind of attestation that makes a correspondence a finding rather than a citation chain."
      },
      "domain": "pm:Converging",
      "id": "pm:independentAttestation",
      "label": {
        "de": "unabhängige Bezeugung",
        "en": "independent attestation"
      },
      "range": "pm:Tradition",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "The reading of terrestrial import from the position of the heavenly bodies."
      },
      "id": "pmc:Astrology",
      "label": {
        "de": "Astrologie",
        "en": "Astrology"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A cross-tradition structural analogue, weaker than owl:sameAs and distinct from skos:closeMatch in that it asserts role-in-process similarity rather than lexical overlap."
      },
      "domain": "pm:Conceptualizing",
      "id": "pm:analogueConcept",
      "label": {
        "en": "analogue concept"
      },
      "range": "pm:Conceptualizing",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "An experiential account given in the first person by the one who had it, recorded once."
      },
      "id": "pm:firstPersonReport",
      "label": {
        "de": "Erfahrungsbericht",
        "en": "First-person report"
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "A Watcher whose teaching concerns the moon; the Ethiopic gives its course, the Aramaic-Greek witness gives its signs under the name Sahriel."
      },
      "id": "pmc:Sariel",
      "label": {
        "de": "Sariel",
        "en": "Sariel"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A knowledge tradition understood as an ongoing act of transmission rather than a static corpus."
      },
      "id": "pm:Tradition",
      "label": {
        "de": "Tradition",
        "en": "Tradition"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "A claim that this ordering act groups. The claims keep their own attestation; only the grouping belongs to the compiler."
      },
      "domain": "pm:Systematizing",
      "id": "pm:ordersClaim",
      "label": {
        "de": "ordnet Behauptung",
        "en": "orders claim"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "id": "pmc:ShemihazahTeachesRootCutting",
      "label": {
        "de": "Schemichasa offenbart das Wurzelschneiden",
        "en": "Shemihazah discloses root-cutting"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:RootCutting"
      },
      "pm:ascribedTo": {
        "id": "pmc:Shemihazah"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "comment": {
        "en": "Consciousness-first meta-ontology. Processes, not substances."
      },
      "id": "https://pajew.ski/prima-materia/ontology",
      "license": "https://creativecommons.org/publicdomain/zero/1.0/",
      "title": {
        "en": "prima-materia core ontology"
      },
      "type": "owl:Ontology"
    },
    {
      "definition": {
        "en": "Knowledge of bracelets and ornaments, of antimony and the painting of the eyelids, of precious stones and colouring tinctures."
      },
      "id": "pmc:AdornmentAndCosmetics",
      "label": {
        "de": "Schmuck und Kosmetik",
        "en": "Adornment and cosmetics"
      },
      "source": "1 Enoch 8:1 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The capacity that an attribution ascribes."
      },
      "domain": "pm:Attributing",
      "id": "pm:ascribedCapacity",
      "label": {
        "de": "zugeschriebenes Vermögen",
        "en": "ascribed capacity"
      },
      "range": "pm:Conceptualizing",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "A Watcher named in the Ethiopic teaching list as the one who disclosed the knowledge of the clouds."
      },
      "id": "pmc:Ezeqeel",
      "label": {
        "de": "Ezeqeel",
        "en": "Ezeqeel"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The formation of a concept as an act within awareness; instances of this class are concept nodes such as pmc:Pleroma or pmc:Hen."
      },
      "id": "pm:Conceptualizing",
      "label": {
        "de": "Begriffsbildung",
        "en": "Conceptualizing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The art of fixing speech in ink on paper, treated in the text as a transgression rather than a gift."
      },
      "id": "pmc:WritingWithInk",
      "label": {
        "de": "Schreiben mit Tinte",
        "en": "Writing with ink"
      },
      "source": "1 Enoch 69:9 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Knowledge of the fixed groupings of stars."
      },
      "id": "pmc:Constellations",
      "label": {
        "de": "Die Sternbilder",
        "en": "The constellations"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:AraqielTeachesSignsOfTheEarth",
      "label": {
        "de": "Araqiel offenbart die Zeichen der Erde",
        "en": "Araqiel discloses the signs of the earth"
      },
      "pm:ascribedCapacity": {
        "id": "pmc:SignsOfTheEarth"
      },
      "pm:ascribedTo": {
        "id": "pmc:Araqiel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "Awareness whose reach is unbounded across all possible subjects."
      },
      "id": "pm:universalAwareness",
      "label": {
        "de": "Universelles Bewusstsein",
        "en": "Universal awareness"
      },
      "type": "pm:AwarenessSpace"
    },
    {
      "definition": {
        "en": "The claim stands in a received work, at a passage that can be cited and read independently of this graph."
      },
      "id": "pm:textualAttestation",
      "label": {
        "de": "Textzeugnis",
        "en": "Textual attestation"
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "Declares by which route a claim entered the record. Mandatory on every attribution, so that non-evidence cannot be forgotten."
      },
      "id": "pm:attestedBy",
      "label": {
        "de": "bezeugt durch",
        "en": "attested by"
      },
      "range": "pm:Attesting",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "Associates a MeaningCluster with the individual nodes that constitute it as a bounded subgraph."
      },
      "domain": "pm:MeaningCluster",
      "id": "pm:hasClusterMember",
      "label": {
        "en": "has cluster member"
      },
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "Knowledge of the metals of the earth and of working them into blades, shields and body armour."
      },
      "id": "pmc:Metalworking",
      "label": {
        "de": "Metallverarbeitung und Waffenherstellung",
        "en": "Metalworking and weapon-making"
      },
      "source": "1 Enoch 8:1 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The number of cases recorded under this protocol so far."
      },
      "domain": "pm:Testing",
      "id": "pm:caseCount",
      "label": {
        "de": "Fallzahl",
        "en": "case count"
      },
      "range": "xsd:integer",
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "The gathering and preparation of plant material for pharmacological or operative use."
      },
      "id": "pmc:RootCutting",
      "label": {
        "de": "Wurzelschneiden",
        "en": "Root-cutting"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The binding of persons or events by spoken formula."
      },
      "id": "pmc:SpellCasting",
      "label": {
        "de": "Beschwörung",
        "en": "Spell-casting"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "id": "pmc:GadreelTeachesWeaponsOfDeath",
      "label": {
        "de": "Gadreel offenbart die Waffen des Todes",
        "en": "Gadreel discloses the weapons of death"
      },
      "note": {
        "en": "Book of Parables; no Aramaic fragment of chapters 37-71 is attested at Qumran."
      },
      "pm:ascribedCapacity": {
        "id": "pmc:WeaponsOfDeath"
      },
      "pm:ascribedTo": {
        "id": "pmc:Gadreel"
      },
      "pm:attestedBy": {
        "id": "pm:textualAttestation"
      },
      "source": [
        "1 Enoch 69:6 (Ethiopic; Charles 1912)",
        "J.T. Milik, The Books of Enoch: Aramaic Fragments of Qumrân Cave 4 (Oxford, 1976)"
      ],
      "type": "pm:Attributing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "One party ascribes the capacity to another, who does not report it. Common for capacities said to be lost, since no bearer remains to be asked."
      },
      "id": "pm:thirdPartyAscription",
      "label": {
        "de": "Fremdzuschreibung",
        "en": "Third-party ascription"
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "A conclusion drawn by an editor or compiler that the source does not state."
      },
      "id": "pm:compilerInference",
      "label": {
        "de": "Schluss des Bearbeiters",
        "en": "Compiler inference"
      },
      "note": {
        "en": "Admissible as attestation of an ordering act, never of the claim being ordered. Enforced by pm:AttributionShape."
      },
      "type": "pm:Attesting"
    },
    {
      "definition": {
        "en": "A concept that participates in the observed correspondence."
      },
      "domain": "pm:Converging",
      "id": "pm:convergingConcept",
      "label": {
        "de": "konvergierender Begriff",
        "en": "converging concept"
      },
      "range": "pm:Conceptualizing",
      "type": "owl:ObjectProperty"
    },
    {
      "definition": {
        "en": "A Watcher whose teaching concerns the stars; the two recensions differ on whether it is the constellations or the signs of the stars."
      },
      "id": "pmc:Kokabel",
      "label": {
        "de": "Kokabel",
        "en": "Kokabel"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "An ongoing attempt to fail a claim under a stated condition. A protocol that names no condition under which the claim would be refuted is not a test of it."
      },
      "id": "pm:Testing",
      "label": {
        "de": "Prüfen",
        "en": "Testing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The transmission of the Enoch literature: the Book of the Watchers, the Astronomical Book, the Book of Dreams, the Epistle and, in the Ethiopic canon alone, the Book of Parables."
      },
      "id": "pmt:Enochic",
      "label": {
        "de": "Henochische Überlieferung",
        "en": "Enochic tradition"
      },
      "source": "G.W.E. Nickelsburg, 1 Enoch 1 (Hermeneia, 2001), introduction",
      "type": "pm:Tradition"
    },
    {
      "definition": {
        "en": "An epistemic mode in which a statement is asserted. Individual instances are defined in ontology/consciousness.ttl."
      },
      "id": "pm:AwarenessContext",
      "label": {
        "de": "Bewusstseinskontext",
        "en": "Awareness Context"
      },
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The undoing of a binding laid by another, held in the text as a distinct art from the laying of it."
      },
      "id": "pmc:LoosingOfSpells",
      "label": {
        "de": "Lösen von Beschwörungen",
        "en": "Loosing of spells"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "The act of one form standing for another within awareness."
      },
      "id": "pm:Symbolizing",
      "label": {
        "de": "Symbolisieren",
        "en": "Symbolizing"
      },
      "subClassOf": "pm:Process",
      "type": "owl:Class"
    },
    {
      "definition": {
        "en": "The rate against which observed outcomes are compared, with the population it was taken from."
      },
      "domain": "pm:Testing",
      "id": "pm:baseRate",
      "label": {
        "de": "Basisrate",
        "en": "base rate"
      },
      "type": "owl:DatatypeProperty"
    },
    {
      "definition": {
        "en": "The leader of the Watchers who binds the others by oath on Mount Hermon and is named as the teacher of spells and root-cutting."
      },
      "id": "pmc:Shemihazah",
      "label": {
        "de": "Schemichasa",
        "en": "Shemihazah"
      },
      "skos:altLabel": [
        {
          "@language": "en",
          "@value": "Amezarak"
        },
        {
          "@language": "en",
          "@value": "Semjaza"
        }
      ],
      "source": "1 Enoch 6:3, 8:3 (Ethiopic; Charles 1912)",
      "type": "pm:Conceptualizing",
      "withinTradition": "pmt:Enochic"
    },
    {
      "definition": {
        "en": "A Watcher named in the teaching list as the one who disclosed the undoing of spells."
      },
      "id": "pmc:Armaros",
      "label": {
        "de": "Armaros",
        "en": "Armaros"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "Hermani"
      },
      "source": "1 Enoch 8:3 (Ethiopic; Charles 1912)",
